<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX00000000">
		<Properties>
			<string name="Name">BloxSDK2013</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX00000001">
			<Properties>
				<string name="Name">README_INSTALL</string>
				<ProtectedString name="Source"><![CDATA[--[[
	BloxSDK 2013 - install

	Move each folder's contents into the matching service:
	  BloxSDK2013.ReplicatedStorage.BloxSDK                -> ReplicatedStorage
	  BloxSDK2013.ServerScriptService.BloxSDKServer        -> ServerScriptService
	  BloxSDK2013.StarterPlayerScripts.BloxSDKClient       -> StarterPlayer.StarterPlayerScripts

	Or paste this in the command bar with the model selected in Workspace:

	local m = workspace.BloxSDK2013
	m.ReplicatedStorage.BloxSDK.Parent = game.ReplicatedStorage
	m.ServerScriptService.BloxSDKServer.Parent = game.ServerScriptService
	m.StarterPlayerScripts.BloxSDKClient.Parent = game.StarterPlayer.StarterPlayerScripts
	m:Destroy()
]]
return nil
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX00000002">
			<Properties>
				<string name="Name">ReplicatedStorage</string>
			</Properties>
			<Item class="Folder" referent="RBX00000003">
				<Properties>
					<string name="Name">BloxSDK</string>
				</Properties>
				<Item class="Folder" referent="RBX00000004">
					<Properties>
						<string name="Name">Examples</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX00000005">
						<Properties>
							<string name="Name">TestMap</string>
							<ProtectedString name="Source"><![CDATA[--[[
	TestMap (ModuleScript)
	ReplicatedStorage.BloxSDK.Examples.TestMap

	Builds a test area that uses every entity type. Run in the Studio command bar (edit mode):

	    require(game.ReplicatedStorage.BloxSDK.Examples.TestMap).Build()

	then press Play. Everything is plain Parts with Attributes, so open any of them to see
	how entities, keyvalues and outputs are set up.
]]

local TestMap = {}

local WALL = Color3.fromRGB(120, 120, 110)
local TRIGGER = Color3.fromRGB(255, 120, 0)

function TestMap.Build(originArg: Vector3?)
	local origin = originArg or Vector3.new(0, 0, 0)

	local existing = workspace:FindFirstChild("BloxSDK_TestMap")
	if existing then
		existing:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = "BloxSDK_TestMap"

	local function part(name: string, size: Vector3, pos: Vector3, props: { [string]: any }?, attrs: { [string]: any }?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = CFrame.new(origin + pos)
		p.Color = WALL
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		for k, v in props or {} do
			(p :: any)[k] = v
		end
		for k, v in attrs or {} do
			p:SetAttribute(k, v)
		end
		p.Parent = model
		return p
	end

	local function point(classname: string, name: string, pos: Vector3, attrs: { [string]: any }): Part
		local a = table.clone(attrs)
		a.classname = classname
		return part(name, Vector3.new(1, 1, 1), pos, {
			Color = Color3.fromRGB(255, 0, 255),
			Transparency = 0.5,
			CanCollide = false,
		}, a)
	end

	local function label(p: BasePart, text: string)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(220, 40)
		gui.StudsOffset = Vector3.new(0, p.Size.Y / 2 + 2, 0)
		gui.AlwaysOnTop = false
		gui.MaxDistance = 80
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.3
		t.Font = Enum.Font.SourceSansBold
		t.TextScaled = true
		t.Text = text
		t.Parent = gui
		gui.Parent = p
	end

	-- floor + spawn ----------------------------------------------------------
	part("Floor", Vector3.new(180, 1, 180), Vector3.new(0, 0.5, 0), { Color = Color3.fromRGB(90, 95, 85) })
	point("info_player_start", "info_player_start", Vector3.new(0, 1.5, 50), {})

	-- stairs (1 stud = 14 units, step is 18 units ~ 1.29 studs) --------------
	for i = 1, 8 do
		label(part("Step" .. i, Vector3.new(8, i * 1.2, 2.5), Vector3.new(-30, 1 + i * 0.6, 30 - i * 2.5)), if i == 1 then "stairs" else "")
	end
	part("StairTop", Vector3.new(8, 9.6, 12), Vector3.new(-30, 5.8, 3.75))

	-- ladder ----------------------------------------------------------------
	part("LadderWall", Vector3.new(10, 20, 1), Vector3.new(-60, 11, 0))
	local ladder = part("Ladder", Vector3.new(4, 20, 0.6), Vector3.new(-60, 11, 0.8), {
		Color = Color3.fromRGB(150, 110, 60),
		Material = Enum.Material.WoodPlanks,
	}, { classname = "func_ladder" })
	label(ladder, "func_ladder")
	part("LadderTop", Vector3.new(10, 1, 10), Vector3.new(-60, 20.5, -5))

	-- water pool ------------------------------------------------------------
	local poolCenter = Vector3.new(45, 0, 45)
	part("PoolWallN", Vector3.new(24, 6.5, 1), poolCenter + Vector3.new(0, 4.25, -12.5))
	part("PoolWallS", Vector3.new(24, 6.5, 1), poolCenter + Vector3.new(0, 4.25, 12.5))
	part("PoolWallE", Vector3.new(1, 6.5, 26), poolCenter + Vector3.new(12.5, 4.25, 0))
	part("PoolWallW", Vector3.new(1, 6.5, 26), poolCenter + Vector3.new(-12.5, 4.25, 0))
	local water = part("Water", Vector3.new(24, 6, 24), poolCenter + Vector3.new(0, 4, 0), {
		Color = Color3.fromRGB(40, 110, 200),
		Transparency = 0.6,
		Material = Enum.Material.Glass,
		CanCollide = false,
	}, { classname = "func_water" })
	label(water, "func_water (swim / water jump out)")

	-- lift column (trigger_push up) + conveyor (trigger_push sideways) --------
	part("LiftPad", Vector3.new(8, 0.2, 8), Vector3.new(20, 1.1, 20), { Color = TRIGGER, Material = Enum.Material.Neon })
	local lift = part("trigger_push_lift", Vector3.new(8, 30, 8), Vector3.new(20, 16, 20), nil, {
		classname = "trigger_push",
		pushdir = Vector3.new(0, 1, 0),
		speed = 500,
		spawnflags = 1,
	})
	label(part("LiftSign", Vector3.new(0.2, 0.2, 0.2), Vector3.new(20, 4, 20), { Transparency = 1, CanCollide = false }), "trigger_push (up)")
	part("LiftLanding", Vector3.new(10, 1, 10), Vector3.new(20, 28, 8))
	lift.Color = TRIGGER

	part("Conveyor", Vector3.new(30, 0.2, 6), Vector3.new(30, 1.1, -45), { Color = Color3.fromRGB(60, 60, 60), Material = Enum.Material.DiamondPlate })
	part("trigger_push_conveyor", Vector3.new(30, 3, 6), Vector3.new(30, 2.5, -45), nil, {
		classname = "trigger_push",
		pushdir = Vector3.new(1, 0, 0),
		speed = 250,
	})
	label(part("ConveyorSign", Vector3.new(0.2, 0.2, 0.2), Vector3.new(16, 4, -45), { Transparency = 1, CanCollide = false }), "trigger_push (conveyor)")

	-- teleporter --------------------------------------------------------------
	part("TeleFrame", Vector3.new(6, 0.2, 6), Vector3.new(55, 1.1, 0), { Color = Color3.fromRGB(80, 200, 255), Material = Enum.Material.Neon })
	part("trigger_teleport", Vector3.new(6, 6, 6), Vector3.new(55, 4, 0), nil, {
		classname = "trigger_teleport",
		target = "tp_dest",
	})
	label(part("TeleSign", Vector3.new(0.2, 0.2, 0.2), Vector3.new(55, 5, 0), { Transparency = 1, CanCollide = false }), "trigger_teleport -> ladder top")
	local dest = point("info_teleport_destination", "tp_dest", Vector3.new(-60, 22, -6), { targetname = "tp_dest" })
	dest.CFrame = CFrame.new(dest.Position) * CFrame.Angles(0, math.rad(180), 0)

	-- door + button + relay + game_text ----------------------------------------
	part("DoorWallL", Vector3.new(12, 10, 1), Vector3.new(-10, 6, -20))
	part("DoorWallR", Vector3.new(12, 10, 1), Vector3.new(10, 6, -20))
	part("DoorWallTop", Vector3.new(8, 2, 1), Vector3.new(0, 10, -20))
	local door = part("door1", Vector3.new(8, 8, 0.8), Vector3.new(0, 5, -20), { Color = Color3.fromRGB(170, 70, 50) }, {
		classname = "func_door",
		targetname = "door1",
		movedir = Vector3.new(0, 1, 0),
		speed = 100,
		wait = 3,
		spawnflags = 0,
	})
	label(door, "func_door (press the button)")
	local button = part("button1", Vector3.new(1, 1, 0.4), Vector3.new(6, 4, -19.3), { Color = Color3.fromRGB(220, 30, 30) }, {
		classname = "func_button",
		spawnflags = 1025,
		wait = 1,
		OnPressed = "relay1,Trigger",
	})
	label(button, "func_button [E]")
	point("logic_relay", "relay1", Vector3.new(6, 8, -18), {
		targetname = "relay1",
		OnTrigger = "door1,Open",
		OnTrigger_2 = "msg_door,Display",
	})
	point("game_text", "msg_door", Vector3.new(7, 8, -18), {
		targetname = "msg_door",
		message = "func_button -> logic_relay -> func_door",
		holdtime = 2,
		color = "255 200 0",
		y = 0.3,
		spawnflags = 1,
	})

	-- rotating door (+use) ------------------------------------------------------
	part("RotWallL", Vector3.new(6, 10, 1), Vector3.new(-23, 6, -20))
	part("RotWallR", Vector3.new(6, 10, 1), Vector3.new(-37, 6, -20))
	local rot = part("door_rotating", Vector3.new(8, 8, 0.6), Vector3.new(-30, 5, -20), { Color = Color3.fromRGB(110, 80, 50) }, {
		classname = "func_door_rotating",
		spawnflags = 256,
		distance = 90,
		speed = 120,
		wait = 4,
	})
	rot.PivotOffset = CFrame.new(-4, 0, 0) -- hinge on the left edge
	label(rot, "func_door_rotating [E]")

	-- counter: 3 presses -------------------------------------------------------
	local counterButton = part("button_count", Vector3.new(1.4, 1.4, 1.4), Vector3.new(-10, 2, 40), { Color = Color3.fromRGB(40, 200, 60) }, {
		classname = "func_button",
		spawnflags = 1025,
		wait = 0.3,
		OnPressed = "counter1,Add,1",
	})
	label(counterButton, "math_counter: press 3x [E]")
	point("math_counter", "counter1", Vector3.new(-10, 5, 40), {
		targetname = "counter1",
		startvalue = 0,
		min = 0,
		max = 3,
		OnHitMax = "msg_count,Display",
		OnHitMax_2 = "counter1,SetValueNoFire,0,0.1",
	})
	point("game_text", "msg_count", Vector3.new(-11, 5, 40), {
		targetname = "msg_count",
		message = "math_counter hit max!",
		holdtime = 2,
		color = "100 255 100",
		y = 0.35,
		spawnflags = 1,
	})

	-- logic_timer toggling a func_brush -----------------------------------------
	local wall = part("wall1", Vector3.new(10, 6, 1), Vector3.new(30, 4, 40), { Color = Color3.fromRGB(200, 200, 60) }, {
		classname = "func_brush",
		targetname = "wall1",
	})
	label(wall, "func_brush toggled by logic_timer")
	point("logic_timer", "timer1", Vector3.new(30, 8, 40), {
		RefireTime = 2,
		OnTimer = "wall1,Toggle",
	})

	-- spinning platform --------------------------------------------------------
	local fan = part("fan1", Vector3.new(18, 0.6, 3), Vector3.new(-20, 1.8, 15), { Color = Color3.fromRGB(80, 80, 160) }, {
		classname = "func_rotating",
		spawnflags = 1,
		maxspeed = 45,
	})
	label(fan, "func_rotating (ride it)")

	-- hurt strip -----------------------------------------------------------------
	part("Lava", Vector3.new(12, 0.2, 4), Vector3.new(0, 1.1, 65), { Color = Color3.fromRGB(255, 80, 0), Material = Enum.Material.Neon })
	part("trigger_hurt", Vector3.new(12, 3, 4), Vector3.new(0, 2.5, 65), nil, {
		classname = "trigger_hurt",
		damage = 20,
	})

	-- welcome text on first step into the map ------------------------------------
	part("trigger_once_welcome", Vector3.new(20, 8, 6), Vector3.new(0, 4, 42), nil, {
		classname = "trigger_once",
		OnTrigger = "msg_welcome,Display",
	})
	point("game_text", "msg_welcome", Vector3.new(0, 8, 44), {
		targetname = "msg_welcome",
		message = "BloxSDK test map - press ` for the console",
		holdtime = 3,
		color = "255 255 255",
		y = 0.25,
		spawnflags = 1,
	})

	-- logic_auto ----------------------------------------------------------------
	point("logic_auto", "auto", Vector3.new(0, 8, 48), {
		OnMapSpawn = "!self,FireUser1",
	})

	model.Parent = workspace
	print("[BloxSDK] Test map built: workspace.BloxSDK_TestMap")
	return model
end

return TestMap
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Folder" referent="RBX00000006">
					<Properties>
						<string name="Name">Shared</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX00000007">
						<Properties>
							<string name="Name">ConVar</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	ConVar (ModuleScript)
	ReplicatedStorage.BloxSDK.Shared.ConVar

	Luau port of Source SDK 2013 tier1 ConVar / ConCommand / ICvar + CCommand tokenizer.

	local Cvar = require(ReplicatedStorage.BloxSDK.Shared.ConVar)

	local sv_gravity = Cvar.ConVar("sv_gravity", 600, Cvar.FCVAR_NOTIFY + Cvar.FCVAR_REPLICATED, "World gravity.")
	sv_gravity:GetFloat()
	sv_gravity:AddChangeCallback(function(var, oldString, oldFloat) end)

	Cvar.ConCommand("hello", function(args)
		Cvar.Msg("hello " .. args:ArgS())
	end, "Says hello.")

	Cvar.Execute("sv_gravity 300; hello world")

	Registry is per Luau VM (client and server each have their own).
]]

local Cvar = {}

------------------------------------------------------------------------
-- Flags (same bit values as Source's iconvar.h)
------------------------------------------------------------------------

Cvar.FCVAR_NONE = 0
Cvar.FCVAR_UNREGISTERED = bit32.lshift(1, 0)
Cvar.FCVAR_DEVELOPMENTONLY = bit32.lshift(1, 1)
Cvar.FCVAR_GAMEDLL = bit32.lshift(1, 2)
Cvar.FCVAR_CLIENTDLL = bit32.lshift(1, 3)
Cvar.FCVAR_HIDDEN = bit32.lshift(1, 4)
Cvar.FCVAR_PROTECTED = bit32.lshift(1, 5)
Cvar.FCVAR_SPONLY = bit32.lshift(1, 6)
Cvar.FCVAR_ARCHIVE = bit32.lshift(1, 7)
Cvar.FCVAR_NOTIFY = bit32.lshift(1, 8)
Cvar.FCVAR_USERINFO = bit32.lshift(1, 9)
Cvar.FCVAR_PRINTABLEONLY = bit32.lshift(1, 10)
Cvar.FCVAR_UNLOGGED = bit32.lshift(1, 11)
Cvar.FCVAR_NEVER_AS_STRING = bit32.lshift(1, 12)
Cvar.FCVAR_REPLICATED = bit32.lshift(1, 13)
Cvar.FCVAR_CHEAT = bit32.lshift(1, 14)

local FLAG_NAMES = {
	{ Cvar.FCVAR_GAMEDLL, "game" },
	{ Cvar.FCVAR_CLIENTDLL, "client" },
	{ Cvar.FCVAR_ARCHIVE, "archive" },
	{ Cvar.FCVAR_NOTIFY, "notify" },
	{ Cvar.FCVAR_SPONLY, "singleplayer" },
	{ Cvar.FCVAR_PROTECTED, "protected" },
	{ Cvar.FCVAR_USERINFO, "user" },
	{ Cvar.FCVAR_REPLICATED, "replicated" },
	{ Cvar.FCVAR_CHEAT, "cheat" },
	{ Cvar.FCVAR_HIDDEN, "hidden" },
	{ Cvar.FCVAR_DEVELOPMENTONLY, "devonly" },
}

local function hasFlag(flags: number, flag: number): boolean
	return bit32.band(flags, flag) ~= 0
end
Cvar.HasFlag = hasFlag

function Cvar.FlagString(flags: number): string
	local out = {}
	for _, pair in FLAG_NAMES do
		if hasFlag(flags, pair[1]) then
			table.insert(out, pair[2])
		end
	end
	return table.concat(out, " ")
end

------------------------------------------------------------------------
-- Output
------------------------------------------------------------------------

Cvar.COLOR_NORMAL = Color3.fromRGB(216, 222, 211)
Cvar.COLOR_ECHO = Color3.fromRGB(255, 255, 255)
Cvar.COLOR_WARNING = Color3.fromRGB(255, 120, 100)
Cvar.COLOR_HIGHLIGHT = Color3.fromRGB(196, 181, 80)

local MAX_HISTORY = 300
local history = {}
local printListeners = {}

-- set by the console UI so other scripts know to release the mouse / ignore keys
Cvar.consoleVisible = false

function Cvar.ConColorMsg(color: Color3, text: string)
	for line in (tostring(text) .. "\n"):gmatch("(.-)\n") do
		local entry = { text = line, color = color }
		table.insert(history, entry)
		if #history > MAX_HISTORY then
			table.remove(history, 1)
		end
		for _, fn in printListeners do
			task.spawn(fn, entry.text, entry.color)
		end
	end
end

function Cvar.Msg(text: string)
	Cvar.ConColorMsg(Cvar.COLOR_NORMAL, text)
end

function Cvar.Warning(text: string)
	Cvar.ConColorMsg(Cvar.COLOR_WARNING, text)
end

function Cvar.OnPrint(fn: (string, Color3) -> ()): () -> ()
	table.insert(printListeners, fn)
	return function()
		local i = table.find(printListeners, fn)
		if i then
			table.remove(printListeners, i)
		end
	end
end

function Cvar.GetHistory()
	return history
end

function Cvar.ClearHistory()
	table.clear(history)
end

------------------------------------------------------------------------
-- Registry
------------------------------------------------------------------------

local RunService = game:GetService("RunService")
local IS_CLIENT = RunService:IsClient()

local registry: { [string]: any } = {}
local aliases: { [string]: string } = {}
local globalChangeCallbacks = {}
local registerCallbacks = {}

-- client: values pushed from the server for FCVAR_REPLICATED vars (applied on registration too)
local replicatedValues: { [string]: string } = {}

-- client: sends console text the client can't handle to the server (set by DevConsole)
local forwarder: ((string) -> ())? = nil

-- server: the player whose forwarded command is currently executing (nil = server console)
Cvar.CommandPlayer = nil :: Player?

function Cvar.SetForwarder(fn: ((string) -> ())?)
	forwarder = fn
end

function Cvar.OnRegister(fn: (any) -> ())
	table.insert(registerCallbacks, fn)
end

local function fireRegistered(base)
	for _, fn in registerCallbacks do
		task.spawn(fn, base)
	end
end

local function formatNumber(n: number): string
	if n == math.floor(n) and math.abs(n) < 1e15 then
		return string.format("%d", n)
	end
	return (string.format("%.6f", n):gsub("0+$", ""):gsub("%.$", ""))
end

local function toValueString(value: any): string
	local t = typeof(value)
	if t == "boolean" then
		return if value then "1" else "0"
	elseif t == "number" then
		return formatNumber(value)
	end
	return tostring(value)
end

------------------------------------------------------------------------
-- ConVar
------------------------------------------------------------------------

local ConVarClass = {}
ConVarClass.__index = ConVarClass

function Cvar.ConVar(
	name: string,
	default: any,
	flags: number?,
	help: string?,
	min: number?,
	max: number?,
	callback: ((any, string, number) -> ())?
)
	local key = string.lower(name)
	local existing = registry[key]
	if existing then
		if not existing.isCommand and callback then
			existing:AddChangeCallback(callback)
		end
		return existing
	end

	local defaultString = toValueString(default)
	local self = setmetatable({
		name = name,
		isCommand = false,
		flags = flags or 0,
		help = help or "",
		default = defaultString,
		min = min,
		max = max,
		value = defaultString,
		float = tonumber(defaultString) or 0,
		int = 0,
		callbacks = {},
	}, ConVarClass)
	self.int = math.floor(self.float)

	if callback then
		table.insert(self.callbacks, callback)
	end

	registry[key] = self

	local replicated = replicatedValues[key]
	if replicated ~= nil and IS_CLIENT and hasFlag(self.flags, Cvar.FCVAR_REPLICATED) then
		self:SetValue(replicated, true)
	end

	fireRegistered(self)
	return self
end

function ConVarClass:GetName(): string
	return self.name
end

function ConVarClass:GetHelpText(): string
	return self.help
end

function ConVarClass:IsFlagSet(flag: number): boolean
	return hasFlag(self.flags, flag)
end

function ConVarClass:AddFlags(flags: number)
	self.flags = bit32.bor(self.flags, flags)
end

function ConVarClass:GetString(): string
	return self.value
end

function ConVarClass:GetFloat(): number
	return self.float
end

function ConVarClass:GetInt(): number
	return self.int
end

function ConVarClass:GetBool(): boolean
	return self.int ~= 0
end

function ConVarClass:GetDefault(): string
	return self.default
end

function ConVarClass:GetMin(): number?
	return self.min
end

function ConVarClass:GetMax(): number?
	return self.max
end

function ConVarClass:AddChangeCallback(fn: (any, string, number) -> ())
	table.insert(self.callbacks, fn)
end

function ConVarClass:SetValue(value: any, silent: boolean?)
	local s = toValueString(value)
	local f = tonumber(s)

	if f then
		local clamped = f
		if self.min and clamped < self.min then
			clamped = self.min
		end
		if self.max and clamped > self.max then
			clamped = self.max
		end
		if clamped ~= f then
			f = clamped
			s = formatNumber(clamped)
		end
	end

	if s == self.value then
		return
	end

	local oldString, oldFloat = self.value, self.float
	self.value = s
	self.float = f or 0
	self.int = math.floor(self.float)

	if not silent and hasFlag(self.flags, Cvar.FCVAR_NOTIFY) then
		Cvar.Msg(string.format("Server cvar \"%s\" changed to %s", self.name, s))
	end

	for _, fn in self.callbacks do
		task.spawn(fn, self, oldString, oldFloat)
	end
	for _, fn in globalChangeCallbacks do
		task.spawn(fn, self, oldString, oldFloat)
	end
end

function ConVarClass:Revert()
	self:SetValue(self.default)
end

------------------------------------------------------------------------
-- CCommand (args)
------------------------------------------------------------------------

local CCommand = {}
CCommand.__index = CCommand

function CCommand:ArgC(): number
	return #self.argv
end

-- 0-based like Source: Arg(0) is the command name
function CCommand:Arg(i: number): string
	return self.argv[i + 1] or ""
end

function CCommand:ArgS(): string
	return self.argS
end

function CCommand:GetCommandString(): string
	return self.commandString
end

function CCommand:FindArg(name: string): string?
	for i, v in self.argv do
		if string.lower(v) == string.lower(name) then
			return self.argv[i + 1]
		end
	end
	return nil
end

-- CCommand::Tokenize
local function tokenize(line: string)
	local argv = {}
	local argS = ""
	local i, n = 1, #line

	while i <= n do
		local ws = line:match("^%s+", i)
		if ws then
			i += #ws
		end
		if i > n then
			break
		end

		if #argv == 1 and argS == "" then
			argS = line:sub(i):gsub("%s+$", "")
		end

		local c = line:sub(i, i)
		if c == '"' then
			local close = line:find('"', i + 1, true)
			if close then
				table.insert(argv, line:sub(i + 1, close - 1))
				i = close + 1
			else
				table.insert(argv, line:sub(i + 1))
				i = n + 1
			end
		else
			local token = line:match("^[^%s\"]+", i) :: string
			table.insert(argv, token)
			i += #token
		end
	end

	return setmetatable({ argv = argv, argS = argS, commandString = line }, CCommand)
end
Cvar.Tokenize = tokenize

-- splits on ';' and newlines outside quotes, strips // comments
local function splitStatements(text: string): { string }
	local out = {}
	local current = {}
	local inQuote = false
	local i, n = 1, #text

	while i <= n do
		local c = text:sub(i, i)
		if c == '"' then
			inQuote = not inQuote
			table.insert(current, c)
		elseif not inQuote and (c == ";" or c == "\n") then
			table.insert(out, table.concat(current))
			table.clear(current)
		elseif not inQuote and c == "/" and text:sub(i + 1, i + 1) == "/" then
			local nl = text:find("\n", i, true)
			if not nl then
				break
			end
			i = nl - 1
		else
			table.insert(current, c)
		end
		i += 1
	end

	table.insert(out, table.concat(current))
	return out
end

------------------------------------------------------------------------
-- ConCommand
------------------------------------------------------------------------

local ConCommandClass = {}
ConCommandClass.__index = ConCommandClass

function Cvar.ConCommand(
	name: string,
	callback: (any) -> (),
	help: string?,
	flags: number?,
	completion: ((string) -> { string })?
)
	local key = string.lower(name)
	local self = setmetatable({
		name = name,
		isCommand = true,
		callback = callback,
		help = help or "",
		flags = flags or 0,
		completion = completion,
	}, ConCommandClass)
	registry[key] = self
	fireRegistered(self)
	return self
end

-- client: apply a value the server replicated (FCVAR_REPLICATED)
function Cvar.SetReplicatedValue(name: string, value: string)
	local key = string.lower(name)
	replicatedValues[key] = value
	local var = registry[key]
	if var and not var.isCommand then
		var:SetValue(value, true)
	end
end

function ConCommandClass:GetName(): string
	return self.name
end

function ConCommandClass:GetHelpText(): string
	return self.help
end

function ConCommandClass:IsFlagSet(flag: number): boolean
	return hasFlag(self.flags, flag)
end

function ConCommandClass:Dispatch(args)
	local ok, err = pcall(self.callback, args)
	if not ok then
		Cvar.Warning(string.format("%s: %s", self.name, tostring(err)))
	end
end

------------------------------------------------------------------------
-- ICvar
------------------------------------------------------------------------

function Cvar.Find(name: string)
	return registry[string.lower(name)]
end

function Cvar.FindVar(name: string)
	local base = registry[string.lower(name)]
	if base and not base.isCommand then
		return base
	end
	return nil
end

function Cvar.FindCommand(name: string)
	local base = registry[string.lower(name)]
	if base and base.isCommand then
		return base
	end
	return nil
end

function Cvar.Unregister(name: string)
	registry[string.lower(name)] = nil
end

function Cvar.InstallGlobalChangeCallback(fn: (any, string, number) -> ())
	table.insert(globalChangeCallbacks, fn)
end

function Cvar.GetAll(): { any }
	local list = {}
	for _, base in registry do
		table.insert(list, base)
	end
	table.sort(list, function(a, b)
		return string.lower(a.name) < string.lower(b.name)
	end)
	return list
end

local function isVisible(base): boolean
	return not hasFlag(base.flags, Cvar.FCVAR_HIDDEN) and not hasFlag(base.flags, Cvar.FCVAR_DEVELOPMENTONLY)
end

local function cheatsEnabled(): boolean
	local sv_cheats = registry["sv_cheats"]
	return sv_cheats ~= nil and sv_cheats:GetBool()
end

function Cvar.PrintConVar(var)
	local line = string.format('"%s" = "%s"', var.name, var.value)
	if var.value ~= var.default then
		line ..= string.format(' ( def. "%s" )', var.default)
	end
	if var.min then
		line ..= " min. " .. formatNumber(var.min)
	end
	if var.max then
		line ..= " max. " .. formatNumber(var.max)
	end
	Cvar.Msg(line)

	local flags = Cvar.FlagString(var.flags)
	if flags ~= "" then
		Cvar.Msg(" " .. flags)
	end
	if var.help ~= "" then
		Cvar.Msg(" - " .. var.help)
	end
end

function Cvar.Execute(text: string, depth: number?)
	depth = depth or 0
	if (depth :: number) > 32 then
		Cvar.Warning("Alias recursion too deep, aborting")
		return
	end

	for _, statement in splitStatements(text) do
		local args = tokenize(statement)
		if args:ArgC() == 0 then
			continue
		end

		local name = string.lower(args:Arg(0))
		local alias = aliases[name]
		local base = registry[name]

		if alias and not base then
			Cvar.Execute(alias, (depth :: number) + 1)
		elseif not base then
			if IS_CLIENT and forwarder then
				forwarder(statement)
			else
				Cvar.Msg(string.format('Unknown command "%s"', args:Arg(0)))
			end
		elseif
			IS_CLIENT
			and not base.isCommand
			and args:ArgC() > 1
			and hasFlag(base.flags, Cvar.FCVAR_REPLICATED)
		then
			-- replicated vars are owned by the server
			if forwarder then
				forwarder(statement)
			else
				Cvar.Msg(string.format("Can't change replicated ConVar %s from console of client, only server operator can change its value", base.name))
			end
		elseif base.isCommand then
			if hasFlag(base.flags, Cvar.FCVAR_CHEAT) and not cheatsEnabled() then
				Cvar.Msg(string.format("Can't use cheat command %s in multiplayer, unless the server has sv_cheats set to 1.", base.name))
			else
				base:Dispatch(args)
			end
		else
			if args:ArgC() == 1 then
				Cvar.PrintConVar(base)
			elseif hasFlag(base.flags, Cvar.FCVAR_CHEAT) and not cheatsEnabled() then
				Cvar.Msg(string.format("Can't change cheat cvar %s unless sv_cheats is 1.", base.name))
			else
				base:SetValue(if args:ArgC() == 2 then args:Arg(1) else args:ArgS())
			end
		end
	end
end

-- echoes like the Source console ("] cmd") then runs it
function Cvar.ExecuteFromConsole(text: string)
	Cvar.ConColorMsg(Cvar.COLOR_ECHO, "] " .. text)
	Cvar.Execute(text)
end

function Cvar.Complete(partial: string, maxResults: number?): { string }
	maxResults = maxResults or 64
	local results = {}
	local lower = string.lower(partial)

	-- command-specific completion once a space is typed
	local space = lower:find(" ", 1, true)
	if space then
		local base = registry[lower:sub(1, space - 1)]
		if base and base.isCommand and base.completion then
			local ok, list = pcall(base.completion, partial)
			if ok and type(list) == "table" then
				for i = 1, math.min(#list, maxResults :: number) do
					table.insert(results, list[i])
				end
			end
		end
		return results
	end

	if lower == "" then
		return results
	end

	for key, base in registry do
		if key:sub(1, #lower) == lower and isVisible(base) then
			table.insert(results, base.name)
		end
	end
	for key in aliases do
		if key:sub(1, #lower) == lower and not registry[key] then
			table.insert(results, key)
		end
	end

	table.sort(results, function(a, b)
		return string.lower(a) < string.lower(b)
	end)
	while #results > (maxResults :: number) do
		table.remove(results)
	end
	return results
end

-- completion helper: "cmd <name of any cvar>"
function Cvar.CompleteCvarArgument(partial: string): { string }
	local cmd, rest = partial:match("^(%S+)%s+(.*)$")
	if not cmd then
		return {}
	end
	local out = {}
	for _, name in Cvar.Complete(rest :: string) do
		table.insert(out, cmd .. " " .. name)
	end
	return out
end

------------------------------------------------------------------------
-- Built-ins
------------------------------------------------------------------------

local FCVAR_NOTIFY_REPLICATED = Cvar.FCVAR_NOTIFY + Cvar.FCVAR_REPLICATED

Cvar.ConVar("sv_cheats", 1, FCVAR_NOTIFY_REPLICATED, "Allow cheats on server", 0, 1, function(var)
	if not var:GetBool() then
		-- RevertFlaggedConVars( FCVAR_CHEAT )
		for _, base in registry do
			if not base.isCommand and hasFlag(base.flags, Cvar.FCVAR_CHEAT) then
				base:Revert()
			end
		end
	end
end)

Cvar.ConVar("developer", 0, 0, "Set developer message level (2 = print entity I/O)", 0, 2)

-- Msg only when developer >= level (DevMsg)
function Cvar.DevMsg(level: number, text: string)
	local developer = registry["developer"]
	if developer and developer:GetInt() >= level then
		Cvar.ConColorMsg(Cvar.COLOR_HIGHLIGHT, text)
	end
end

Cvar.ConCommand("help", function(args)
	if args:ArgC() < 2 then
		Cvar.Msg("Usage:  help <cvarname>")
		return
	end
	local base = Cvar.Find(args:Arg(1))
	if not base then
		Cvar.Msg(string.format('help:  no cvar or command named %s', args:Arg(1)))
		return
	end
	if base.isCommand then
		local flags = Cvar.FlagString(base.flags)
		Cvar.Msg(string.format('"%s"%s', base.name, if flags ~= "" then " " .. flags else ""))
		if base.help ~= "" then
			Cvar.Msg(" - " .. base.help)
		end
	else
		Cvar.PrintConVar(base)
	end
end, "Find help about a convar/concommand.", 0, Cvar.CompleteCvarArgument)

Cvar.ConCommand("find", function(args)
	if args:ArgC() < 2 then
		Cvar.Msg("Usage:  find <string>")
		return
	end
	local needle = string.lower(args:Arg(1))
	for _, base in Cvar.GetAll() do
		if not isVisible(base) then
			continue
		end
		if string.lower(base.name):find(needle, 1, true) or string.lower(base.help):find(needle, 1, true) then
			if base.isCommand then
				Cvar.Msg(string.format('"%s" %s - %s', base.name, Cvar.FlagString(base.flags), base.help))
			else
				Cvar.Msg(string.format('"%s" = "%s" %s - %s', base.name, base.value, Cvar.FlagString(base.flags), base.help))
			end
		end
	end
end, "Find concommands with the specified string in their name/help text.")

Cvar.ConCommand("cvarlist", function(args)
	local prefix = string.lower(args:Arg(1))
	local count = 0
	Cvar.Msg("cvar list\n--------------")
	for _, base in Cvar.GetAll() do
		if not isVisible(base) then
			continue
		end
		if prefix ~= "" and string.lower(base.name):sub(1, #prefix) ~= prefix then
			continue
		end
		count += 1
		Cvar.Msg(string.format(
			"%-32s : %-8s : %-24s : %s",
			base.name,
			if base.isCommand then "cmd" else base.value,
			Cvar.FlagString(base.flags),
			base.help
		))
	end
	Cvar.Msg(string.format("--------------\n%d total convars/concommands", count))
end, "Show the list of convars/concommands.")

Cvar.ConCommand("differences", function()
	for _, base in Cvar.GetAll() do
		if not base.isCommand and base.value ~= base.default then
			Cvar.PrintConVar(base)
		end
	end
end, "Show all convars which are not at their default values.")

Cvar.ConCommand("echo", function(args)
	Cvar.Msg(args:ArgS())
end, "Echo text to console.")

Cvar.ConCommand("toggle", function(args)
	if args:ArgC() < 2 then
		Cvar.Msg("Usage:  toggle <cvarname> [value1] [value2] [value3]...")
		return
	end
	local var = Cvar.FindVar(args:Arg(1))
	if not var then
		Cvar.Msg(string.format('toggle: no cvar named %s', args:Arg(1)))
		return
	end
	if hasFlag(var.flags, Cvar.FCVAR_CHEAT) and not cheatsEnabled() then
		Cvar.Msg(string.format("Can't change cheat cvar %s unless sv_cheats is 1.", var.name))
		return
	end

	if args:ArgC() == 2 then
		var:SetValue(if var:GetBool() then 0 else 1)
		return
	end

	-- cycle through the given values
	local values = {}
	for i = 2, args:ArgC() - 1 do
		table.insert(values, args:Arg(i))
	end
	local nextIndex = 1
	for i, v in values do
		if v == var:GetString() or tonumber(v) == var:GetFloat() then
			nextIndex = (i % #values) + 1
			break
		end
	end
	var:SetValue(values[nextIndex])
end, "Toggles a convar on or off, or cycles through a set of values.", 0, Cvar.CompleteCvarArgument)

Cvar.ConCommand("incrementvar", function(args)
	if args:ArgC() ~= 5 then
		Cvar.Msg("Usage:  incrementvar varName minValue maxValue delta")
		return
	end
	local var = Cvar.FindVar(args:Arg(1))
	if not var then
		Cvar.Msg(string.format("cvar \"%s\" not found", args:Arg(1)))
		return
	end
	if hasFlag(var.flags, Cvar.FCVAR_CHEAT) and not cheatsEnabled() then
		Cvar.Msg(string.format("Can't change cheat cvar %s unless sv_cheats is 1.", var.name))
		return
	end
	local minV = tonumber(args:Arg(2)) or 0
	local maxV = tonumber(args:Arg(3)) or 0
	local delta = tonumber(args:Arg(4)) or 0
	local newValue = var:GetFloat() + delta
	if newValue > maxV then
		newValue = minV
	elseif newValue < minV then
		newValue = maxV
	end
	var:SetValue(newValue)
end, "Increment specified convar value.", 0, Cvar.CompleteCvarArgument)

Cvar.ConCommand("alias", function(args)
	if args:ArgC() == 1 then
		Cvar.Msg("Current alias commands:")
		local names = {}
		for name in aliases do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in names do
			Cvar.Msg(string.format("%s : %s", name, aliases[name]))
		end
		return
	end

	local name = string.lower(args:Arg(1))
	if args:ArgC() == 2 then
		if aliases[name] then
			Cvar.Msg(string.format("%s : %s", name, aliases[name]))
		else
			Cvar.Msg(string.format("Alias %s not found", name))
		end
		return
	end

	if registry[name] then
		Cvar.Msg(string.format('Cannot alias "%s", it is already a command or cvar', name))
		return
	end

	local parts = {}
	for i = 2, args:ArgC() - 1 do
		table.insert(parts, args:Arg(i))
	end
	aliases[name] = table.concat(parts, " ")
end, "Alias a command.")

Cvar.ConCommand("unalias", function(args)
	local name = string.lower(args:Arg(1))
	if aliases[name] then
		aliases[name] = nil
	else
		Cvar.Msg(string.format("Alias %s not found", name))
	end
end, "Remove an alias.")

Cvar.ConCommand("revert", function(args)
	local var = Cvar.FindVar(args:Arg(1))
	if not var then
		Cvar.Msg("Usage:  revert <cvarname>")
		return
	end
	var:Revert()
end, "Revert a convar to its default value.", 0, Cvar.CompleteCvarArgument)

return Cvar
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000008">
						<Properties>
							<string name="Name">GameMovement</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	GameMovement (ModuleScript)
	ReplicatedStorage.BloxSDK.Shared.GameMovement

	Luau port of CGameMovement from Source SDK 2013 (game/shared/gamemovement.cpp),
	including the HL2 jump boost from the HL2_DLL path.

	Conventions:
	  * All maths is in Source units (1 unit = 1 inch), converted to studs only for
	    traces and when the client places the character (ConVars.units_per_stud).
	  * Axes are Roblox axes: Y is up. Source's "z" is "Y" here.
	  * origin is the player's feet (bottom-centre of the hull), same as Source.

	Ported:   FullWalkMove, WalkMove, AirMove, StepMove, TryPlayerMove, ClipVelocity,
	          Accelerate, AirAccelerate, Friction, CheckJumpButton (+HL2 boost),
	          Start/FinishGravity, CategorizePosition, StayOnGround, CheckVelocity,
	          CheckFalling, Duck (incl. in-air duck), CanUnDuck, CheckStuck, FullNoClipMove,
	          CheckWater, WaterMove, CheckWaterJump, WaterJump, LadderMove, FullLadderMove,
	          base velocity (trigger_push / conveyors).
	Not yet:  TryTouchGroundInQuadrants, water currents.
	Extra:    moving-platform carry (Roblox has no ground-entity parenting).

	Water:    terrain water, or parts with Attribute classname = "func_water" (or tag func_water).
	Ladders:  parts with Attribute classname = "func_ladder" (or tag func_ladder). Keep them CanCollide.
	          A Model with the attribute makes all its parts count.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local GameMovement = {}
GameMovement.__index = GameMovement

GameMovement.ConVars = {
	sv_gravity = 600,
	sv_maxspeed = 320,
	sv_accelerate = 10,
	sv_airaccelerate = 10,
	sv_friction = 4,
	sv_stopspeed = 100,
	sv_stepsize = 18,
	sv_bounce = 0,
	sv_maxvelocity = 3500,
	sv_noclipspeed = 5,
	sv_noclipaccelerate = 5,
	sv_autobunnyhopping = false, -- false = must release jump between hops (stock Source)
	hl2_jumpboost = true, -- HL2 singleplayer forward jump boost (the thing that causes ABH)
	units_per_stud = 14, -- 72-unit player = ~5.1 studs, close to an R15 rig
}
local ConVars = GameMovement.ConVars

-- Register the movement settings as console convars. ConVars stays a plain table
-- for fast reads every tick; the change callbacks keep it in sync.
do
	local Cvar = require(script.Parent:WaitForChild("ConVar"))
	local NR = Cvar.FCVAR_NOTIFY + Cvar.FCVAR_REPLICATED

	local defs = {
		{ "sv_gravity", "sv_gravity", NR, "World gravity." },
		{ "sv_maxspeed", "sv_maxspeed", NR, "Maximum speed a player can move.", 0 },
		{ "sv_accelerate", "sv_accelerate", NR, "Linear acceleration amount." },
		{ "sv_airaccelerate", "sv_airaccelerate", NR, "Air acceleration amount." },
		{ "sv_friction", "sv_friction", NR, "World friction." },
		{ "sv_stopspeed", "sv_stopspeed", NR, "Minimum stopping speed when on ground.", 0 },
		{ "sv_stepsize", "sv_stepsize", NR, "Maximum step height.", 0 },
		{ "sv_bounce", "sv_bounce", NR, "Bounce multiplier for when the player hits a wall in the air.", 0 },
		{ "sv_maxvelocity", "sv_maxvelocity", Cvar.FCVAR_REPLICATED, "Maximum speed any ballistically moving object is allowed to attain per axis.", 0 },
		{ "sv_noclipspeed", "sv_noclipspeed", NR, "Noclip speed multiplier.", 0 },
		{ "sv_noclipaccelerate", "sv_noclipaccelerate", NR, "Noclip acceleration.", 0 },
		{ "sv_autobunnyhopping", "sv_autobunnyhopping", NR, "Players automatically re-jump while holding jump.", 0, 1 },
		{ "hl2_jumpboost", "hl2_jumpboost", NR, "HL2 singleplayer forward jump boost (enables ABH).", 0, 1 },
		{ "bsdk_units_per_stud", "units_per_stud", Cvar.FCVAR_REPLICATED, "Source units per Roblox stud.", 1, 100 },
	}

	for _, def in defs do
		local cvarName, key, flags, help, min, max = def[1], def[2], def[3], def[4], def[5], def[6]
		local isBool = type(ConVars[key]) == "boolean"
		local var = Cvar.ConVar(cvarName, ConVars[key], flags, help, min, max)
		local function sync()
			ConVars[key] = if isBool then var:GetBool() else var:GetFloat()
		end
		var:AddChangeCallback(sync)
		sync()
	end
end

-- Hulls (Roblox axes, feet at origin)
local VEC_HULL_MIN = Vector3.new(-16, 0, -16)
local VEC_HULL_MAX = Vector3.new(16, 72, 16)
local VEC_DUCK_HULL_MIN = Vector3.new(-16, 0, -16)
local VEC_DUCK_HULL_MAX = Vector3.new(16, 36, 16)
local VEC_VIEW = 64
local VEC_DUCK_VIEW = 28
local DUCK_HULL_DELTA = (VEC_HULL_MAX - VEC_HULL_MIN).Y - (VEC_DUCK_HULL_MAX - VEC_DUCK_HULL_MIN).Y -- 36

GameMovement.VEC_HULL_MIN = VEC_HULL_MIN
GameMovement.VEC_HULL_MAX = VEC_HULL_MAX
GameMovement.VEC_DUCK_HULL_MIN = VEC_DUCK_HULL_MIN
GameMovement.VEC_DUCK_HULL_MAX = VEC_DUCK_HULL_MAX
GameMovement.VEC_VIEW = VEC_VIEW
GameMovement.VEC_DUCK_VIEW = VEC_DUCK_VIEW

local TIME_TO_DUCK = 0.4
local TIME_TO_UNDUCK = 0.2
local PLAYER_DUCKING_MULTIPLIER = 0.333
local GAMEMOVEMENT_JUMP_HEIGHT = 21
local NON_JUMP_VELOCITY = 140
local MAX_CLIP_PLANES = 5
local MIN_GROUND_NORMAL = 0.7
local COORD_RESOLUTION = 1 / 32
local PLAYER_FALL_PUNCH_THRESHOLD = 350
local PLAYER_MAX_SAFE_FALL_SPEED = 526.5
local PLAYER_FATAL_FALL_SPEED = 922.5
local DAMAGE_FOR_FALL_SPEED = 100 / (PLAYER_FATAL_FALL_SPEED - PLAYER_MAX_SAFE_FALL_SPEED)

GameMovement.PLAYER_FALL_PUNCH_THRESHOLD = PLAYER_FALL_PUNCH_THRESHOLD

-- Roblox-specific
local SKIN_STUDS = 0.01 -- how far traces stop short of a surface (Roblox's DIST_EPSILON)
local OVERLAP_SHRINK_STUDS = 0.02
local MAX_CARRY_PER_TICK = 64 -- units; anything bigger is a teleport, not a platform
local STUCK_RETRY_DELAY = 0.2
local FRICTION_REFERENCE = 0.2 -- Roblox friction at/above this = full Source friction (1.0)

local ZERO = Vector3.zero
local UP = Vector3.yAxis

-- water / ladders
local WL_NotInWater = 0
local WL_Feet = 1
local WL_Waist = 2
local WL_Eyes = 3
local WATERJUMP_HEIGHT = 8
local MAX_CLIMB_SPEED = 200
local LADDER_DISTANCE = 2

GameMovement.WL_NotInWater = WL_NotInWater
GameMovement.WL_Feet = WL_Feet
GameMovement.WL_Waist = WL_Waist
GameMovement.WL_Eyes = WL_Eyes

------------------------------------------------------------------------
-- Brush volumes (func_water / func_ladder), tracked on the client
------------------------------------------------------------------------

local waterParts: { [BasePart]: boolean } = {}
local ladderParts: { [BasePart]: boolean } = {}
local volumesStarted = false

local function brushClassOf(part: BasePart): string?
	if CollectionService:HasTag(part, "func_water") then
		return "func_water"
	elseif CollectionService:HasTag(part, "func_ladder") then
		return "func_ladder"
	end
	local cls = part:GetAttribute("classname")
	if cls == nil and part.Parent and part.Parent:IsA("Model") then
		cls = part.Parent:GetAttribute("classname")
	end
	if type(cls) == "string" then
		cls = string.lower(cls)
		if cls == "func_water" or cls == "func_ladder" then
			return cls
		end
	end
	return nil
end

local function trackVolume(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	local cls = brushClassOf(inst)
	if cls == "func_water" then
		waterParts[inst] = true
		if RunService:IsClient() then
			inst.CanCollide = false
		end
	elseif cls == "func_ladder" then
		ladderParts[inst] = true
	end
end

local function untrackVolume(inst: Instance)
	if inst:IsA("BasePart") then
		waterParts[inst] = nil
		ladderParts[inst] = nil
	end
end

local function startVolumeTracking()
	if volumesStarted then
		return
	end
	volumesStarted = true
	for _, d in Workspace:GetDescendants() do
		trackVolume(d)
	end
	Workspace.DescendantAdded:Connect(trackVolume)
	Workspace.DescendantRemoving:Connect(untrackVolume)
	for _, tag in { "func_water", "func_ladder" } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(trackVolume)
	end
end

local function isLadderInstance(inst: Instance?): boolean
	return inst ~= nil and inst:IsA("BasePart") and ladderParts[inst :: BasePart] == true
end

GameMovement.IsLadderPart = isLadderInstance

-- Offsets tried by CheckStuck, nearest first (like Source's rgv3tStuckTable)
local STUCK_OFFSETS = {}
do
	for y = 1, DUCK_HULL_DELTA do
		table.insert(STUCK_OFFSETS, Vector3.new(0, y, 0))
	end
	local dirs = {
		Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
		Vector3.new(1, 0, 1).Unit, Vector3.new(-1, 0, 1).Unit, Vector3.new(1, 0, -1).Unit, Vector3.new(-1, 0, -1).Unit,
	}
	for r = 2, 16, 2 do
		for _, d in dirs do
			table.insert(STUCK_OFFSETS, d * r)
			table.insert(STUCK_OFFSETS, d * r + Vector3.new(0, r, 0))
		end
	end
	for y = 1, 8 do
		table.insert(STUCK_OFFSETS, Vector3.new(0, -y, 0))
	end
end

local function SimpleSpline(v: number): number
	return 3 * v * v - 2 * v * v * v
end

local function Flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function SetY(v: Vector3, y: number): Vector3
	return Vector3.new(v.X, y, v.Z)
end

local function ClipVelocity(vin: Vector3, normal: Vector3, overbounce: number): Vector3
	local backoff = vin:Dot(normal) * overbounce
	local out = vin - normal * backoff
	-- iterate once to make sure we aren't still moving through the plane
	local adjust = out:Dot(normal)
	if adjust < 0 then
		out -= normal * adjust
	end
	return out
end
GameMovement.ClipVelocity = ClipVelocity

local function YawBasis(yawDeg: number): (Vector3, Vector3)
	local r = math.rad(yawDeg)
	local s, c = math.sin(r), math.cos(r)
	-- matches CFrame.fromOrientation(0, r, 0).LookVector / .RightVector
	return Vector3.new(-s, 0, -c), Vector3.new(c, 0, -s)
end

function GameMovement.GetFallDamage(fallSpeed: number): number
	if fallSpeed <= PLAYER_MAX_SAFE_FALL_SPEED then
		return 0
	end
	return (fallSpeed - PLAYER_MAX_SAFE_FALL_SPEED) * DAMAGE_FOR_FALL_SPEED
end

export type Trace = {
	fraction: number,
	endpos: Vector3,
	normal: Vector3?,
	instance: Instance?,
	material: Enum.Material?,
}

export type MoveCmd = {
	forwardmove: number,
	sidemove: number,
	upmove: number,
	jump: boolean,
	duck: boolean,
	sprint: boolean,
	maxspeed: number,
	pitch: number,
	yaw: number,
}

function GameMovement.new(ignore: { Instance }?)
	local self = setmetatable({}, GameMovement)

	self.origin = ZERO
	self.velocity = ZERO
	self.pitch = 0
	self.yaw = 0

	self.onGround = false
	self.groundInstance = nil :: Instance?
	self.surfaceFriction = 1

	self.ducked = false
	self.duckAmount = 0
	self.viewOffset = VEC_VIEW

	self.fallVelocity = 0
	self.noclip = false
	self.oldJump = false
	self.maxspeed = ConVars.sv_maxspeed

	self.frametime = 0
	self.fmove = 0
	self.smove = 0
	self.umove = 0
	self.cmd = nil :: MoveCmd?

	-- platform carry
	self.carryPart = nil :: BasePart?
	self.carryCFrame = nil :: CFrame?
	self.platformVelocity = ZERO
	self.carryYaw = 0
	self.carried = false

	self.stuckCooldown = 0

	-- base velocity (trigger_push etc.), set by the owner every tick
	self.baseVelocity = ZERO

	-- water
	self.waterLevel = WL_NotInWater
	self.waterJumpTime = 0
	self.waterJumpVel = ZERO
	self.waterEntryTime = 0

	-- ladders
	self.onLadder = false
	self.ladderNormal = ZERO

	-- callbacks
	self.OnLand = nil :: ((fallSpeed: number) -> ())?
	self.OnJump = nil :: (() -> ())?

	self.rayParams = RaycastParams.new()
	self.rayParams.FilterType = Enum.RaycastFilterType.Exclude
	self.rayParams.RespectCanCollide = true
	self.rayParams.IgnoreWater = true

	self.overlapParams = OverlapParams.new()
	self.overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	self.overlapParams.RespectCanCollide = true

	local probe = Instance.new("Part")
	probe.Name = "BloxSDK_HullProbe"
	probe.Anchored = true
	probe.CanCollide = false
	probe.CanQuery = false
	probe.CanTouch = false
	probe.Transparency = 1
	probe.Parent = Workspace.CurrentCamera or Workspace
	self.probe = probe

	self:SetIgnoreList(ignore or {})
	startVolumeTracking()
	return self
end

function GameMovement:Destroy()
	if self.probe then
		self.probe:Destroy()
		self.probe = nil
	end
end

function GameMovement:SetIgnoreList(list: { Instance })
	local filter = table.clone(list)
	table.insert(filter, self.probe)
	self.rayParams.FilterDescendantsInstances = filter
	self.overlapParams.FilterDescendantsInstances = filter
end

function GameMovement:GetHull(): (Vector3, Vector3)
	if self.ducked then
		return VEC_DUCK_HULL_MIN, VEC_DUCK_HULL_MAX
	end
	return VEC_HULL_MIN, VEC_HULL_MAX
end

function GameMovement:Teleport(origin: Vector3, velocity: Vector3?)
	self.origin = origin
	self.velocity = velocity or ZERO
	self.fallVelocity = 0
	self.waterJumpTime = 0
	self.onLadder = false
	self.carryPart = nil
	self.carryCFrame = nil
	self.platformVelocity = ZERO
	if not self.noclip then
		self:CheckStuck()
		self:CategorizePosition()
	end
end

function GameMovement:SetNoclip(enabled: boolean)
	if self.noclip == enabled then
		return
	end
	self.noclip = enabled
	self.onLadder = false
	self.waterJumpTime = 0
	self.ducked = false
	self.duckAmount = 0
	self.viewOffset = VEC_VIEW
	self.surfaceFriction = 1
	self.onGround = false
	self.groundInstance = nil
	self.carryPart = nil
	self.carryCFrame = nil
	self.platformVelocity = ZERO
	if not enabled then
		self.stuckCooldown = 0
		self:CheckStuck()
		self:CategorizePosition()
	end
end

------------------------------------------------------------------------
-- Traces (UTIL_TraceHull equivalent)
------------------------------------------------------------------------

function GameMovement:TraceHull(start: Vector3, finish: Vector3, mins: Vector3, maxs: Vector3): Trace
	local ups = ConVars.units_per_stud
	local delta = finish - start
	local lenUnits = delta.Magnitude

	if lenUnits < 1e-4 then
		return { fraction = 1, endpos = finish }
	end

	local size = (maxs - mins) / ups
	local center = (start + (mins + maxs) * 0.5) / ups
	local result = Workspace:Blockcast(CFrame.new(center), size, delta / ups, self.rayParams)

	if not result then
		return { fraction = 1, endpos = finish }
	end

	local fraction = math.clamp(result.Distance / (lenUnits / ups), 0, 1)
	local normal = result.Normal
	-- stop at the contact point and back off along the surface normal so the
	-- next cast never starts inside it (shapecasts ignore initial overlaps)
	local endpos = start + delta * fraction + normal * (SKIN_STUDS * ups)

	return {
		fraction = fraction,
		endpos = endpos,
		normal = normal,
		instance = result.Instance,
		material = result.Material,
	}
end

-- true if the hull fits at origin
function GameMovement:TestHull(origin: Vector3, mins: Vector3, maxs: Vector3): boolean
	local ups = ConVars.units_per_stud
	local probe = self.probe
	local size = (maxs - mins) / ups - Vector3.one * OVERLAP_SHRINK_STUDS
	probe.Size = Vector3.new(math.max(size.X, 0.01), math.max(size.Y, 0.01), math.max(size.Z, 0.01))
	probe.CFrame = CFrame.new((origin + (mins + maxs) * 0.5) / ups)
	return #Workspace:GetPartsInPart(probe, self.overlapParams) == 0
end

------------------------------------------------------------------------
-- Entry point (CGameMovement::ProcessMovement / PlayerMove)
------------------------------------------------------------------------

function GameMovement:ProcessMovement(cmd: MoveCmd, dt: number)
	self.cmd = cmd
	self.frametime = dt
	self.pitch = cmd.pitch
	self.yaw = cmd.yaw
	self.carryYaw = 0
	self.carried = false

	self:CheckParameters()

	if self.noclip then
		self:FullNoClipMove()
		return
	end

	self:UpdateGroundCarry()
	self:CheckStuck()

	-- sv_optimizedmovement
	if self.carried then
		self:CategorizePosition()
	elseif self.velocity.Y > 250 then
		self:SetGroundEntity(nil)
	end

	-- If we are not on ground, store off how fast we are moving down
	if not self.onGround then
		self.fallVelocity = -self.velocity.Y
	end

	self:Duck()

	-- Don't run ladder code if dead or on a train
	if not self:LadderMove() and self.onLadder then
		-- Clear ladder stuff; it will be reset immediately next frame if necessary
		self.onLadder = false
	end

	if self.onLadder then
		self:FullLadderMove()
	else
		self:FullWalkMove()
	end
end

function GameMovement:CheckParameters()
	local cmd = self.cmd
	local maxspeed = math.min(cmd.maxspeed or ConVars.sv_maxspeed, ConVars.sv_maxspeed)
	self.maxspeed = maxspeed

	local fmove, smove, umove = cmd.forwardmove, cmd.sidemove, cmd.upmove

	if not self.noclip then
		local spd = fmove * fmove + smove * smove + umove * umove
		if spd ~= 0 and spd > maxspeed * maxspeed then
			local ratio = maxspeed / math.sqrt(spd)
			fmove *= ratio
			smove *= ratio
			umove *= ratio
		end
	end

	self.fmove, self.smove, self.umove = fmove, smove, umove
end

------------------------------------------------------------------------
-- Walking
------------------------------------------------------------------------

function GameMovement:FullWalkMove()
	if not self:CheckWater() then
		self:StartGravity()
	end

	-- If we are leaping out of the water, just update the counters.
	if self.waterJumpTime > 0 then
		self:WaterJump()
		self:TryPlayerMove()
		self:CheckWater()
		return
	end

	-- If we are swimming in the water, see if we are nudging against a place we can jump up out
	--  of, and, if so, start out jump.  Otherwise, if we are not moving up, then reset jump timer to 0
	if self.waterLevel >= WL_Waist then
		if self.waterLevel == WL_Waist then
			self:CheckWaterJump()
		end

		-- If we are falling again, then we must not trying to jump out of water any more.
		if self.velocity.Y < 0 and self.waterJumpTime > 0 then
			self.waterJumpTime = 0
		end

		-- Was jump button pressed?
		if self.cmd.jump then
			self:CheckJumpButton()
		else
			self.oldJump = false
		end

		-- Perform regular water movement
		self:WaterMove()

		-- Redetermine position vars
		self:CategorizePosition()

		-- If we are on ground, no downward velocity.
		if self.onGround then
			self.velocity = SetY(self.velocity, 0)
		end
	else
		if self.cmd.jump then
			self:CheckJumpButton()
		else
			self.oldJump = false
		end

		-- Friction is handled before we add in any base velocity. That way, if we are on a conveyor,
		--  we don't slow when standing still, relative to the conveyor.
		if self.onGround then
			self.velocity = SetY(self.velocity, 0)
			self:Friction()
		end

		self:CheckVelocity()

		if self.onGround then
			self:WalkMove()
		else
			self:AirMove()
		end

		self:CategorizePosition()
		self:CheckVelocity()

		if not self:CheckWater() then
			self:FinishGravity()
		end

		if self.onGround then
			self.velocity = SetY(self.velocity, 0)
		end

		self:CheckFalling()
	end
end

function GameMovement:WalkMove()
	local forward, right = YawBasis(self.yaw)
	local wishvel = forward * self.fmove + right * self.smove
	local wishspeed = wishvel.Magnitude
	local wishdir = if wishspeed > 0 then wishvel / wishspeed else ZERO

	if wishspeed ~= 0 and wishspeed > self.maxspeed then
		wishspeed = self.maxspeed
	end

	self.velocity = SetY(self.velocity, 0)
	self:Accelerate(wishdir, wishspeed, ConVars.sv_accelerate)
	self.velocity = SetY(self.velocity, 0)

	-- Add in any base velocity to the current velocity.
	self.velocity += self.baseVelocity

	local spd = self.velocity.Magnitude
	if spd < 1 then
		self.velocity = ZERO
		-- Now pull the base velocity back out.
		self.velocity -= self.baseVelocity
		return
	end

	local mins, maxs = self:GetHull()
	local dest = self.origin + self.velocity * self.frametime
	dest = SetY(dest, self.origin.Y)
	local trace = self:TraceHull(self.origin, dest, mins, maxs)

	if trace.fraction == 1 then
		self.origin = trace.endpos
		self.velocity -= self.baseVelocity
		self:StayOnGround()
		return
	end

	self:StepMove()

	-- Now pull the base velocity back out.
	self.velocity -= self.baseVelocity
	self:StayOnGround()
end

function GameMovement:StepMove()
	local mins, maxs = self:GetHull()
	local stepsize = ConVars.sv_stepsize
	local vecPos = self.origin
	local vecVel = self.velocity

	-- Slide move down.
	self:TryPlayerMove()
	local vecDownPos = self.origin
	local vecDownVel = self.velocity

	-- Reset original values.
	self.origin = vecPos
	self.velocity = vecVel

	-- Move up a stair height.
	local trace = self:TraceHull(self.origin, self.origin + UP * stepsize, mins, maxs)
	self.origin = trace.endpos

	-- Slide move up.
	self:TryPlayerMove()

	-- Move down a stair (attempt to).
	trace = self:TraceHull(self.origin, self.origin - UP * stepsize, mins, maxs)
	self.origin = trace.endpos

	-- If we are not on the ground any more then use the original movement attempt.
	if not trace.normal or trace.normal.Y < MIN_GROUND_NORMAL then
		self.origin = vecDownPos
		self.velocity = vecDownVel
		return
	end

	local vecUpPos = self.origin

	-- decide which one went farther
	local downDist = (vecDownPos.X - vecPos.X) ^ 2 + (vecDownPos.Z - vecPos.Z) ^ 2
	local upDist = (vecUpPos.X - vecPos.X) ^ 2 + (vecUpPos.Z - vecPos.Z) ^ 2
	if downDist > upDist then
		self.origin = vecDownPos
		self.velocity = vecDownVel
	else
		-- copy z value from slide move
		self.velocity = SetY(self.velocity, vecDownVel.Y)
	end
end

function GameMovement:StayOnGround()
	local mins, maxs = self:GetHull()
	local start = self.origin + UP * 2
	local finish = self.origin - UP * ConVars.sv_stepsize

	-- See how far up we can go without getting stuck
	local trace = self:TraceHull(self.origin, start, mins, maxs)
	start = trace.endpos

	-- Now trace down from a known safe position
	trace = self:TraceHull(start, finish, mins, maxs)
	if trace.fraction > 0 and trace.fraction < 1 and trace.normal and trace.normal.Y >= MIN_GROUND_NORMAL then
		if math.abs(self.origin.Y - trace.endpos.Y) > 0.5 * COORD_RESOLUTION then
			self.origin = trace.endpos
		end
	end
end

------------------------------------------------------------------------
-- Air
------------------------------------------------------------------------

function GameMovement:AirMove()
	local forward, right = YawBasis(self.yaw)
	local wishvel = forward * self.fmove + right * self.smove
	local wishspeed = wishvel.Magnitude
	local wishdir = if wishspeed > 0 then wishvel / wishspeed else ZERO

	if wishspeed ~= 0 and wishspeed > self.maxspeed then
		wishspeed = self.maxspeed
	end

	self:AirAccelerate(wishdir, wishspeed, ConVars.sv_airaccelerate)

	-- Add in any base velocity to the current velocity.
	self.velocity += self.baseVelocity
	self:TryPlayerMove()
	-- Now pull the base velocity back out.
	self.velocity -= self.baseVelocity
end

------------------------------------------------------------------------
-- Acceleration / friction
------------------------------------------------------------------------

function GameMovement:Accelerate(wishdir: Vector3, wishspeed: number, accel: number)
	local currentspeed = self.velocity:Dot(wishdir)
	local addspeed = wishspeed - currentspeed
	if addspeed <= 0 then
		return
	end

	local accelspeed = accel * self.frametime * wishspeed * self.surfaceFriction
	if accelspeed > addspeed then
		accelspeed = addspeed
	end

	self.velocity += wishdir * accelspeed
end

function GameMovement:AirAccelerate(wishdir: Vector3, wishspeed: number, accel: number)
	local wishspd = wishspeed
	-- Cap speed (CGameMovement::GetAirSpeedCap)
	if wishspd > 30 then
		wishspd = 30
	end

	local currentspeed = self.velocity:Dot(wishdir)
	local addspeed = wishspd - currentspeed
	if addspeed <= 0 then
		return
	end

	local accelspeed = accel * wishspeed * self.frametime * self.surfaceFriction
	if accelspeed > addspeed then
		accelspeed = addspeed
	end

	self.velocity += wishdir * accelspeed
end

function GameMovement:Friction()
	local speed = self.velocity.Magnitude
	if speed < 0.1 then
		return
	end

	local drop = 0
	if self.onGround then
		local friction = ConVars.sv_friction * self.surfaceFriction
		local control = if speed < ConVars.sv_stopspeed then ConVars.sv_stopspeed else speed
		drop += control * friction * self.frametime
	end

	local newspeed = math.max(speed - drop, 0)
	if newspeed ~= speed then
		self.velocity *= newspeed / speed
	end
end

------------------------------------------------------------------------
-- Slide move
------------------------------------------------------------------------

function GameMovement:TryPlayerMove(): number
	local mins, maxs = self:GetHull()
	local numbumps = 4
	local blocked = 0
	local numplanes = 0
	local planes = table.create(MAX_CLIP_PLANES)
	local primalVelocity = self.velocity
	local originalVelocity = self.velocity
	local allFraction = 0
	local timeLeft = self.frametime

	for _ = 1, numbumps do
		if self.velocity.Magnitude == 0 then
			break
		end

		local endPos = self.origin + self.velocity * timeLeft
		local trace = self:TraceHull(self.origin, endPos, mins, maxs)

		allFraction += trace.fraction

		-- actually covered some distance
		if trace.fraction > 0 then
			self.origin = trace.endpos
			originalVelocity = self.velocity
			numplanes = 0
		end

		-- moved the entire distance
		if trace.fraction == 1 then
			break
		end

		local n = trace.normal :: Vector3
		if n.Y > MIN_GROUND_NORMAL then
			blocked = bit32.bor(blocked, 1) -- floor
		end
		if math.abs(n.Y) < 1e-4 then
			blocked = bit32.bor(blocked, 2) -- step / wall
		end

		timeLeft -= timeLeft * trace.fraction

		if numplanes >= MAX_CLIP_PLANES then
			self.velocity = ZERO
			break
		end

		numplanes += 1
		planes[numplanes] = n

		if numplanes == 1 and not self.onGround then
			-- reflect player velocity; only one plane in the air
			local newVelocity
			if n.Y > MIN_GROUND_NORMAL then
				newVelocity = ClipVelocity(originalVelocity, n, 1)
			else
				newVelocity = ClipVelocity(originalVelocity, n, 1 + ConVars.sv_bounce * (1 - self.surfaceFriction))
			end
			self.velocity = newVelocity
			originalVelocity = newVelocity
		else
			local i = 1
			while i <= numplanes do
				self.velocity = ClipVelocity(originalVelocity, planes[i], 1)
				local j = 1
				while j <= numplanes do
					if j ~= i and self.velocity:Dot(planes[j]) < 0 then
						break -- not ok
					end
					j += 1
				end
				if j > numplanes then
					break -- didn't have to clip, so we're ok
				end
				i += 1
			end

			if i > numplanes then
				-- go along the crease
				if numplanes ~= 2 then
					self.velocity = ZERO
					break
				end
				local dir = planes[1]:Cross(planes[2])
				if dir.Magnitude < 1e-6 then
					self.velocity = ZERO
					break
				end
				dir = dir.Unit
				self.velocity = dir * dir:Dot(self.velocity)
			end

			-- if velocity is against the original velocity, stop dead
			-- to avoid tiny occilations in sloping corners
			if self.velocity:Dot(primalVelocity) <= 0 then
				self.velocity = ZERO
				break
			end
		end
	end

	if allFraction == 0 then
		self.velocity = ZERO
	end

	return blocked
end

------------------------------------------------------------------------
-- Gravity / velocity
------------------------------------------------------------------------

function GameMovement:StartGravity()
	local v = self.velocity
	-- Add gravity so they'll be in the correct position during movement
	-- yes, this 0.5 looks wrong, but it's not.
	local y = v.Y - ConVars.sv_gravity * 0.5 * self.frametime
	y += self.baseVelocity.Y * self.frametime
	self.velocity = SetY(v, y)
	self.baseVelocity = SetY(self.baseVelocity, 0)
	self:CheckVelocity()
end

function GameMovement:FinishGravity()
	if self.waterJumpTime > 0 then
		return
	end
	local v = self.velocity
	self.velocity = SetY(v, v.Y - ConVars.sv_gravity * 0.5 * self.frametime)
	self:CheckVelocity()
end

function GameMovement:CheckVelocity()
	local maxv = ConVars.sv_maxvelocity
	local v = self.velocity
	local x, y, z = v.X, v.Y, v.Z
	if x ~= x then x = 0 end
	if y ~= y then y = 0 end
	if z ~= z then z = 0 end
	self.velocity = Vector3.new(math.clamp(x, -maxv, maxv), math.clamp(y, -maxv, maxv), math.clamp(z, -maxv, maxv))
	local o = self.origin
	if o.X ~= o.X or o.Y ~= o.Y or o.Z ~= o.Z then
		self.origin = ZERO
	end
end

------------------------------------------------------------------------
-- Jumping
------------------------------------------------------------------------

function GameMovement:CheckJumpButton(): boolean
	-- See if we are waterjumping.  If so, decrement count and return.
	if self.waterJumpTime > 0 then
		self.waterJumpTime = math.max(self.waterJumpTime - self.frametime, 0)
		return false
	end

	-- If we are in the water most of the way...
	if self.waterLevel >= WL_Waist then
		-- swimming, not jumping
		self:SetGroundEntity(nil)
		self.velocity = SetY(self.velocity, 100)
		return false
	end

	-- No more effect
	if not self.onGround then
		self.oldJump = true
		return false
	end

	-- Don't allow jumping when the player is in a stasis field / holding jump
	if self.oldJump and not ConVars.sv_autobunnyhopping then
		return false
	end

	self:SetGroundEntity(nil)

	local gravity = ConVars.sv_gravity
	local flMul = if gravity == 600 then 160 else math.sqrt(2 * gravity * GAMEMOVEMENT_JUMP_HEIGHT)

	local v = self.velocity
	if self.ducked or self.duckAmount > 0 then
		v = SetY(v, flMul)
	else
		v = SetY(v, v.Y + flMul)
	end
	self.velocity = v

	-- HL2: add a little forward velocity based on your current forward velocity
	if ConVars.hl2_jumpboost then
		local forward = YawBasis(self.yaw)
		local flSpeedBoostPerc = if not self.cmd.sprint and not self.ducked then 0.5 else 0.1
		local flSpeedAddition = math.abs(self.fmove * flSpeedBoostPerc)
		local flMaxSpeed = self.maxspeed + self.maxspeed * flSpeedBoostPerc
		local flNewSpeed = flSpeedAddition + Flat(self.velocity).Magnitude

		-- If we're over the maximum, we want to only boost as much as will get us to the goal speed
		if flNewSpeed > flMaxSpeed then
			flSpeedAddition -= flNewSpeed - flMaxSpeed
		end

		if self.fmove < 0 then
			flSpeedAddition *= -1
		end

		self.velocity += forward * flSpeedAddition
	end

	self:FinishGravity()

	self.oldJump = true -- don't jump again until released
	if self.OnJump then
		self.OnJump()
	end
	return true
end

------------------------------------------------------------------------
-- Ground
------------------------------------------------------------------------

function GameMovement:CategorizePosition()
	local mins, maxs = self:GetHull()
	local zvel = self.velocity.Y
	local bMovingUpRapidly = zvel > NON_JUMP_VELOCITY

	if bMovingUpRapidly then
		self:SetGroundEntity(nil)
		return
	end

	local point = self.origin - UP * 2
	local trace = self:TraceHull(self.origin, point, mins, maxs)

	if not trace.instance or not trace.normal or trace.normal.Y < MIN_GROUND_NORMAL then
		self:SetGroundEntity(nil)
		if zvel > 0 then
			self.surfaceFriction = 0.25
		end
	else
		self:SetGroundEntity(trace)
	end
end

function GameMovement:SetGroundEntity(trace: Trace?)
	local wasOnGround = self.onGround

	if trace then
		self.onGround = true
		self.groundInstance = trace.instance
		self.velocity = SetY(self.velocity, 0)
		self:CategorizeGroundSurface(trace)
	else
		if wasOnGround then
			-- keep the platform's momentum when leaving it
			self.velocity += self.platformVelocity
		end
		self.onGround = false
		self.groundInstance = nil
		self.platformVelocity = ZERO
	end
end

function GameMovement:CategorizeGroundSurface(trace: Trace)
	local inst = trace.instance
	local friction = 0.3
	if inst and inst:IsA("Terrain") and trace.material then
		friction = PhysicalProperties.new(trace.material).Friction
	elseif inst and inst:IsA("BasePart") then
		friction = inst.CurrentPhysicalProperties.Friction
	end
	-- Source: m_surfaceFriction = clamp(surfacedata friction * 1.25, 0, 1)
	self.surfaceFriction = math.clamp(friction / FRICTION_REFERENCE, 0, 1)
end

function GameMovement:CheckFalling()
	if self.onGround and self.fallVelocity > 0 then
		if self.fallVelocity >= PLAYER_FALL_PUNCH_THRESHOLD and self.OnLand then
			self.OnLand(self.fallVelocity)
		end
		self.fallVelocity = 0
	end
end

-- Moves the player with whatever part they're standing on (anchored + tweened parts too)
function GameMovement:UpdateGroundCarry()
	local ground = self.onGround and self.groundInstance
	if not ground or not ground:IsA("BasePart") then
		self.carryPart = nil
		self.carryCFrame = nil
		return
	end

	local part = ground :: BasePart
	local cf = part.CFrame

	if self.carryPart == part and self.carryCFrame then
		local ups = ConVars.units_per_stud
		local oldCF = self.carryCFrame :: CFrame
		local originStuds = self.origin / ups
		local movedStuds = cf:PointToWorldSpace(oldCF:PointToObjectSpace(originStuds))
		local delta = (movedStuds - originStuds) * ups
		local mag = delta.Magnitude

		if mag > 1e-4 and mag < MAX_CARRY_PER_TICK then
			local mins, maxs = self:GetHull()
			local trace = self:TraceHull(self.origin, self.origin + delta, mins, maxs)
			self.origin = trace.endpos
			self.platformVelocity = delta / self.frametime
			self.carried = true

			local _, ry = (cf * oldCF:Inverse()):ToEulerAnglesYXZ()
			self.carryYaw = math.deg(ry)
		else
			self.platformVelocity = ZERO
		end
	end

	self.carryPart = part
	self.carryCFrame = cf
end

------------------------------------------------------------------------
-- Ducking
------------------------------------------------------------------------

function GameMovement:Duck()
	-- HandleDuckingSpeedCrop
	if self.ducked and self.onGround then
		self.fmove *= PLAYER_DUCKING_MULTIPLIER
		self.smove *= PLAYER_DUCKING_MULTIPLIER
		self.umove *= PLAYER_DUCKING_MULTIPLIER
	end

	local dt = self.frametime

	if self.cmd.duck then
		if not self.ducked then
			if not self.onGround then
				-- in-air duck is instant and pulls the feet up
				self:FinishDuck()
			else
				self.duckAmount = math.min(self.duckAmount + dt / TIME_TO_DUCK, 1)
				if self.duckAmount >= 1 then
					self:FinishDuck()
				end
			end
		end
	else
		if self.ducked then
			if self:CanUnduck() then
				if not self.onGround then
					self:FinishUnDuck()
				else
					self.duckAmount = math.max(self.duckAmount - dt / TIME_TO_UNDUCK, 0)
					if self.duckAmount <= 0 then
						self:FinishUnDuck()
					end
				end
			else
				-- something above us, stay down
				self.duckAmount = 1
			end
		elseif self.duckAmount > 0 then
			self.duckAmount = math.max(self.duckAmount - dt / TIME_TO_UNDUCK, 0)
		end
	end

	self.viewOffset = VEC_VIEW + (VEC_DUCK_VIEW - VEC_VIEW) * SimpleSpline(self.duckAmount)
end

function GameMovement:FinishDuck()
	if self.ducked then
		return
	end
	self.ducked = true
	self.duckAmount = 1

	if not self.onGround then
		self.origin += UP * DUCK_HULL_DELTA
	end

	self.stuckCooldown = 0
	self:CheckStuck()
	self:CategorizePosition()
end

function GameMovement:CanUnduck(): boolean
	local newOrigin = self.origin
	if not self.onGround then
		newOrigin -= UP * DUCK_HULL_DELTA
	end
	return self:TestHull(newOrigin, VEC_HULL_MIN, VEC_HULL_MAX)
end

function GameMovement:FinishUnDuck()
	if not self.ducked then
		return
	end

	if not self.onGround then
		self.origin -= UP * DUCK_HULL_DELTA
	end

	self.ducked = false
	self.duckAmount = 0
	self:CategorizePosition()
end

------------------------------------------------------------------------
-- Stuck
------------------------------------------------------------------------

function GameMovement:CheckStuck(): boolean
	if self.stuckCooldown > 0 then
		self.stuckCooldown -= self.frametime
		return true
	end

	local mins, maxs = self:GetHull()
	if self:TestHull(self.origin, mins, maxs) then
		return false
	end

	for _, offset in STUCK_OFFSETS do
		local test = self.origin + offset
		if self:TestHull(test, mins, maxs) then
			self.origin = test
			return false
		end
	end

	-- couldn't find a way out; let traces carry us (shapecasts ignore starting overlap)
	self.stuckCooldown = STUCK_RETRY_DELAY
	return true
end

------------------------------------------------------------------------
-- Water
------------------------------------------------------------------------

local terrain = Workspace.Terrain

-- point in Source units
function GameMovement:PointInWater(point: Vector3): boolean
	local p = point / ConVars.units_per_stud

	for part in waterParts do
		if part.Parent then
			local lp = part.CFrame:PointToObjectSpace(p)
			local h = part.Size / 2
			if math.abs(lp.X) <= h.X and math.abs(lp.Y) <= h.Y and math.abs(lp.Z) <= h.Z then
				return true
			end
		else
			waterParts[part] = nil
		end
	end

	-- terrain water: one 4x4x4 voxel, surface height from occupancy
	local vx, vy, vz = math.floor(p.X / 4) * 4, math.floor(p.Y / 4) * 4, math.floor(p.Z / 4) * 4
	local corner = Vector3.new(vx, vy, vz)
	local ok, materials, occupancies = pcall(function()
		return terrain:ReadVoxels(Region3.new(corner, corner + Vector3.new(4, 4, 4)), 4)
	end)
	if ok and materials and materials.Size.X >= 1 then
		if materials[1][1][1] == Enum.Material.Water then
			local surface = vy + occupancies[1][1][1] * 4
			return p.Y <= surface
		end
	end
	return false
end

function GameMovement:CheckWater(): boolean
	local mins, maxs = self:GetHull()
	local point = Vector3.new(
		self.origin.X + (mins.X + maxs.X) * 0.5,
		self.origin.Y + mins.Y + 1,
		self.origin.Z + (mins.Z + maxs.Z) * 0.5
	)

	local oldLevel = self.waterLevel
	self.waterLevel = WL_NotInWater

	if self:PointInWater(point) then
		self.waterLevel = WL_Feet

		-- Now check a point that is at the player hull midpoint.
		point = SetY(point, self.origin.Y + (mins.Y + maxs.Y) * 0.5)
		if self:PointInWater(point) then
			self.waterLevel = WL_Waist

			-- Now check the eye position.
			point = SetY(point, self.origin.Y + self.viewOffset)
			if self:PointInWater(point) then
				self.waterLevel = WL_Eyes
			end
		end
	end

	if oldLevel == WL_NotInWater and self.waterLevel ~= WL_NotInWater then
		self.waterEntryTime = os.clock()
	end

	return self.waterLevel > WL_Feet
end

function GameMovement:CheckWaterJump()
	-- Already water jumping.
	if self.waterJumpTime > 0 then
		return
	end

	-- Don't hop out if we just jumped in
	if self.velocity.Y < -180 then
		return
	end

	local forward = YawBasis(self.yaw)
	local flatVelocity = Flat(self.velocity)
	local curspeed = flatVelocity.Magnitude

	-- Are we backing into water from steps or something?  If so, don't pop forward
	if curspeed ~= 0 and flatVelocity:Dot(forward) < 0 then
		return
	end

	local mins, maxs = self:GetHull()
	local vecStart = self.origin + (mins + maxs) * 0.5
	local vecEnd = vecStart + forward * 24

	local trace = self:TraceHull(vecStart, vecEnd, mins, maxs)
	if trace.fraction < 1 and trace.normal then -- solid at waist
		vecStart = SetY(vecStart, self.origin.Y + self.viewOffset + WATERJUMP_HEIGHT)
		vecEnd = vecStart + forward * 24
		self.waterJumpVel = trace.normal * -50

		trace = self:TraceHull(vecStart, vecEnd, mins, maxs)
		if trace.fraction == 1 then -- open at eye level
			-- Now trace down to see if we would actually land on a standable surface.
			vecStart = vecEnd
			vecEnd = vecStart - UP * 1024
			trace = self:TraceHull(vecStart, vecEnd, mins, maxs)
			if trace.fraction < 1 and trace.normal and trace.normal.Y >= MIN_GROUND_NORMAL then
				self.velocity = SetY(self.velocity, 256) -- Push up
				self.oldJump = true -- Don't jump again until released
				self.waterJumpTime = 2 -- Do this for 2 seconds
			end
		end
	end
end

function GameMovement:WaterJump()
	if self.waterJumpTime > 10 then
		self.waterJumpTime = 10
	end

	if self.waterJumpTime <= 0 then
		return
	end

	self.waterJumpTime -= self.frametime
	if self.waterJumpTime <= 0 or self.waterLevel == WL_NotInWater then
		self.waterJumpTime = 0
	end

	self.velocity = Vector3.new(self.waterJumpVel.X, self.velocity.Y, self.waterJumpVel.Z)
end

function GameMovement:WaterMove()
	local forward = CFrame.fromOrientation(math.rad(self.pitch), math.rad(self.yaw), 0).LookVector
	local _, right = YawBasis(self.yaw)

	-- user intentions
	local wishvel = forward * self.fmove + right * self.smove

	if self.cmd.jump then
		-- if we have the jump key down, move us up as well
		wishvel += UP * self.maxspeed
	elseif self.fmove == 0 and self.smove == 0 and self.umove == 0 then
		-- Sinking after no other movement occurs
		wishvel -= UP * 60
	else
		-- Go straight up by upmove amount.
		wishvel += UP * self.umove
	end

	local wishspeed = wishvel.Magnitude
	local wishdir = if wishspeed > 0 then wishvel / wishspeed else ZERO

	-- Cap speed.
	if wishspeed > self.maxspeed then
		wishspeed = self.maxspeed
	end

	-- Slow us down a bit.
	wishspeed *= 0.8

	-- Water friction
	local speed = self.velocity.Magnitude
	local newspeed = 0
	if speed > 0 then
		newspeed = speed - self.frametime * speed * ConVars.sv_friction * self.surfaceFriction
		if newspeed < 0.1 then
			newspeed = 0
		end
		self.velocity *= newspeed / speed
	end

	-- water acceleration
	if wishspeed >= 0.1 then
		local addspeed = wishspeed - newspeed
		if addspeed > 0 then
			local accelspeed = ConVars.sv_accelerate * wishspeed * self.frametime * self.surfaceFriction
			if accelspeed > addspeed then
				accelspeed = addspeed
			end
			self.velocity += wishdir * accelspeed
		end
	end

	self.velocity += self.baseVelocity

	-- Now move
	local mins, maxs = self:GetHull()
	local dest = self.origin + self.velocity * self.frametime

	local trace = self:TraceHull(self.origin, dest, mins, maxs)
	if trace.fraction == 1 then
		-- Source traces down from a step height above dest. Shapecasts can't report
		-- startsolid, so find a safe start by tracing up from dest first.
		local up = self:TraceHull(dest, dest + UP * (ConVars.sv_stepsize + 1), mins, maxs)
		trace = self:TraceHull(up.endpos, dest, mins, maxs)
		-- walked up the step, so just keep result and exit
		self.origin = trace.endpos
		self.velocity -= self.baseVelocity
		return
	end

	if not self.onGround then
		self:TryPlayerMove()
		self.velocity -= self.baseVelocity
		return
	end

	self:StepMove()
	self.velocity -= self.baseVelocity
end

------------------------------------------------------------------------
-- Ladders
------------------------------------------------------------------------

function GameMovement:LadderMove(): boolean
	if self.noclip then
		return false
	end

	local wishdir
	if self.onLadder then
		-- If I'm already moving on a ladder, use the previous ladder direction
		wishdir = -self.ladderNormal
	else
		-- otherwise, use the direction player is attempting to move
		if self.fmove ~= 0 or self.smove ~= 0 then
			local forward = CFrame.fromOrientation(math.rad(self.pitch), math.rad(self.yaw), 0).LookVector
			local _, right = YawBasis(self.yaw)
			local dir = forward * self.fmove + right * self.smove
			if dir.Magnitude < 1e-6 then
				return false
			end
			wishdir = dir.Unit
		else
			-- Player is not attempting to move, no ladder behavior
			return false
		end
	end

	-- wishdir points toward the ladder if any exists
	local mins, maxs = self:GetHull()
	local trace = self:TraceHull(self.origin, self.origin + wishdir * LADDER_DISTANCE, mins, maxs)

	-- no ladder in that direction, return
	if trace.fraction == 1 or not trace.normal or not isLadderInstance(trace.instance) then
		return false
	end

	local normal = trace.normal :: Vector3
	self.onLadder = true
	self.ladderNormal = normal

	-- On ladder, convert movement to be relative to the ladder
	local floorTrace = self:TraceHull(self.origin, self.origin - UP * 1, mins, maxs)
	local onFloor = self.onGround or floorTrace.fraction < 1

	local forward = CFrame.fromOrientation(math.rad(self.pitch), math.rad(self.yaw), 0).LookVector
	local _, right = YawBasis(self.yaw)
	local climbSpeed = MAX_CLIMB_SPEED

	local forwardSpeed, rightSpeed = 0, 0
	if self.fmove < 0 then forwardSpeed -= climbSpeed end
	if self.fmove > 0 then forwardSpeed += climbSpeed end
	if self.smove < 0 then rightSpeed -= climbSpeed end
	if self.smove > 0 then rightSpeed += climbSpeed end

	if self.cmd.jump then
		self.onLadder = false
		self.velocity = normal * 270
	elseif forwardSpeed ~= 0 or rightSpeed ~= 0 then
		-- Calculate player's intended velocity
		local velocity = forward * forwardSpeed + right * rightSpeed

		-- Perpendicular in the ladder plane
		local perp = UP:Cross(normal)
		perp = if perp.Magnitude > 1e-6 then perp.Unit else Vector3.xAxis

		-- decompose velocity into ladder plane
		local intoFace = velocity:Dot(normal)

		-- This is the velocity into the face of the ladder
		local cross = normal * intoFace

		-- This is the player's additional velocity
		local lateral = velocity - cross

		-- This turns the velocity into the face of the ladder into velocity that
		-- is roughly vertically perpendicular to the face of the ladder.
		local tmp = normal:Cross(perp)
		self.velocity = lateral + tmp * -intoFace

		if onFloor and intoFace > 0 then -- On ground moving away from the ladder
			self.velocity += normal * MAX_CLIMB_SPEED
		end
	else
		self.velocity = ZERO
	end

	return true
end

function GameMovement:FullLadderMove()
	self:CheckWater()

	-- Was jump button pressed? If so, set velocity to 270 away from ladder.
	if self.cmd.jump then
		self:CheckJumpButton()
	else
		self.oldJump = false
	end

	-- Perform the move accounting for any base velocity.
	self.velocity += self.baseVelocity
	self:TryPlayerMove()
	self.velocity -= self.baseVelocity

	self:CategorizePosition()
end

------------------------------------------------------------------------
-- Noclip
------------------------------------------------------------------------

function GameMovement:FullNoClipMove()
	local factor = ConVars.sv_noclipspeed
	local maxacceleration = ConVars.sv_noclipaccelerate

	if self.cmd.sprint then
		factor /= 2
	end

	local forward = CFrame.fromOrientation(math.rad(self.pitch), math.rad(self.yaw), 0).LookVector
	local _, right = YawBasis(self.yaw)

	local wishvel = forward * (self.fmove * factor) + right * (self.smove * factor) + UP * (self.umove * factor)
	local wishspeed = wishvel.Magnitude
	local wishdir = if wishspeed > 0 then wishvel / wishspeed else ZERO
	local maxspeed = ConVars.sv_maxspeed * factor

	if wishspeed > maxspeed then
		wishvel *= maxspeed / wishspeed
		wishspeed = maxspeed
	end

	if maxacceleration > 0 then
		self:Accelerate(wishdir, wishspeed, maxacceleration)

		local spd = self.velocity.Magnitude
		if spd < 1 then
			self.velocity = ZERO
			return
		end

		-- Bleed off some speed, but if we have less than the bleed threshold, bleed the threshold amount.
		local control = if spd < maxspeed / 4 then maxspeed / 4 else spd
		local friction = ConVars.sv_friction * self.surfaceFriction
		local drop = control * friction * self.frametime
		local newspeed = math.max(spd - drop, 0)
		self.velocity *= newspeed / spd
	else
		self.velocity = wishvel
	end

	self.origin += self.velocity * self.frametime
end

return GameMovement
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000009">
						<Properties>
							<string name="Name">KeyValues</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[=[
	KeyValues (ModuleScript)
	ReplicatedStorage.BloxSDK.Shared.KeyValues

	Port of tier1 KeyValues (text format) - the format used by .vmt, .res, gameinfo.txt,
	game_sounds*.txt, soundscapes, VMF, etc.

	local kv = KeyValues.LoadFromString([[
		"Root"
		{
			"speed" "190"
			"Sub" { "a" "1" }
		}
	]])
	kv:GetName()                 -> "Root"
	kv:GetFloat("speed")         -> 190
	kv:FindKey("Sub"):GetInt("a")-> 1
	kv:FindKey("Sub/a")          -> nested path lookup
	for _, sub in kv:GetSubKeys() do ... end
	kv:ToString()

	Supports // comments, quoted and unquoted tokens, escape sequences (\n \t \\ \"),
	[$CONDITIONAL] tags (evaluated against KeyValues.Conditionals), #base / #include
	(resolved through an optional loader callback).
]=]

local KeyValues = {}
KeyValues.__index = KeyValues

-- conditionals considered true, e.g. [$WIN32] [!$X360]
KeyValues.Conditionals = {
	["$WIN32"] = true,
	["$WINDOWS"] = true,
	["$PC"] = true,
}

function KeyValues.new(name: string?)
	return setmetatable({
		name = name or "",
		value = nil :: string?,
		children = {},
	}, KeyValues)
end

------------------------------------------------------------------------
-- Accessors
------------------------------------------------------------------------

function KeyValues:GetName(): string
	return self.name
end

function KeyValues:SetName(name: string)
	self.name = name
end

function KeyValues:IsLeaf(): boolean
	return self.value ~= nil
end

function KeyValues:GetSubKeys(): { any }
	return self.children
end

function KeyValues:GetFirstSubKey()
	return self.children[1]
end

-- case-insensitive, supports "a/b/c" paths
function KeyValues:FindKey(path: string, create: boolean?)
	local node = self
	for part in path:gmatch("[^/]+") do
		local lower = string.lower(part)
		local found = nil
		for _, child in node.children do
			if string.lower(child.name) == lower then
				found = child
				break
			end
		end
		if not found then
			if not create then
				return nil
			end
			found = KeyValues.new(part)
			table.insert(node.children, found)
		end
		node = found
	end
	return node
end

function KeyValues:AddSubKey(kv)
	table.insert(self.children, kv)
	return kv
end

function KeyValues:RemoveSubKey(kv)
	local i = table.find(self.children, kv)
	if i then
		table.remove(self.children, i)
	end
end

function KeyValues:GetString(key: string?, default: string?): string
	local node = if key then self:FindKey(key) else self
	if node and node.value ~= nil then
		return node.value
	end
	return default or ""
end

function KeyValues:GetFloat(key: string?, default: number?): number
	local node = if key then self:FindKey(key) else self
	if node and node.value ~= nil then
		return tonumber(node.value) or 0
	end
	return default or 0
end

function KeyValues:GetInt(key: string?, default: number?): number
	return math.floor(self:GetFloat(key, default))
end

function KeyValues:GetBool(key: string?, default: boolean?): boolean
	local node = if key then self:FindKey(key) else self
	if node and node.value ~= nil then
		return (tonumber(node.value) or 0) ~= 0
	end
	return default or false
end

function KeyValues:IsEmpty(key: string?): boolean
	local node = if key then self:FindKey(key) else self
	return node == nil or (node.value == nil and #node.children == 0)
end

function KeyValues:SetString(key: string, value: string)
	local node = self:FindKey(key, true)
	node.value = tostring(value)
	table.clear(node.children)
end

function KeyValues:SetFloat(key: string, value: number)
	self:SetString(key, tostring(value))
end

function KeyValues:SetInt(key: string, value: number)
	self:SetString(key, tostring(math.floor(value)))
end

function KeyValues:SetBool(key: string, value: boolean)
	self:SetString(key, if value then "1" else "0")
end

function KeyValues:MakeCopy()
	local copy = KeyValues.new(self.name)
	copy.value = self.value
	for _, child in self.children do
		table.insert(copy.children, child:MakeCopy())
	end
	return copy
end

-- merges other into self (other wins), used by #base
function KeyValues:MergeFrom(other)
	for _, child in other.children do
		local mine = self:FindKey(child.name)
		if mine and not mine:IsLeaf() and not child:IsLeaf() then
			mine:MergeFrom(child)
		elseif mine then
			mine.value = child.value
			mine.children = child:MakeCopy().children
		else
			table.insert(self.children, child:MakeCopy())
		end
	end
end

-- flatten leaf values into a plain table (lowercase keys)
function KeyValues:ToTable(): { [string]: any }
	local out = {}
	for _, child in self.children do
		local key = string.lower(child.name)
		if child:IsLeaf() then
			out[key] = child.value
		else
			out[key] = child:ToTable()
		end
	end
	return out
end

------------------------------------------------------------------------
-- Tokenizer
------------------------------------------------------------------------

local ESCAPES = { n = "\n", t = "\t", v = "\v", b = "\b", r = "\r", f = "\f", a = "\a", ["\\"] = "\\", ["?"] = "?", ["'"] = "'", ['"'] = '"' }

local function tokenize(text: string): { { kind: string, value: string } }
	local tokens = {}
	local i, n = 1, #text

	while i <= n do
		local c = text:sub(i, i)

		if c:match("%s") then
			i += 1
		elseif c == "/" and text:sub(i + 1, i + 1) == "/" then
			local nl = text:find("\n", i, true)
			i = if nl then nl + 1 else n + 1
		elseif c == "{" or c == "}" then
			table.insert(tokens, { kind = c, value = c })
			i += 1
		elseif c == "[" then
			local close = text:find("]", i, true) or n
			table.insert(tokens, { kind = "conditional", value = text:sub(i + 1, close - 1) })
			i = close + 1
		elseif c == '"' then
			local buf = {}
			i += 1
			while i <= n do
				local ch = text:sub(i, i)
				if ch == "\\" and i < n then
					local nxt = text:sub(i + 1, i + 1)
					table.insert(buf, ESCAPES[nxt] or ("\\" .. nxt))
					i += 2
				elseif ch == '"' then
					i += 1
					break
				else
					table.insert(buf, ch)
					i += 1
				end
			end
			table.insert(tokens, { kind = "string", value = table.concat(buf) })
		else
			local token = text:match('^[^%s{}"%[%]]+', i) :: string
			-- unquoted tokens stop at a // comment
			local comment = token:find("//", 1, true)
			if comment then
				token = token:sub(1, comment - 1)
			end
			if token == "" then
				i += 1
			else
				table.insert(tokens, { kind = "string", value = token })
				i += #token
			end
		end
	end

	return tokens
end

local function evaluateConditional(cond: string): boolean
	-- supports !, ||, &&
	local function term(t: string): boolean
		t = t:gsub("^%s+", ""):gsub("%s+$", "")
		local negate = false
		if t:sub(1, 1) == "!" then
			negate = true
			t = t:sub(2)
		end
		local v = KeyValues.Conditionals[string.upper(t)] == true
		return if negate then not v else v
	end
	for orPart in (cond .. "||"):gmatch("(.-)||") do
		local all = true
		for andPart in (orPart .. "&&"):gmatch("(.-)&&") do
			if not term(andPart) then
				all = false
				break
			end
		end
		if all then
			return true
		end
	end
	return false
end

------------------------------------------------------------------------
-- Parser
------------------------------------------------------------------------

export type Loader = (path: string) -> string?

local function parseBlock(tokens, pos: number, node, loader: Loader?): number
	while pos <= #tokens do
		local tok = tokens[pos]

		if tok.kind == "}" then
			return pos + 1
		end

		if tok.kind ~= "string" then
			pos += 1
			continue
		end

		local key = tok.value
		pos += 1

		-- #base / #include
		if (key == "#base" or key == "#include") and tokens[pos] and tokens[pos].kind == "string" then
			local path = tokens[pos].value
			pos += 1
			if loader then
				local text = loader(path)
				if text then
					local included = KeyValues.LoadFromString(text, loader)
					if included then
						if key == "#base" then
							node:MergeFrom(included)
						else
							table.insert(node.children, included)
						end
					end
				end
			end
			continue
		end

		local nextTok = tokens[pos]
		if not nextTok then
			break
		end

		if nextTok.kind == "{" then
			local child = KeyValues.new(key)
			pos = parseBlock(tokens, pos + 1, child, loader)
			local include = true
			if tokens[pos] and tokens[pos].kind == "conditional" then
				include = evaluateConditional(tokens[pos].value)
				pos += 1
			end
			if include then
				table.insert(node.children, child)
			end
		elseif nextTok.kind == "string" then
			pos += 1
			local include = true
			if tokens[pos] and tokens[pos].kind == "conditional" then
				include = evaluateConditional(tokens[pos].value)
				pos += 1
			end
			if include then
				local child = KeyValues.new(key)
				child.value = nextTok.value
				table.insert(node.children, child)
			end
		else
			pos += 1
		end
	end
	return pos
end

-- Returns the first root key (like KeyValues::LoadFromBuffer). Use LoadAllFromString for multi-root files.
function KeyValues.LoadFromString(text: string, loader: Loader?)
	local roots = KeyValues.LoadAllFromString(text, loader)
	return roots[1]
end

function KeyValues.LoadAllFromString(text: string, loader: Loader?): { any }
	local tokens = tokenize(text)
	local container = KeyValues.new("")
	parseBlock(tokens, 1, container, loader)
	return container.children
end

------------------------------------------------------------------------
-- Writer
------------------------------------------------------------------------

local function escape(s: string): string
	return (s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\t", "\\t"))
end

function KeyValues:ToString(indent: number?): string
	indent = indent or 0
	local pad = string.rep("\t", indent :: number)
	local out = {}
	if self.value ~= nil then
		table.insert(out, string.format('%s"%s"\t\t"%s"', pad, escape(self.name), escape(self.value)))
	else
		table.insert(out, string.format('%s"%s"', pad, escape(self.name)))
		table.insert(out, pad .. "{")
		for _, child in self.children do
			table.insert(out, child:ToString((indent :: number) + 1))
		end
		table.insert(out, pad .. "}")
	end
	return table.concat(out, "\n")
end

return KeyValues
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000000A">
						<Properties>
							<string name="Name">MathLib</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	MathLib (ModuleScript)
	ReplicatedStorage.BloxSDK.Shared.MathLib

	Bits of Source's mathlib + the Source <-> Roblox conversions.

	Source axes:  X forward, Y left, Z up (right-handed)
	Roblox axes:  X right,   Y up,   Z back (right-handed)
	Mapping used everywhere in BloxSDK:  Roblox(x, y, z) = Source(x, z, -y)
]]

local MathLib = {}

local movementConVars = nil

function MathLib.UnitsPerStud(): number
	if not movementConVars then
		local ok, GameMovement = pcall(require, script.Parent:WaitForChild("GameMovement") :: any)
		if ok and GameMovement and GameMovement.ConVars then
			movementConVars = GameMovement.ConVars
		else
			return 14
		end
	end
	return movementConVars.units_per_stud
end

function MathLib.UnitsToStuds(units: number): number
	return units / MathLib.UnitsPerStud()
end

function MathLib.StudsToUnits(studs: number): number
	return studs * MathLib.UnitsPerStud()
end

-- Source vector (x, y, z) -> Roblox axes (same scale)
function MathLib.SourceToRoblox(v: Vector3): Vector3
	return Vector3.new(v.X, v.Z, -v.Y)
end

function MathLib.RobloxToSource(v: Vector3): Vector3
	return Vector3.new(v.X, -v.Z, v.Y)
end

-- AngleVectors( QAngle(pitch, yaw, roll) ) returned in Roblox axes
function MathLib.AngleVectors(pitch: number, yaw: number, roll: number?): (Vector3, Vector3, Vector3)
	local sp, cp = math.sin(math.rad(pitch)), math.cos(math.rad(pitch))
	local sy, cy = math.sin(math.rad(yaw)), math.cos(math.rad(yaw))
	local sr, cr = math.sin(math.rad(roll or 0)), math.cos(math.rad(roll or 0))

	local forward = Vector3.new(cp * cy, cp * sy, -sp)
	local right = Vector3.new(-1 * sr * sp * cy + -1 * cr * -sy, -1 * sr * sp * sy + -1 * cr * cy, -1 * sr * cp)
	local up = Vector3.new(cr * sp * cy + -sr * -sy, cr * sp * sy + -sr * cy, cr * cp)

	return MathLib.SourceToRoblox(forward), MathLib.SourceToRoblox(right), MathLib.SourceToRoblox(up)
end

-- parse "x y z" / "p y r" strings
function MathLib.ParseVector(s: any): Vector3?
	if typeof(s) == "Vector3" then
		return s
	end
	if type(s) ~= "string" then
		return nil
	end
	local x, y, z = s:match("^%s*(%S+)%s+(%S+)%s+(%S+)")
	x, y, z = tonumber(x), tonumber(y), tonumber(z)
	if x and y and z then
		return Vector3.new(x, y, z)
	end
	return nil
end

-- CBaseEntity::SetMovedir: Hammer stores "Up" as 0 -1 0 and "Down" as 0 -2 0.
-- Accepts a Roblox-space Vector3 attribute or a Source "pitch yaw roll" string.
function MathLib.Movedir(value: any): Vector3
	if typeof(value) == "Vector3" then
		return if value.Magnitude > 0 then value.Unit else Vector3.xAxis
	end
	local angles = MathLib.ParseVector(value) or Vector3.zero
	if angles == Vector3.new(0, -1, 0) then
		return Vector3.yAxis
	elseif angles == Vector3.new(0, -2, 0) then
		return -Vector3.yAxis
	end
	local forward = MathLib.AngleVectors(angles.X, angles.Y, angles.Z)
	return forward
end

-- Source angles from a CFrame (pitch, yaw, roll in degrees, Source conventions)
function MathLib.CFrameToSourceAngles(cf: CFrame): (number, number, number)
	local look = MathLib.RobloxToSource(cf.LookVector)
	local yaw = math.deg(math.atan2(look.Y, look.X))
	local pitch = math.deg(math.atan2(-look.Z, math.sqrt(look.X * look.X + look.Y * look.Y)))
	return pitch, yaw, 0
end

-- Roblox camera/view yaw (degrees about +Y, 0 = -Z) from a Source yaw
function MathLib.SourceYawToRoblox(yaw: number): number
	return yaw - 90
end

function MathLib.RobloxYawToSource(yaw: number): number
	return yaw + 90
end

function MathLib.SimpleSpline(v: number): number
	return 3 * v * v - 2 * v * v * v
end

function MathLib.Approach(target: number, value: number, speed: number): number
	local delta = target - value
	if delta > speed then
		return value + speed
	elseif delta < -speed then
		return value - speed
	end
	return target
end

function MathLib.AngleNormalize(angle: number): number
	angle %= 360
	if angle > 180 then
		angle -= 360
	end
	return angle
end

function MathLib.RemapVal(val: number, a: number, b: number, c: number, d: number): number
	if a == b then
		return if val >= b then d else c
	end
	return c + (d - c) * (val - a) / (b - a)
end

function MathLib.RemapValClamped(val: number, a: number, b: number, c: number, d: number): number
	if a == b then
		return if val >= b then d else c
	end
	local t = math.clamp((val - a) / (b - a), 0, 1)
	return c + (d - c) * t
end

------------------------------------------------------------------------
-- Box overlap (separating axis test), used for triggers / touch
------------------------------------------------------------------------

local function axesOf(cf: CFrame): { Vector3 }
	return { cf.RightVector, cf.UpVector, -cf.LookVector }
end

-- OBB vs OBB. halfA/halfB are half sizes in each box's local axes.
function MathLib.BoxesOverlap(cfA: CFrame, halfA: Vector3, cfB: CFrame, halfB: Vector3): boolean
	local A = axesOf(cfA)
	local B = axesOf(cfB)
	local ha = { halfA.X, halfA.Y, halfA.Z }
	local hb = { halfB.X, halfB.Y, halfB.Z }
	local T = cfB.Position - cfA.Position

	local function separated(L: Vector3): boolean
		if L:Dot(L) < 1e-10 then
			return false
		end
		local ra = math.abs(A[1]:Dot(L)) * ha[1] + math.abs(A[2]:Dot(L)) * ha[2] + math.abs(A[3]:Dot(L)) * ha[3]
		local rb = math.abs(B[1]:Dot(L)) * hb[1] + math.abs(B[2]:Dot(L)) * hb[2] + math.abs(B[3]:Dot(L)) * hb[3]
		return math.abs(T:Dot(L)) > ra + rb
	end

	for i = 1, 3 do
		if separated(A[i]) or separated(B[i]) then
			return false
		end
	end
	for i = 1, 3 do
		for j = 1, 3 do
			if separated(A[i]:Cross(B[j])) then
				return false
			end
		end
	end
	return true
end

-- axis-aligned box (centre, half size) vs part
function MathLib.BoxOverlapsPart(center: Vector3, half: Vector3, part: BasePart): boolean
	return MathLib.BoxesOverlap(CFrame.new(center), half, part.CFrame, part.Size / 2)
end

function MathLib.PointInPart(point: Vector3, part: BasePart): boolean
	local lp = part.CFrame:PointToObjectSpace(point)
	local h = part.Size / 2
	return math.abs(lp.X) <= h.X and math.abs(lp.Y) <= h.Y and math.abs(lp.Z) <= h.Z
end

return MathLib
]]></ProtectedString>
