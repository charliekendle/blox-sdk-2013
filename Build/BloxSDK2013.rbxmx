		<Item class="Folder" referent="RBX0000000C">
			<Properties>
				<string name="Name">ServerScriptService</string>
			</Properties>
			<Item class="Folder" referent="RBX0000000D">
				<Properties>
					<string name="Name">BloxSDKServer</string>
				</Properties>
				<Item class="Folder" referent="RBX0000000E">
					<Properties>
						<string name="Name">Game</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX0000000F">
						<Properties>
							<string name="Name">BaseEntity</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	BaseEntity (ModuleScript) - port of CBaseEntity's I/O, keyvalue, think and lifecycle parts.

	Entities in Studio: any Part or Model with an Attribute  classname = "logic_relay" (etc).
	Every other Attribute is a keyvalue:  targetname, spawnflags, wait, speed, ...
	Outputs are Attributes named after the output, value "target,input,param,delay,times":
	    OnTrigger      = "door1,Open,,0,-1"
	    OnTrigger_2    = "relay2,Trigger"          (attribute names must be unique, so suffix _N)
	    or several in one attribute separated by "|"
	A Model entity = brush entity made of all its parts. A Part entity = brush made of that part,
	or a point entity (its position/rotation is the entity origin/angles).

	Subclassing:
	    local MyEnt = BaseEntity.extend("my_ent")      -- also registers the classname
	    MyEnt:DeclareOutputs({ "OnFoo" })
	    MyEnt.Inputs.dofoo = function(self, data) self:FireOutput("OnFoo", data.activator) end
	    function MyEnt:Spawn() MyEnt.super.Spawn(self) ... end
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared")
local Cvar = require(Shared:WaitForChild("ConVar"))
local MathLib = require(Shared:WaitForChild("MathLib"))
local EntityList = require(script.Parent:WaitForChild("EntityList"))
local EntityIO = require(script.Parent:WaitForChild("EntityIO"))
local Variant = require(script.Parent:WaitForChild("Variant"))

local BaseEntity = {}
BaseEntity.__index = BaseEntity
BaseEntity.ClassName = "baseentity"
BaseEntity.Inputs = {}
BaseEntity.OutputNames = { "OnUser1", "OnUser2", "OnUser3", "OnUser4", "OnKilled" }

-- keys never treated as keyvalues
local IGNORED_ATTRIBUTES = { classname = true }

------------------------------------------------------------------------
-- Class plumbing
------------------------------------------------------------------------

function BaseEntity.extend(base: any, classname: string?)
	if type(base) == "string" then
		-- BaseEntity.extend("classname") shorthand
		classname = base
		base = BaseEntity
	end

	local class = setmetatable({}, { __index = base })
	class.__index = class
	class.super = base
	class.Inputs = setmetatable({}, { __index = base.Inputs })
	class.OutputNames = table.clone(base.OutputNames)

	function class.new(instance: Instance?)
		local self = setmetatable({}, class)
		self:Init(instance)
		return self
	end

	if classname then
		EntityList.LinkEntityToClass(classname, class)
	end
	return class
end

function BaseEntity:DeclareOutputs(names: { string })
	for _, name in names do
		if not table.find(self.OutputNames, name) then
			table.insert(self.OutputNames, name)
		end
	end
end

function BaseEntity.new(instance: Instance?)
	local self = setmetatable({}, BaseEntity)
	self:Init(instance)
	return self
end

function BaseEntity:Init(instance: Instance?)
	self.instance = instance
	self.classname = self.ClassName
	self.targetname = ""
	self.parentname = ""
	self.spawnflags = 0
	self.keyvalues = {}
	self.outputs = {}
	self.removed = false
	self.thinkFn = nil
	self.nextThink = nil
	self.children = {}
	self.moveParent = nil
	self.parentOffset = nil
	self.health = 0
	self.maxHealth = 0
	self.disabled = false
	self.parts = nil
	self.connections = {}

	for _, name in self.OutputNames do
		self.outputs[string.lower(name)] = EntityIO.NewOutput(name)
	end
end

------------------------------------------------------------------------
-- Keyvalues
------------------------------------------------------------------------

local function findOutputName(self, key: string): string?
	local lower = string.lower(key)
	if self.outputs[lower] then
		return lower
	end
	-- OnTrigger_2 / OnTrigger2 -> OnTrigger
	local stripped = lower:gsub("_?%d+$", "")
	if stripped ~= lower and self.outputs[stripped] then
		return stripped
	end
	return nil
end

-- returns true if handled
function BaseEntity:KeyValue(key: string, value: any): boolean
	local lower = string.lower(key)
	self.keyvalues[lower] = value

	if lower == "targetname" then
		self.targetname = tostring(value)
		return true
	elseif lower == "spawnflags" then
		self.spawnflags = tonumber(value) or 0
		return true
	elseif lower == "parentname" then
		self.parentname = tostring(value)
		return true
	elseif lower == "health" then
		self.health = tonumber(value) or 0
		self.maxHealth = self.health
		return true
	elseif lower == "startdisabled" then
		self.disabled = value == true or tonumber(value) == 1
		return true
	end

	local outputName = findOutputName(self, key)
	if outputName and type(value) == "string" then
		for connection in (value .. "|"):gmatch("(.-)[|\n]") do
			if connection:match("%S") then
				self.outputs[outputName]:ParseAndAdd(connection)
			end
		end
		return true
	end

	return false
end

function BaseEntity:ReadAttributes()
	local inst = self.instance
	if not inst then
		return
	end
	for key, value in inst:GetAttributes() do
		if not IGNORED_ATTRIBUTES[string.lower(key)] then
			self:KeyValue(key, value)
		end
	end
end

function BaseEntity:GetKey(key: string): any
	return self.keyvalues[string.lower(key)]
end

function BaseEntity:GetKeyString(key: string, default: string?): string
	local v = self.keyvalues[string.lower(key)]
	if v == nil then
		return default or ""
	end
	return tostring(v)
end

function BaseEntity:GetKeyFloat(key: string, default: number?): number
	local v = self.keyvalues[string.lower(key)]
	if type(v) == "boolean" then
		return if v then 1 else 0
	end
	return tonumber(v) or default or 0
end

function BaseEntity:GetKeyInt(key: string, default: number?): number
	return math.floor(self:GetKeyFloat(key, default))
end

function BaseEntity:GetKeyBool(key: string, default: boolean?): boolean
	local v = self.keyvalues[string.lower(key)]
	if v == nil then
		return default or false
	end
	if type(v) == "boolean" then
		return v
	end
	return (tonumber(v) or 0) ~= 0
end

function BaseEntity:HasSpawnFlags(flags: number): boolean
	return bit32.band(self.spawnflags, flags) ~= 0
end

function BaseEntity:AddSpawnFlags(flags: number)
	self.spawnflags = bit32.bor(self.spawnflags, flags)
end

function BaseEntity:RemoveSpawnFlags(flags: number)
	self.spawnflags = bit32.band(self.spawnflags, bit32.bnot(flags))
end

------------------------------------------------------------------------
-- Lifecycle
------------------------------------------------------------------------

function BaseEntity:Precache() end

-- after keyvalues, before Activate
function BaseEntity:Spawn() end

-- after every entity has spawned
function BaseEntity:Activate()
	if self.parentname ~= "" then
		local parent = EntityList.FindEntityByName(self.parentname, self)
		if parent then
			self:SetParent(parent)
		else
			Cvar.Warning(string.format("%s(%s) couldn't find parent %s", self.classname, self.targetname, self.parentname))
		end
	end
end

function BaseEntity:IsUsable(): boolean
	return false
end

function BaseEntity:Use(activator: any?, caller: any?, useType: number?, value: number?) end

function BaseEntity:IsPlayer(): boolean
	return false
end

function BaseEntity:IsTrigger(): boolean
	return false
end

-- UTIL_Remove
function BaseEntity:Remove()
	if self.removed then
		return
	end
	self.removed = true
	self.thinkFn = nil
	self.nextThink = nil

	if self.moveParent then
		local siblings = self.moveParent.children
		local i = table.find(siblings, self)
		if i then
			table.remove(siblings, i)
		end
		self.moveParent = nil
	end

	for _, c in self.connections do
		c:Disconnect()
	end
	table.clear(self.connections)

	self:OnRemove()
	EntityList.Remove(self)

	if self.instance and self.destroyInstance ~= false then
		self.instance:Destroy()
	end
end

function BaseEntity:OnRemove() end

------------------------------------------------------------------------
-- Think
------------------------------------------------------------------------

function BaseEntity:SetThink(fn: ((any) -> ())?, delay: number?)
	self.thinkFn = fn
	if fn then
		self.nextThink = EntityIO.CurTime() + (delay or 0)
	else
		self.nextThink = nil
	end
end

function BaseEntity:SetNextThink(time: number?)
	self.nextThink = time
end

function BaseEntity:GetNextThink(): number?
	return self.nextThink
end

function BaseEntity:RunThink(now: number)
	local fn = self.thinkFn
	if fn and self.nextThink and self.nextThink <= now then
		self.nextThink = nil
		fn(self)
	end
end

------------------------------------------------------------------------
-- I/O
------------------------------------------------------------------------

function BaseEntity:GetOutput(name: string)
	return self.outputs[string.lower(name)]
end

function BaseEntity:FireOutput(name: string, activator: any?, value: any?, delay: number?)
	local output = self.outputs[string.lower(name)]
	if output then
		output:FireOutput(value, activator, self, delay)
	end
end

-- CBaseEntity::AcceptInput
function BaseEntity:AcceptInput(inputName: string, activator: any?, caller: any?, value: any?, outputId: number?): boolean
	if self.removed then
		return false
	end
	local handler = self.Inputs[string.lower(inputName)]
	if not handler then
		Cvar.DevMsg(2, string.format("Unhandled input: (%s) -> (%s,%s)", inputName, self.classname, self.targetname))
		return false
	end
	local variant = if type(value) == "table" and getmetatable(value) == Variant then value else Variant.new(value)
	local ok, err = pcall(handler, self, {
		activator = activator,
		caller = caller,
		value = variant,
		outputId = outputId or 0,
	})
	if not ok then
		Cvar.Warning(string.format("%s(%s).%s error: %s", self.classname, self.targetname, inputName, tostring(err)))
	end
	return true
end

-- Inputs available on every entity
BaseEntity.Inputs.kill = function(self)
	self:Remove()
end

BaseEntity.Inputs.killhierarchy = function(self)
	for _, child in table.clone(self.children) do
		child:AcceptInput("KillHierarchy", nil, self)
	end
	self:Remove()
end

for i = 1, 4 do
	BaseEntity.Inputs["fireuser" .. i] = function(self, data)
		self:FireOutput("OnUser" .. i, data.activator, data.value)
	end
end

BaseEntity.Inputs.use = function(self, data)
	self:Use(data.activator, data.caller, 0, 0)
end

-- AddOutput "keyname value" or "OnX target:input:param:delay:times"
BaseEntity.Inputs.addoutput = function(self, data)
	local text = data.value:String()
	local key, rest = text:match("^%s*(%S+)%s+(.*)$")
	if not key then
		return
	end
	if findOutputName(self, key) then
		rest = rest:gsub(":", ",")
	end
	self:KeyValue(key, rest)
	self:OnKeyValueChanged(string.lower(key))
end

BaseEntity.Inputs.setparent = function(self, data)
	local parent = EntityList.FindEntityByName(data.value:String(), self, data.activator, data.caller)
	if parent then
		self:SetParent(parent)
	end
end

BaseEntity.Inputs.clearparent = function(self)
	self:SetParent(nil)
end

BaseEntity.Inputs.color = function(self, data)
	local color = data.value:Color3()
	for _, part in self:GetParts() do
		part.Color = color
	end
end

BaseEntity.Inputs.alpha = function(self, data)
	local alpha = math.clamp(data.value:Float(), 0, 255)
	for _, part in self:GetParts() do
		part.Transparency = 1 - alpha / 255
	end
end

function BaseEntity:OnKeyValueChanged(key: string) end

------------------------------------------------------------------------
-- Geometry
------------------------------------------------------------------------

function BaseEntity:GetParts(): { BasePart }
	if self.parts then
		return self.parts
	end
	local parts = {}
	local inst = self.instance
	if inst then
		if inst:IsA("BasePart") then
			table.insert(parts, inst)
		end
		for _, d in inst:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
	end
	self.parts = parts
	return parts
end

function BaseEntity:IsBrush(): boolean
	return #self:GetParts() > 0
end

function BaseEntity:GetPivot(): CFrame
	local inst = self.instance
	if inst and (inst:IsA("PVInstance")) then
		return (inst :: any):GetPivot()
	end
	return self.virtualPivot or CFrame.identity
end

-- moves the entity and anything parented to it
function BaseEntity:SetPivot(cf: CFrame)
	local inst = self.instance
	if inst and inst:IsA("PVInstance") then
		(inst :: any):PivotTo(cf)
	else
		self.virtualPivot = cf
	end
	for _, child in self.children do
		if child.parentOffset then
			child:SetPivot(cf * child.parentOffset)
		end
	end
end

function BaseEntity:SetParent(parent: any?)
	if self.moveParent then
		local siblings = self.moveParent.children
		local i = table.find(siblings, self)
		if i then
			table.remove(siblings, i)
		end
	end
	self.moveParent = parent
	if parent then
		table.insert(parent.children, self)
		self.parentOffset = parent:GetPivot():ToObjectSpace(self:GetPivot())
	else
		self.parentOffset = nil
	end
end

-- origin in Source units (Roblox axes), the same space GameMovement uses
function BaseEntity:GetAbsOrigin(): Vector3
	return self:GetPivot().Position * MathLib.UnitsPerStud()
end

function BaseEntity:WorldSpaceCenter(): Vector3
	local inst = self.instance
	if inst and inst:IsA("Model") then
		local cf = inst:GetBoundingBox()
		return cf.Position * MathLib.UnitsPerStud()
	end
	return self:GetAbsOrigin()
end

-- yaw in Roblox convention (degrees about +Y, 0 = facing -Z)
function BaseEntity:GetYaw(): number
	local _, ry = self:GetPivot():ToOrientation()
	return math.deg(ry)
end

-- size projected onto a direction (studs), for door/button travel distances
function BaseEntity:ExtentAlong(dir: Vector3): number
	local inst = self.instance
	local cf, size
	if inst and inst:IsA("Model") then
		cf, size = inst:GetBoundingBox()
	elseif inst and inst:IsA("BasePart") then
		cf, size = inst.CFrame, inst.Size
	else
		return 0
	end
	return math.abs(dir:Dot(cf.RightVector)) * size.X
		+ math.abs(dir:Dot(cf.UpVector)) * size.Y
		+ math.abs(dir:Dot(cf.LookVector)) * size.Z
end

-- box (studs) vs our parts
function BaseEntity:Overlaps(center: Vector3, half: Vector3): boolean
	for _, part in self:GetParts() do
		if part.Parent and MathLib.BoxOverlapsPart(center, half, part) then
			return true
		end
	end
	return false
end

-- touch callbacks (TouchSystem); entities register with TouchSystem.Register to get them
function BaseEntity:StartTouch(other: any) end
function BaseEntity:Touch(other: any) end
function BaseEntity:EndTouch(other: any) end

-- tools/toolstrigger: invisible, non-solid, not hit by use traces
function BaseEntity:HideBrush()
	for _, part in self:GetParts() do
		part.Transparency = 1
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Anchored = true
	end
end

function BaseEntity:SetSolid(solid: boolean)
	for _, part in self:GetParts() do
		part.CanCollide = solid
		part.CanQuery = solid
	end
end

function BaseEntity:SetVisible(visible: boolean)
	for _, part in self:GetParts() do
		local original = part:GetAttribute("BSDK_Transparency")
		if original == nil then
			original = part.Transparency
			part:SetAttribute("BSDK_Transparency", original)
		end
		part.Transparency = if visible then original else 1
	end
end

------------------------------------------------------------------------
-- Sound (EmitSound for rbxassetid sounds; Source soundscript names are ignored)
------------------------------------------------------------------------

function BaseEntity.ResolveSoundId(sound: any): string?
	if sound == nil then
		return nil
	end
	local s = tostring(sound)
	if s == "" then
		return nil
	end
	if s:match("^rbxassetid://") or s:match("^rbxasset://") then
		return s
	end
	if s:match("^%d+$") then
		return "rbxassetid://" .. s
	end
	return nil
end

function BaseEntity:EmitSound(sound: any, volume: number?): Sound?
	local id = BaseEntity.ResolveSoundId(sound)
	if not id then
		return nil
	end
	local parent = self:GetParts()[1] or workspace
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.RollOffMaxDistance = 200
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 30)
	return s
end

------------------------------------------------------------------------
-- Damage (CTakeDamageInfo-lite)
------------------------------------------------------------------------

BaseEntity.DMG_GENERIC = 0
BaseEntity.DMG_CRUSH = 1
BaseEntity.DMG_BULLET = 2
BaseEntity.DMG_SLASH = 4
BaseEntity.DMG_BURN = 8
BaseEntity.DMG_VEHICLE = 16
BaseEntity.DMG_FALL = 32
BaseEntity.DMG_BLAST = 64
BaseEntity.DMG_CLUB = 128
BaseEntity.DMG_SHOCK = 256
BaseEntity.DMG_SONIC = 512
BaseEntity.DMG_ENERGYBEAM = 1024
BaseEntity.DMG_DROWN = 16384
BaseEntity.DMG_POISON = 131072
BaseEntity.DMG_RADIATION = 262144

export type TakeDamageInfo = {
	damage: number,
	damageType: number,
	attacker: any?,
	inflictor: any?,
}

function BaseEntity:TakeDamage(info: TakeDamageInfo)
	if self.removed or self.maxHealth <= 0 then
		return
	end
	self.health -= info.damage
	if self.health <= 0 then
		self:FireOutput("OnKilled", info.attacker)
		self:Remove()
	end
end

return BaseEntity
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000010">
						<Properties>
							<string name="Name">BaseToggle</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	BaseToggle (ModuleScript) - port of CBaseToggle (game/server/subs.cpp):
	LinearMove / AngularMove with move-done callbacks, used by doors, buttons, movelinear.

	Moving brushes are anchored and moved with PivotTo, so the client's platform carry
	(GameMovement:UpdateGroundCarry) rides them. If a move would overlap a player the
	entity's Blocked() is called and the move pauses that frame.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MathLib = require(ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared"):WaitForChild("MathLib"))

local Game = script.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local EntityIO = require(Game:WaitForChild("EntityIO"))

local BaseToggle = BaseEntity.extend(BaseEntity)
BaseToggle.ClassName = "basetoggle"

BaseToggle.TS_AT_TOP = 0
BaseToggle.TS_AT_BOTTOM = 1
BaseToggle.TS_GOING_UP = 2
BaseToggle.TS_GOING_DOWN = 3

-- entity -> true while moving; serviced by Main every Heartbeat
BaseToggle.Movers = {} :: { [any]: boolean }

-- set by Main: () -> { playerEntity }
BaseToggle.GetLivingPlayers = function(): { any }
	return {}
end

function BaseToggle:Init(instance)
	BaseToggle.super.Init(self, instance)
	self.toggleState = BaseToggle.TS_AT_BOTTOM
	self.move = nil
	self.blockedSince = nil
end

function BaseToggle:AnchorParts()
	for _, part in self:GetParts() do
		part.Anchored = true
	end
end

-- speed in Source units/sec
function BaseToggle:LinearMove(dest: CFrame, speed: number, onDone: ((any) -> ())?)
	local from = self:GetPivot()
	local distUnits = (dest.Position - from.Position).Magnitude * MathLib.UnitsPerStud()
	if distUnits < 0.01 or speed <= 0 then
		self:SetPivot(dest)
		self.move = nil
		BaseToggle.Movers[self] = nil
		if onDone then
			onDone(self)
		end
		return
	end
	self.move = {
		from = from,
		to = dest,
		elapsed = 0,
		duration = distUnits / speed,
		done = onDone,
	}
	BaseToggle.Movers[self] = true
end

-- speed in degrees/sec; dest must be < 180 degrees from the current rotation
function BaseToggle:AngularMove(dest: CFrame, speed: number, onDone: ((any) -> ())?)
	local from = self:GetPivot()
	local _, angle = (from:ToObjectSpace(dest)):ToAxisAngle()
	local degrees = math.deg(math.abs(angle))
	if degrees < 0.01 or speed <= 0 then
		self:SetPivot(dest)
		self.move = nil
		BaseToggle.Movers[self] = nil
		if onDone then
			onDone(self)
		end
		return
	end
	self.move = {
		from = from,
		to = dest,
		elapsed = 0,
		duration = degrees / speed,
		done = onDone,
	}
	BaseToggle.Movers[self] = true
end

function BaseToggle:StopMoving()
	self.move = nil
	BaseToggle.Movers[self] = nil
end

function BaseToggle:IsMoving(): boolean
	return self.move ~= nil
end

-- override: called while a move is blocked by a player. Return true to keep pushing.
function BaseToggle:Blocked(other: any): boolean
	return false
end

-- would our parts at pivot `cf` overlap this player?
function BaseToggle:WouldOverlap(cf: CFrame, playerEnt: any): boolean
	local current = self:GetPivot()
	local center, half = playerEnt:GetHullBox(-1)
	for _, part in self:GetParts() do
		if part.CanCollide then
			local partCF = cf * current:ToObjectSpace(part.CFrame)
			if MathLib.BoxesOverlap(CFrame.new(center), half, partCF, part.Size / 2) then
				return true
			end
		end
	end
	return false
end

function BaseToggle:StepMove(dt: number)
	local move = self.move
	if not move then
		BaseToggle.Movers[self] = nil
		return
	end

	local t = math.clamp((move.elapsed + dt) / move.duration, 0, 1)
	local cf = move.from:Lerp(move.to, t)

	-- blocking
	for _, playerEnt in BaseToggle.GetLivingPlayers() do
		if self:WouldOverlap(cf, playerEnt) then
			local keepPushing = self:Blocked(playerEnt)
			if self.move ~= move then
				return -- Blocked() started a different move (e.g. reversed)
			end
			if not keepPushing then
				return -- pause this frame
			end
		end
	end

	move.elapsed += dt
	self:SetPivot(cf)

	if t >= 1 then
		self.move = nil
		BaseToggle.Movers[self] = nil
		if move.done then
			move.done(self)
		end
	end
end

function BaseToggle.ServiceMovers(dt: number)
	for ent in table.clone(BaseToggle.Movers) do
		if ent.removed then
			BaseToggle.Movers[ent] = nil
		else
			ent:StepMove(dt)
		end
	end
end

-- helpers for the travel distance of doors/buttons (Source: |movedir . (size - 2)| - lip)
function BaseToggle:TravelDistanceStuds(dir: Vector3, lipUnits: number): number
	local ups = MathLib.UnitsPerStud()
	local extent = self:ExtentAlong(dir)
	local inset = 2 * (math.abs(dir.X) + math.abs(dir.Y) + math.abs(dir.Z)) / ups
	return math.max(extent - inset - lipUnits / ups, 0)
end

BaseToggle.CurTime = EntityIO.CurTime

return BaseToggle
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000011">
						<Properties>
							<string name="Name">BaseTrigger</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	BaseTrigger (ModuleScript) - port of CBaseTrigger (game/server/triggers.cpp)
	Brush volume that tracks touching players and fires OnStartTouch / OnEndTouch etc.

	spawnflags:  1 = Clients (players)   (only players are tracked in BloxSDK for now)
	keyvalues:   StartDisabled, filtername
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MathLib = require(ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared"):WaitForChild("MathLib"))

local Game = script.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local EntityList = require(Game:WaitForChild("EntityList"))
local TouchSystem = require(Game:WaitForChild("TouchSystem"))

local BaseTrigger = BaseEntity.extend(BaseEntity)
BaseTrigger.ClassName = "basetrigger"
BaseTrigger:DeclareOutputs({ "OnStartTouch", "OnStartTouchAll", "OnEndTouch", "OnEndTouchAll", "OnTouching", "OnNotTouching" })

BaseTrigger.SF_TRIGGER_ALLOW_CLIENTS = 1
BaseTrigger.SF_TRIGGER_ALLOW_NPCS = 2
BaseTrigger.SF_TRIGGER_ALLOW_PUSHABLES = 4
BaseTrigger.SF_TRIGGER_ALLOW_PHYSICS = 8
BaseTrigger.SF_TRIGGER_ONLY_PLAYER_ALLY_NPCS = 16
BaseTrigger.SF_TRIGGER_ONLY_CLIENTS_IN_VEHICLES = 32
BaseTrigger.SF_TRIGGER_ALLOW_ALL = 64

-- all live triggers, serviced by TouchSystem
BaseTrigger.ActiveTriggers = {} :: { [any]: boolean }

function BaseTrigger:Init(instance)
	BaseTrigger.super.Init(self, instance)
	self.touching = {} :: { [any]: boolean }
	self.filter = nil
	self.spawnflags = BaseTrigger.SF_TRIGGER_ALLOW_CLIENTS
end

function BaseTrigger:IsTrigger(): boolean
	return true
end

function BaseTrigger:Spawn()
	BaseTrigger.super.Spawn(self)
	self:HideBrush()
	BaseTrigger.ActiveTriggers[self] = true
	TouchSystem.Register(self, 0)
end

function BaseTrigger:Activate()
	BaseTrigger.super.Activate(self)
	local filterName = self:GetKeyString("filtername")
	if filterName ~= "" then
		self.filter = EntityList.FindEntityByName(filterName, self)
	end
end

function BaseTrigger:OnRemove()
	BaseTrigger.ActiveTriggers[self] = nil
	TouchSystem.Unregister(self)
	for ent in table.clone(self.touching) do
		self:EndTouch(ent)
	end
end

-- PassesTriggerFilters
function BaseTrigger:PassesTriggerFilters(other: any): boolean
	if other:IsPlayer() then
		if not self:HasSpawnFlags(BaseTrigger.SF_TRIGGER_ALLOW_CLIENTS + BaseTrigger.SF_TRIGGER_ALLOW_ALL) then
			return false
		end
	elseif not self:HasSpawnFlags(BaseTrigger.SF_TRIGGER_ALLOW_ALL) then
		return false
	end
	local filter = self.filter
	if filter and not filter.removed and filter.PassesFilter then
		return filter:PassesFilter(self, other)
	end
	return true
end

-- overlap test against our parts (studs)
function BaseTrigger:Overlaps(center: Vector3, half: Vector3): boolean
	for _, part in self:GetParts() do
		if part.Parent and MathLib.BoxOverlapsPart(center, half, part) then
			return true
		end
	end
	return false
end

function BaseTrigger:IsTouching(other: any): boolean
	return self.touching[other] == true
end

function BaseTrigger:CountTouching(): number
	local n = 0
	for _ in self.touching do
		n += 1
	end
	return n
end

-- called by TouchSystem
function BaseTrigger:StartTouch(other: any)
	if not self:PassesTriggerFilters(other) then
		return
	end
	local wasEmpty = next(self.touching) == nil
	self.touching[other] = true
	self:FireOutput("OnStartTouch", other)
	if wasEmpty then
		self:FireOutput("OnStartTouchAll", other)
	end
	self:OnStartTouch(other)
end

function BaseTrigger:Touch(other: any)
	if self.touching[other] then
		self:OnTouch(other)
	end
end

function BaseTrigger:EndTouch(other: any)
	if not self.touching[other] then
		return
	end
	self.touching[other] = nil
	self:FireOutput("OnEndTouch", other)
	if next(self.touching) == nil then
		self:FireOutput("OnEndTouchAll", other)
	end
	self:OnEndTouch(other)
end

-- subclass hooks
function BaseTrigger:OnStartTouch(other: any) end
function BaseTrigger:OnTouch(other: any) end
function BaseTrigger:OnEndTouch(other: any) end

function BaseTrigger:Enable()
	self.disabled = false
end

function BaseTrigger:Disable()
	self.disabled = true
	for ent in table.clone(self.touching) do
		self:EndTouch(ent)
	end
end

BaseTrigger.Inputs.enable = function(self)
	self:Enable()
end

BaseTrigger.Inputs.disable = function(self)
	self:Disable()
end

BaseTrigger.Inputs.toggle = function(self)
	if self.disabled then
		self:Enable()
	else
		self:Disable()
	end
end

-- TouchTest: fires OnTouching / OnNotTouching
BaseTrigger.Inputs.touchtest = function(self, data)
	if next(self.touching) ~= nil then
		self:FireOutput("OnTouching", data.activator)
	else
		self:FireOutput("OnNotTouching", data.activator)
	end
end

return BaseTrigger
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000012">
						<Properties>
							<string name="Name">ConVarServer</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	ConVarServer (ModuleScript)
	- FCVAR_REPLICATED convars are mirrored to clients as Attributes on
	  ReplicatedStorage.BloxSDK.ReplicatedConVars
	- server command names are published (Commands StringValue) so the client console can
	  autocomplete and forward them
	- ServerCommand remote runs console text on the server (Studio / place owner only)
	- server console output is mirrored to clients
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BloxSDK = ReplicatedStorage:WaitForChild("BloxSDK")
local Shared = BloxSDK:WaitForChild("Shared")
local Cvar = require(Shared:WaitForChild("ConVar"))
local Net = require(Shared:WaitForChild("Net"))

local ConVarServer = {}

local folder: Configuration
local commandsValue: StringValue
local publishQueued = false

local function canRunCommands(plr: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return plr.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return plr:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank == 255
end

local function replicate(var)
	if not var.isCommand and Cvar.HasFlag(var.flags, Cvar.FCVAR_REPLICATED) then
		folder:SetAttribute(var.name, var:GetString())
	end
end

local function publishCommands()
	if publishQueued then
		return
	end
	publishQueued = true
	task.defer(function()
		publishQueued = false
		local lines = {}
		for _, base in Cvar.GetAll() do
			if base.isCommand and not Cvar.HasFlag(base.flags, Cvar.FCVAR_HIDDEN) then
				table.insert(lines, string.format("%s\t%d\t%s", base.name, base.flags, (base.help:gsub("[\t\n]", " "))))
			end
		end
		commandsValue.Value = table.concat(lines, "\n")
	end)
end

function ConVarServer.Init()
	folder = BloxSDK:FindFirstChild("ReplicatedConVars") :: Configuration
	if not folder then
		folder = Instance.new("Configuration")
		folder.Name = "ReplicatedConVars"
		folder.Parent = BloxSDK
	end

	commandsValue = folder:FindFirstChild("Commands") :: StringValue
	if not commandsValue then
		commandsValue = Instance.new("StringValue")
		commandsValue.Name = "Commands"
		commandsValue.Parent = folder
	end

	for _, base in Cvar.GetAll() do
		if not base.isCommand then
			replicate(base)
		end
	end
	publishCommands()

	Cvar.InstallGlobalChangeCallback(replicate)
	Cvar.OnRegister(function(base)
		if base.isCommand then
			publishCommands()
		else
			replicate(base)
		end
	end)

	Net.Get("ServerCommand").OnServerEvent:Connect(function(plr, text)
		if type(text) ~= "string" or #text > 2000 then
			return
		end
		if not canRunCommands(plr) then
			Net.Get("ConsolePrint"):FireClient(plr, "You don't have access to server commands.", Cvar.COLOR_WARNING)
			return
		end
		Cvar.CommandPlayer = plr
		local ok, err = pcall(Cvar.Execute, text)
		Cvar.CommandPlayer = nil
		if not ok then
			Cvar.Warning(tostring(err))
		end
	end)

	-- mirror server console output to everyone's console
	Cvar.OnPrint(function(text, color)
		Net.Get("ConsolePrint"):FireAllClients(text, color)
	end)

	-- late joiners get the recent server history
	Players.PlayerAdded:Connect(function(plr)
		task.wait(2)
		local remote = Net.Get("ConsolePrint")
		local history = Cvar.GetHistory()
		for i = math.max(1, #history - 50), #history do
			remote:FireClient(plr, history[i].text, history[i].color)
		end
	end)
end

return ConVarServer
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="Folder" referent="RBX00000013">
						<Properties>
							<string name="Name">Entities</string>
						</Properties>
						<Item class="ModuleScript" referent="RBX00000014">
							<Properties>
								<string name="Name">Doors</string>
								<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	Doors / moving brushes - ports of game/server/doors.cpp, buttons.cpp, bmodels.cpp, func_movelinear.cpp
	func_door, func_door_rotating, func_button, func_rotating, func_movelinear, func_brush, func_wall_toggle

	Rotating things turn around the instance's pivot: set it with Studio's pivot tool
	(Model.WorldPivot / Part.PivotOffset), the same job an origin brush does in Hammer.
	movedir / pushdir: a Vector3 attribute (world direction) or a Source "pitch yaw roll" string.
	Speeds are Source units/sec (or degrees/sec), distances in units.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MathLib = require(ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared"):WaitForChild("MathLib"))

local Game = script.Parent.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local BaseToggle = require(Game:WaitForChild("BaseToggle"))
local EntityIO = require(Game:WaitForChild("EntityIO"))
local TouchSystem = require(Game:WaitForChild("TouchSystem"))

local TS_AT_TOP = BaseToggle.TS_AT_TOP
local TS_AT_BOTTOM = BaseToggle.TS_AT_BOTTOM
local TS_GOING_UP = BaseToggle.TS_GOING_UP
local TS_GOING_DOWN = BaseToggle.TS_GOING_DOWN

local function now()
	return EntityIO.CurTime()
end

-- Source X/Y/Z rotation axis flags -> Roblox axis
local function rotationAxis(ent: any, xFlag: number, yFlag: number): Vector3
	if ent:HasSpawnFlags(xFlag) then
		return Vector3.xAxis -- Source X
	elseif ent:HasSpawnFlags(yFlag) then
		return -Vector3.zAxis -- Source Y
	end
	return Vector3.yAxis -- Source Z (default, yaw)
end

------------------------------------------------------------------------
-- func_door
------------------------------------------------------------------------

local SF_DOOR_ROTATE_BACKWARDS = 2
local SF_DOOR_ONEWAY = 16
local SF_DOOR_NO_AUTO_RETURN = 32
local SF_DOOR_ROTATE_ROLL = 64
local SF_DOOR_ROTATE_PITCH = 128
local SF_DOOR_PUSE = 256
local SF_DOOR_PTOUCH = 1024
local SF_DOOR_LOCKED = 2048
local SF_DOOR_SILENT = 4096
local SF_DOOR_IGNORE_USE = 32768

local FuncDoor = BaseEntity.extend(BaseToggle, "func_door")
FuncDoor:DeclareOutputs({
	"OnClose", "OnOpen", "OnFullyOpen", "OnFullyClosed",
	"OnBlockedClosing", "OnBlockedOpening", "OnUnblockedClosing", "OnUnblockedOpening",
	"OnLockedUse",
})

function FuncDoor:Init(instance)
	FuncDoor.super.Init(self, instance)
	self.spawnflags = SF_DOOR_PUSE
	self.locked = false
	self.blockedOutputFired = false
	self.lastBlockDamage = 0
end

function FuncDoor:Spawn()
	FuncDoor.super.Spawn(self)
	self:AnchorParts()

	self.speed = self:GetKeyFloat("speed", 100)
	self.wait = self:GetKeyFloat("wait", 4)
	self.lip = self:GetKeyFloat("lip", 0)
	self.blockDamage = self:GetKeyFloat("dmg", 0)
	self.forceClosed = self:GetKeyBool("forceclosed", false)
	self.locked = self:HasSpawnFlags(SF_DOOR_LOCKED)

	self:SetupPositions()

	-- spawnpos 1 = start open
	if self:GetKeyInt("spawnpos", 0) == 1 then
		self:SetPivot(self.position2)
		self.toggleState = TS_AT_TOP
	end

	if self:HasSpawnFlags(SF_DOOR_PTOUCH) then
		TouchSystem.Register(self, 2)
	end
end

function FuncDoor:SetupPositions()
	local dir = MathLib.Movedir(self:GetKey("movedir"))
	self.moveDir = dir
	self.position1 = self:GetPivot()
	self.position2 = self.position1 + dir * self:TravelDistanceStuds(dir, self.lip)
end

function FuncDoor:OnRemove()
	TouchSystem.Unregister(self)
end

function FuncDoor:IsUsable(): boolean
	return self:HasSpawnFlags(SF_DOOR_PUSE) and not self:HasSpawnFlags(SF_DOOR_IGNORE_USE)
end

function FuncDoor:PlayMoveSound()
	if not self:HasSpawnFlags(SF_DOOR_SILENT) then
		self:EmitSound(self:GetKey("noise1"))
	end
end

function FuncDoor:PlayStopSound()
	if not self:HasSpawnFlags(SF_DOOR_SILENT) then
		self:EmitSound(self:GetKey("noise2"))
	end
end

-- CBaseDoor::DoorActivate
function FuncDoor:DoorActivate(activator)
	if self.locked then
		self:FireOutput("OnLockedUse", activator)
		self:EmitSound(self:GetKey("locked_sound"))
		return
	end

	if self:HasSpawnFlags(SF_DOOR_NO_AUTO_RETURN) and self.toggleState == TS_AT_TOP then
		-- door should close
		self:DoorGoDown(activator)
	else
		-- door should open
		self:DoorGoUp(activator)
	end
end

function FuncDoor:DoorGoUp(activator)
	if self.toggleState == TS_GOING_UP or self.toggleState == TS_AT_TOP and not self:IsMoving() then
		if self.toggleState == TS_AT_TOP and self.wait ~= -1 and not self:HasSpawnFlags(SF_DOOR_NO_AUTO_RETURN) then
			-- re-use while open resets the auto-close timer
			self:SetThink(self.DoorGoDown, self.wait)
		end
		return
	end
	self.activator = activator
	self.toggleState = TS_GOING_UP
	self.blockedOutputFired = false
	self:SetThink(nil)
	self:PlayMoveSound()
	self:FireOutput("OnOpen", activator)
	self:MoveTo(self.position2, self.DoorHitTop, activator)
end

function FuncDoor:MoveTo(dest: CFrame, onDone, activator)
	self:LinearMove(dest, self.speed, onDone)
end

function FuncDoor:DoorHitTop()
	self.toggleState = TS_AT_TOP
	self:PlayStopSound()
	self:FireOutput("OnFullyOpen", self.activator)

	if self:HasSpawnFlags(SF_DOOR_NO_AUTO_RETURN) or self.wait == -1 then
		return
	end
	self:SetThink(self.DoorGoDown, self.wait)
end

function FuncDoor:DoorGoDown(activator)
	if self.toggleState == TS_GOING_DOWN or self.toggleState == TS_AT_BOTTOM then
		return
	end
	self.toggleState = TS_GOING_DOWN
	self.blockedOutputFired = false
	self:SetThink(nil)
	self:PlayMoveSound()
	self:FireOutput("OnClose", activator or self.activator)
	self:MoveTo(self.position1, self.DoorHitBottom, activator)
end

function FuncDoor:DoorHitBottom()
	self.toggleState = TS_AT_BOTTOM
	self:PlayStopSound()
	self:FireOutput("OnFullyClosed", self.activator)
end

function FuncDoor:Blocked(other): boolean
	local t = now()
	if self.blockDamage > 0 and t - self.lastBlockDamage >= 0.5 and other.TakeDamage then
		self.lastBlockDamage = t
		other:TakeDamage({ damage = self.blockDamage, damageType = BaseEntity.DMG_CRUSH, attacker = self, inflictor = self })
	end

	if not self.blockedOutputFired then
		self.blockedOutputFired = true
		if self.toggleState == TS_GOING_DOWN then
			self:FireOutput("OnBlockedClosing", other)
		else
			self:FireOutput("OnBlockedOpening", other)
		end
	end

	if self.forceClosed then
		return true
	end

	-- if a door has a negative wait, it would never come back if blocked, so let it just squash the object
	if self.wait >= 0 then
		if self.toggleState == TS_GOING_DOWN then
			self:DoorGoUp(other)
		else
			self:DoorGoDown(other)
		end
	end
	return false
end

function FuncDoor:Use(activator)
	if self:HasSpawnFlags(SF_DOOR_IGNORE_USE) then
		return
	end
	self:DoorActivate(activator)
end

function FuncDoor:StartTouch(other)
	if other:IsPlayer() and self.toggleState == TS_AT_BOTTOM then
		self:DoorActivate(other)
	end
end

FuncDoor.Inputs.open = function(self, data)
	if self.toggleState ~= TS_AT_TOP and self.toggleState ~= TS_GOING_UP then
		self:DoorGoUp(data.activator)
	end
end

FuncDoor.Inputs.close = function(self, data)
	if self.toggleState ~= TS_AT_BOTTOM and self.toggleState ~= TS_GOING_DOWN then
		self:DoorGoDown(data.activator)
	end
end

FuncDoor.Inputs.toggle = function(self, data)
	if self.toggleState == TS_AT_BOTTOM or self.toggleState == TS_GOING_DOWN then
		self:DoorGoUp(data.activator)
	else
		self:DoorGoDown(data.activator)
	end
end

FuncDoor.Inputs.lock = function(self)
	self.locked = true
end

FuncDoor.Inputs.unlock = function(self)
	self.locked = false
	self:EmitSound(self:GetKey("unlocked_sound"))
end

FuncDoor.Inputs.setspeed = function(self, data)
	self.speed = data.value:Float()
	if self.move then
		-- restart the current leg at the new speed
		local dest = self.move.to
		local done = self.move.done
		self:MoveTo(dest, done)
	end
end

------------------------------------------------------------------------
-- func_door_rotating
------------------------------------------------------------------------

local FuncDoorRotating = BaseEntity.extend(FuncDoor, "func_door_rotating")

function FuncDoorRotating:SetupPositions()
	self.axis = rotationAxis(self, SF_DOOR_ROTATE_ROLL, SF_DOOR_ROTATE_PITCH)
	self.distance = self:GetKeyFloat("distance", 90)
	if self:HasSpawnFlags(SF_DOOR_ROTATE_BACKWARDS) then
		self.distance = -self.distance
	end
	self.position1 = self:GetPivot()
	self.position2 = self:RotatedBy(self.distance)
end

function FuncDoorRotating:RotatedBy(degrees: number): CFrame
	local p1 = self.position1
	local localAxis = p1:VectorToObjectSpace(self.axis)
	return p1 * CFrame.fromAxisAngle(localAxis, math.rad(degrees))
end

-- opens away from the activator unless "one way"
function FuncDoorRotating:DoorGoUp(activator)
	if self.toggleState ~= TS_GOING_UP and self.toggleState ~= TS_AT_TOP
		and not self:HasSpawnFlags(SF_DOOR_ONEWAY) and activator and activator.GetAbsOrigin then
		local ups = MathLib.UnitsPerStud()
		local hinge = self.position1.Position
		local center = self.position1:PointToWorldSpace(self.position1:PointToObjectSpace(self:WorldSpaceCenter() / ups))
		local r = center - hinge
		local toPlayer = activator:GetAbsOrigin() / ups - hinge
		local swing = self.axis:Cross(r)
		local sign = if swing:Dot(toPlayer) > 0 then -1 else 1
		local d = math.abs(self.distance) * sign * (if self.distance < 0 then -1 else 1)
		self.position2 = self:RotatedBy(d)
	end
	FuncDoor.DoorGoUp(self, activator)
end

function FuncDoorRotating:MoveTo(dest: CFrame, onDone)
	self:AngularMove(dest, self.speed, onDone)
end

------------------------------------------------------------------------
-- func_button
------------------------------------------------------------------------

local SF_BUTTON_DONTMOVE = 1
local SF_BUTTON_TOGGLE = 32
local SF_BUTTON_TOUCH_ACTIVATES = 256
local SF_BUTTON_DAMAGE_ACTIVATES = 512
local SF_BUTTON_USE_ACTIVATES = 1024
local SF_BUTTON_LOCKED = 2048

local FuncButton = BaseEntity.extend(BaseToggle, "func_button")
FuncButton:DeclareOutputs({ "OnDamaged", "OnPressed", "OnUseLocked", "OnIn", "OnOut" })

function FuncButton:Init(instance)
	FuncButton.super.Init(self, instance)
	self.spawnflags = SF_BUTTON_DONTMOVE + SF_BUTTON_USE_ACTIVATES -- Hammer default (1025)
	self.locked = false
end

function FuncButton:Spawn()
	FuncButton.super.Spawn(self)
	self:AnchorParts()

	self.speed = self:GetKeyFloat("speed", 5)
	self.wait = self:GetKeyFloat("wait", 3)
	self.lip = self:GetKeyFloat("lip", 0)
	self.locked = self:HasSpawnFlags(SF_BUTTON_LOCKED)

	local dir = MathLib.Movedir(self:GetKey("movedir"))
	self.position1 = self:GetPivot()
	if self:HasSpawnFlags(SF_BUTTON_DONTMOVE) then
		self.position2 = self.position1
	else
		self.position2 = self.position1 + dir * self:TravelDistanceStuds(dir, self.lip)
	end

	if self:HasSpawnFlags(SF_BUTTON_TOUCH_ACTIVATES) then
		TouchSystem.Register(self, 2)
	end
	if self:HasSpawnFlags(SF_BUTTON_DAMAGE_ACTIVATES) and self.maxHealth <= 0 then
		self.maxHealth = 1
		self.health = 1
	end
end

function FuncButton:OnRemove()
	TouchSystem.Unregister(self)
end

function FuncButton:IsUsable(): boolean
	return self:HasSpawnFlags(SF_BUTTON_USE_ACTIVATES)
end

function FuncButton:ButtonActivate(activator)
	self:EmitSound(self:GetKey("sound") or self:GetKey("noise"))
	self.toggleState = TS_GOING_UP
	self:SetThink(nil)
	self:LinearMove(self.position2, self.speed, self.TriggerAndWait)
end

function FuncButton:TriggerAndWait()
	self.toggleState = TS_AT_TOP
	self:FireOutput("OnIn", self.activator)

	-- If button automatically comes back out, start it moving out.
	if not self:HasSpawnFlags(SF_BUTTON_TOGGLE) and self.wait ~= -1 then
		self:SetThink(self.ButtonReturn, self.wait)
	end
end

function FuncButton:ButtonReturn()
	self.toggleState = TS_GOING_DOWN
	self:SetThink(nil)
	self:LinearMove(self.position1, self.speed, self.ButtonBackHome)
end

function FuncButton:ButtonBackHome()
	self.toggleState = TS_AT_BOTTOM
	self:FireOutput("OnOut", self.activator)
end

-- CBaseButton::ButtonUse
function FuncButton:Press(activator)
	if self.toggleState == TS_GOING_UP or self.toggleState == TS_GOING_DOWN then
		return
	end

	if self.locked then
		self:FireOutput("OnUseLocked", activator)
		self:EmitSound(self:GetKey("locked_sound"))
		return
	end

	self.activator = activator
	if self.toggleState == TS_AT_TOP then
		-- If it's a toggle button it can return now. Otherwise, it will either
		-- return on its own or will stay pressed indefinitely.
		if self:HasSpawnFlags(SF_BUTTON_TOGGLE) then
			self:EmitSound(self:GetKey("sound"))
			self:FireOutput("OnPressed", activator)
			self:ButtonReturn()
		end
	else
		self:FireOutput("OnPressed", activator)
		self:ButtonActivate(activator)
	end
end

function FuncButton:Use(activator)
	self:Press(activator)
end

function FuncButton:StartTouch(other)
	if other:IsPlayer() and self.toggleState == TS_AT_BOTTOM then
		self:Press(other)
	end
end

function FuncButton:TakeDamage(info)
	self:FireOutput("OnDamaged", info.attacker)
	if self:HasSpawnFlags(SF_BUTTON_DAMAGE_ACTIVATES) then
		self:Press(info.attacker)
	end
end

FuncButton.Inputs.lock = function(self)
	self.locked = true
end

FuncButton.Inputs.unlock = function(self)
	self.locked = false
end

FuncButton.Inputs.press = function(self, data)
	self:Press(data.activator)
end

FuncButton.Inputs.pressin = function(self, data)
	if self.toggleState == TS_AT_BOTTOM or self.toggleState == TS_GOING_DOWN then
		self.activator = data.activator
		self:FireOutput("OnPressed", data.activator)
		self:ButtonActivate(data.activator)
	end
end

FuncButton.Inputs.pressout = function(self, data)
	if self.toggleState == TS_AT_TOP or self.toggleState == TS_GOING_UP then
		self.activator = data.activator
		self:ButtonReturn()
	end
end

------------------------------------------------------------------------
-- func_rotating
------------------------------------------------------------------------

local SF_BRUSH_ROTATE_START_ON = 1
local SF_BRUSH_ROTATE_BACKWARDS = 2
local SF_BRUSH_ROTATE_X_AXIS = 4
local SF_BRUSH_ROTATE_Y_AXIS = 8
local SF_BRUSH_ACCDCC = 16
local SF_BRUSH_HURT = 32
local SF_BRUSH_ROTATE_NOT_SOLID = 64

local FuncRotating = BaseEntity.extend(BaseEntity, "func_rotating")

FuncRotating.Rotators = {} :: { [any]: boolean }

function FuncRotating:Spawn()
	FuncRotating.super.Spawn(self)
	for _, part in self:GetParts() do
		part.Anchored = true
	end

	self.maxSpeed = self:GetKeyFloat("maxspeed", 100)
	self.friction = math.max(self:GetKeyFloat("fanfriction", 20), 1) / 100
	self.axis = rotationAxis(self, SF_BRUSH_ROTATE_X_AXIS, SF_BRUSH_ROTATE_Y_AXIS)
	self.direction = if self:HasSpawnFlags(SF_BRUSH_ROTATE_BACKWARDS) then -1 else 1
	self.speed = 0
	self.targetSpeed = 0
	self.blockDamage = self:GetKeyFloat("dmg", 0)
	self.lastBlockDamage = 0

	if self:HasSpawnFlags(SF_BRUSH_ROTATE_NOT_SOLID) then
		self:SetSolid(false)
	end
	if self:HasSpawnFlags(SF_BRUSH_ROTATE_START_ON) then
		self:SetTargetSpeed(self.maxSpeed)
	end
	FuncRotating.Rotators[self] = true
end

function FuncRotating:OnRemove()
	FuncRotating.Rotators[self] = nil
end

function FuncRotating:SetTargetSpeed(speed: number)
	self.targetSpeed = math.clamp(speed, -self.maxSpeed, self.maxSpeed)
	if not self:HasSpawnFlags(SF_BRUSH_ACCDCC) then
		self.speed = self.targetSpeed
	end
end

function FuncRotating:StepRotate(dt: number)
	if self:HasSpawnFlags(SF_BRUSH_ACCDCC) then
		local accel = self.maxSpeed * self.friction * 10
		self.speed = MathLib.Approach(self.targetSpeed, self.speed, accel * dt)
	end
	if self.speed == 0 then
		return
	end
	local pivot = self:GetPivot()
	local localAxis = pivot:VectorToObjectSpace(self.axis)
	self:SetPivot(pivot * CFrame.fromAxisAngle(localAxis, math.rad(self.speed * self.direction * dt)))
end

function FuncRotating.ServiceRotators(dt: number)
	for ent in FuncRotating.Rotators do
		if ent.removed then
			FuncRotating.Rotators[ent] = nil
		else
			ent:StepRotate(dt)
		end
	end
end

FuncRotating.Inputs.setspeed = function(self, data)
	self:SetTargetSpeed(math.clamp(data.value:Float(), 0, 1) * self.maxSpeed)
end

FuncRotating.Inputs.start = function(self)
	self:SetTargetSpeed(self.maxSpeed)
end

FuncRotating.Inputs.stop = function(self)
	self:SetTargetSpeed(0)
end

FuncRotating.Inputs.toggle = function(self)
	if self.targetSpeed ~= 0 then
		self:SetTargetSpeed(0)
	else
		self:SetTargetSpeed(self.maxSpeed)
	end
end

FuncRotating.Inputs.reverse = function(self)
	self.direction = -self.direction
end

FuncRotating.Inputs.startforward = function(self)
	self.direction = if self:HasSpawnFlags(SF_BRUSH_ROTATE_BACKWARDS) then -1 else 1
	self:SetTargetSpeed(self.maxSpeed)
end

FuncRotating.Inputs.startbackward = function(self)
	self.direction = if self:HasSpawnFlags(SF_BRUSH_ROTATE_BACKWARDS) then 1 else -1
	self:SetTargetSpeed(self.maxSpeed)
end

------------------------------------------------------------------------
-- func_movelinear
------------------------------------------------------------------------

local FuncMoveLinear = BaseEntity.extend(BaseToggle, "func_movelinear")
FuncMoveLinear:DeclareOutputs({ "OnFullyOpen", "OnFullyClosed" })

function FuncMoveLinear:Spawn()
	FuncMoveLinear.super.Spawn(self)
	self:AnchorParts()

	local ups = MathLib.UnitsPerStud()
	self.speed = self:GetKeyFloat("speed", 100)
	local dir = MathLib.Movedir(self:GetKey("movedir"))
	local distance = self:GetKeyFloat("movedistance", 100) / ups

	self.position1 = self:GetPivot()
	self.position2 = self.position1 + dir * distance

	local start = math.clamp(self:GetKeyFloat("startposition", 0), 0, 1)
	if start > 0 then
		self:SetPivot(self.position1:Lerp(self.position2, start))
	end
end

function FuncMoveLinear:MoveToFraction(fraction: number)
	local dest = self.position1:Lerp(self.position2, math.clamp(fraction, 0, 1))
	self:LinearMove(dest, self.speed, function(ent)
		if fraction >= 1 then
			ent:FireOutput("OnFullyOpen", ent)
		elseif fraction <= 0 then
			ent:FireOutput("OnFullyClosed", ent)
		end
	end)
end

FuncMoveLinear.Inputs.open = function(self)
	self:MoveToFraction(1)
end

FuncMoveLinear.Inputs.close = function(self)
	self:MoveToFraction(0)
end

FuncMoveLinear.Inputs.setposition = function(self, data)
	self:MoveToFraction(data.value:Float())
end

FuncMoveLinear.Inputs.setspeed = function(self, data)
	self.speed = data.value:Float()
end

------------------------------------------------------------------------
-- func_brush / func_wall_toggle
------------------------------------------------------------------------

local FuncBrush = BaseEntity.extend(BaseEntity, "func_brush")

function FuncBrush:Spawn()
	FuncBrush.super.Spawn(self)
	-- Solidity: 0 = toggle with visibility, 1 = never solid, 2 = always solid
	self.solidity = self:GetKeyInt("solidity", 0)
	self:ApplyState()
end

function FuncBrush:ApplyState()
	local on = not self.disabled
	self:SetVisible(on)
	if self.solidity == 1 then
		self:SetSolid(false)
	elseif self.solidity == 2 then
		self:SetSolid(true)
	else
		self:SetSolid(on)
	end
end

FuncBrush.Inputs.enable = function(self)
	self.disabled = false
	self:ApplyState()
end

FuncBrush.Inputs.disable = function(self)
	self.disabled = true
	self:ApplyState()
end

FuncBrush.Inputs.toggle = function(self)
	self.disabled = not self.disabled
	self:ApplyState()
end

local FuncWallToggle = BaseEntity.extend(FuncBrush, "func_wall_toggle")

function FuncWallToggle:Spawn()
	-- spawnflag 1 = starts invisible
	if self:HasSpawnFlags(1) then
		self.disabled = true
	end
	FuncWallToggle.super.Spawn(self)
end

return {
	FuncRotating = FuncRotating,
}
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX00000015">
							<Properties>
								<string name="Name">Logic</string>
								<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	Logic entities - ports of game/server/logicentities.cpp, logicrelay.cpp, logic_timer,
	logic_branch.cpp, logic_compare, logic_case, math_counter (mathcounter in logicentities),
	filters.cpp, point_servercommand / point_clientcommand.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared")
local Cvar = require(Shared:WaitForChild("ConVar"))
local Net = require(Shared:WaitForChild("Net"))

local Game = script.Parent.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local EntityIO = require(Game:WaitForChild("EntityIO"))
local EntityList = require(Game:WaitForChild("EntityList"))

------------------------------------------------------------------------
-- logic_relay
------------------------------------------------------------------------

local SF_REMOVE_ON_FIRE = 1
local SF_ALLOW_FAST_RETRIGGER = 2

local LogicRelay = BaseEntity.extend("logic_relay")
LogicRelay:DeclareOutputs({ "OnTrigger", "OnSpawn" })

function LogicRelay:Spawn()
	self.waitForRefire = false
	-- Fire an output when we spawn. This is used for self-initializing an entity.
	if self:GetOutput("OnSpawn"):NumberOfElements() > 0 then
		self:SetThink(function(ent)
			ent:FireOutput("OnSpawn", ent)
		end, 0.01)
	end
end

LogicRelay.Inputs.trigger = function(self, data)
	if self.disabled or self.waitForRefire then
		return
	end
	self:FireOutput("OnTrigger", data.activator)

	if self:HasSpawnFlags(SF_REMOVE_ON_FIRE) then
		self:Remove()
	elseif not self:HasSpawnFlags(SF_ALLOW_FAST_RETRIGGER) then
		-- Disable the relay so that it cannot be refired until after the last output
		-- has been fired and post an input to re-enable ourselves.
		self.waitForRefire = true
		EntityIO.AddEventToEntity(self, "EnableRefire", nil, self:GetOutput("OnTrigger"):GetMaxDelay() + 0.001, self, self)
	end
end

LogicRelay.Inputs.enablerefire = function(self)
	self.waitForRefire = false
end

LogicRelay.Inputs.enable = function(self)
	self.disabled = false
end

LogicRelay.Inputs.disable = function(self)
	self.disabled = true
end

LogicRelay.Inputs.toggle = function(self)
	self.disabled = not self.disabled
end

LogicRelay.Inputs.cancelpending = function(self)
	EntityIO.CancelEvents(self)
	-- Stop waiting; allow another Trigger.
	self.waitForRefire = false
end

------------------------------------------------------------------------
-- logic_auto
------------------------------------------------------------------------

local LogicAuto = BaseEntity.extend("logic_auto")
LogicAuto:DeclareOutputs({
	"OnMapSpawn", "OnNewGame", "OnLoadGame", "OnMapTransition",
	"OnBackgroundMap", "OnMultiNewMap", "OnMultiNewRound",
})

function LogicAuto:Spawn()
	self:SetThink(function(ent)
		ent:FireOutput("OnMapSpawn", ent)
		ent:FireOutput("OnNewGame", ent)
		ent:FireOutput("OnMultiNewMap", ent)
		ent:FireOutput("OnMultiNewRound", ent)
		if ent:HasSpawnFlags(1) then
			ent:Remove()
		end
	end, 0.2)
end

------------------------------------------------------------------------
-- logic_timer
------------------------------------------------------------------------

local SF_TIMER_UPDOWN = 1
local LOGIC_TIMER_MIN_INTERVAL = 0.01

local LogicTimer = BaseEntity.extend("logic_timer")
LogicTimer:DeclareOutputs({ "OnTimer", "OnTimerHigh", "OnTimerLow" })

function LogicTimer:Spawn()
	self.refireTime = self:GetKeyFloat("refiretime", 0)
	self.useRandom = self:GetKeyBool("userandomtime", false)
	self.lowerBound = self:GetKeyFloat("lowerrandombound", 0)
	self.upperBound = self:GetKeyFloat("upperrandombound", 0)
	self.upDownState = false

	if not self.useRandom and self.refireTime < LOGIC_TIMER_MIN_INTERVAL then
		self.refireTime = LOGIC_TIMER_MIN_INTERVAL
	end

	if not self.disabled then
		self:Schedule()
	end
end

function LogicTimer:GetInterval(): number
	if self.useRandom then
		local lo, hi = math.min(self.lowerBound, self.upperBound), math.max(self.lowerBound, self.upperBound)
		return math.max(lo + math.random() * (hi - lo), LOGIC_TIMER_MIN_INTERVAL)
	end
	return self.refireTime
end

function LogicTimer:Schedule()
	self:SetThink(self.TimerThink, self:GetInterval())
end

function LogicTimer:FireTimer(activator)
	if self:HasSpawnFlags(SF_TIMER_UPDOWN) then
		if self.upDownState then
			self:FireOutput("OnTimerHigh", activator or self)
		else
			self:FireOutput("OnTimerLow", activator or self)
		end
		self.upDownState = not self.upDownState
	else
		self:FireOutput("OnTimer", activator or self)
	end
end

function LogicTimer:TimerThink()
	self:FireTimer(self)
	if not self.disabled and not self.removed then
		self:Schedule()
	end
end

LogicTimer.Inputs.refiretime = function(self, data)
	self.refireTime = math.max(data.value:Float(), LOGIC_TIMER_MIN_INTERVAL)
	if not self.disabled then
		self:Schedule()
	end
end

LogicTimer.Inputs.firetimer = function(self, data)
	self:FireTimer(data.activator)
	if not self.disabled then
		self:Schedule()
	end
end

LogicTimer.Inputs.enable = function(self)
	if self.disabled then
		self.disabled = false
		self:Schedule()
	end
end

LogicTimer.Inputs.disable = function(self)
	self.disabled = true
	self:SetThink(nil)
end

LogicTimer.Inputs.toggle = function(self)
	if self.disabled then
		LogicTimer.Inputs.enable(self)
	else
		LogicTimer.Inputs.disable(self)
	end
end

LogicTimer.Inputs.lowerrandombound = function(self, data)
	self.lowerBound = data.value:Float()
end

LogicTimer.Inputs.upperrandombound = function(self, data)
	self.upperBound = data.value:Float()
end

LogicTimer.Inputs.resettimer = function(self)
	if not self.disabled then
		self:Schedule()
	end
end

LogicTimer.Inputs.addtotimer = function(self, data)
	if not self.disabled and self.nextThink then
		self.nextThink += data.value:Float()
	end
end

LogicTimer.Inputs.subtractfromtimer = function(self, data)
	if not self.disabled and self.nextThink then
		self.nextThink = math.max(self.nextThink - data.value:Float(), EntityIO.CurTime())
	end
end

------------------------------------------------------------------------
-- logic_branch
------------------------------------------------------------------------

local LogicBranch = BaseEntity.extend("logic_branch")
LogicBranch:DeclareOutputs({ "OnTrue", "OnFalse" })

function LogicBranch:Spawn()
	self.inValue = self:GetKeyBool("initialvalue", false)
end

function LogicBranch:UpdateValue(value: boolean, activator, test: boolean)
	self.inValue = value
	if test then
		self:Test(activator)
	end
end

function LogicBranch:Test(activator)
	if self.inValue then
		self:FireOutput("OnTrue", activator)
	else
		self:FireOutput("OnFalse", activator)
	end
end

LogicBranch.Inputs.setvalue = function(self, data)
	self:UpdateValue(data.value:Bool(), data.activator, false)
end

LogicBranch.Inputs.setvaluetest = function(self, data)
	self:UpdateValue(data.value:Bool(), data.activator, true)
end

LogicBranch.Inputs.toggle = function(self, data)
	self:UpdateValue(not self.inValue, data.activator, false)
end

LogicBranch.Inputs.toggletest = function(self, data)
	self:UpdateValue(not self.inValue, data.activator, true)
end

LogicBranch.Inputs.test = function(self, data)
	self:Test(data.activator)
end

------------------------------------------------------------------------
-- logic_compare
------------------------------------------------------------------------

local LogicCompare = BaseEntity.extend("logic_compare")
LogicCompare:DeclareOutputs({ "OnLessThan", "OnEqualTo", "OnNotEqualTo", "OnGreaterThan" })

function LogicCompare:Spawn()
	self.inValue = self:GetKeyFloat("initialvalue", 0)
	self.compareValue = self:GetKeyFloat("comparevalue", 0)
end

function LogicCompare:DoCompare(activator)
	local value = self.inValue
	if value == self.compareValue then
		self:FireOutput("OnEqualTo", activator, value)
	else
		self:FireOutput("OnNotEqualTo", activator, value)
		if value > self.compareValue then
			self:FireOutput("OnGreaterThan", activator, value)
		else
			self:FireOutput("OnLessThan", activator, value)
		end
	end
end

LogicCompare.Inputs.setvalue = function(self, data)
	self.inValue = data.value:Float()
end

LogicCompare.Inputs.setvaluecompare = function(self, data)
	self.inValue = data.value:Float()
	self:DoCompare(data.activator)
end

LogicCompare.Inputs.setcomparevalue = function(self, data)
	self.compareValue = data.value:Float()
end

LogicCompare.Inputs.compare = function(self, data)
	self:DoCompare(data.activator)
end

------------------------------------------------------------------------
-- logic_case
------------------------------------------------------------------------

local MAX_LOGIC_CASES = 16

local LogicCase = BaseEntity.extend("logic_case")
do
	local outputs = { "OnDefault" }
	for i = 1, MAX_LOGIC_CASES do
		table.insert(outputs, string.format("OnCase%02d", i))
	end
	LogicCase:DeclareOutputs(outputs)
end

function LogicCase:Spawn()
	self.cases = {}
	for i = 1, MAX_LOGIC_CASES do
		local v = self:GetKey(string.format("case%02d", i))
		self.cases[i] = if v ~= nil then tostring(v) else nil
	end
	self.shuffleBag = {}
end

function LogicCase:FireCase(i: number, activator)
	self:FireOutput(string.format("OnCase%02d", i), activator)
end

LogicCase.Inputs.invalue = function(self, data)
	local text = data.value:String()
	local num = tonumber(text)
	for i = 1, MAX_LOGIC_CASES do
		local case = self.cases[i]
		if case ~= nil then
			local caseNum = tonumber(case)
			if string.lower(case) == string.lower(text) or (num and caseNum and num == caseNum) then
				self:FireCase(i, data.activator)
				return
			end
		end
	end
	self:FireOutput("OnDefault", data.activator, data.value)
end

local function usedCases(self): { number }
	local list = {}
	for i = 1, MAX_LOGIC_CASES do
		if self:GetOutput(string.format("OnCase%02d", i)):NumberOfElements() > 0 then
			table.insert(list, i)
		end
	end
	return list
end

LogicCase.Inputs.pickrandom = function(self, data)
	local list = usedCases(self)
	if #list > 0 then
		self:FireCase(list[math.random(1, #list)], data.activator)
	end
end

LogicCase.Inputs.pickrandomshuffle = function(self, data)
	if #self.shuffleBag == 0 then
		self.shuffleBag = usedCases(self)
		for i = #self.shuffleBag, 2, -1 do
			local j = math.random(1, i)
			self.shuffleBag[i], self.shuffleBag[j] = self.shuffleBag[j], self.shuffleBag[i]
		end
	end
	local pick = table.remove(self.shuffleBag)
	if pick then
		self:FireCase(pick, data.activator)
	end
end

------------------------------------------------------------------------
-- math_counter
------------------------------------------------------------------------

local MathCounter = BaseEntity.extend("math_counter")
MathCounter:DeclareOutputs({ "OutValue", "OnHitMin", "OnHitMax", "OnGetValue", "OnChangedFromMin", "OnChangedFromMax" })

function MathCounter:Spawn()
	self.min = self:GetKeyFloat("min", 0)
	self.max = self:GetKeyFloat("max", 0)
	if self.min > self.max and self.max ~= 0 then
		self.min, self.max = self.max, self.min
	end
	self.value = math.clamp(self:GetKeyFloat("startvalue", 0), math.min(self.min, self.max), math.max(self.min, self.max))
	if self.min == 0 and self.max == 0 then
		self.value = self:GetKeyFloat("startvalue", 0)
	end
	self.hitMin = false
	self.hitMax = false
end

function MathCounter:HasBounds(): boolean
	return self.min ~= 0 or self.max ~= 0
end

function MathCounter:UpdateOutValue(activator, newValue: number, fire: boolean)
	local old = self.value

	if self:HasBounds() then
		if newValue >= self.max then
			newValue = self.max
			if not self.hitMax then
				self.hitMax = true
				if fire then
					self:FireOutput("OnHitMax", activator)
				end
			end
		else
			self.hitMax = false
		end

		if newValue <= self.min then
			newValue = self.min
			if not self.hitMin then
				self.hitMin = true
				if fire then
					self:FireOutput("OnHitMin", activator)
				end
			end
		else
			self.hitMin = false
		end

		if fire and old == self.max and newValue ~= self.max then
			self:FireOutput("OnChangedFromMax", activator)
		end
		if fire and old == self.min and newValue ~= self.min then
			self:FireOutput("OnChangedFromMin", activator)
		end
	end

	self.value = newValue
	if fire then
		self:FireOutput("OutValue", activator, newValue)
	end
end

local function counterInput(fn: (number, number) -> number?)
	return function(self, data)
		if self.disabled then
			Cvar.DevMsg(1, string.format("Math Counter %s ignoring input because it is disabled", self.targetname))
			return
		end
		local result = fn(self.value, data.value:Float())
		if result then
			self:UpdateOutValue(data.activator, result, true)
		end
	end
end

MathCounter.Inputs.add = counterInput(function(a, b) return a + b end)
MathCounter.Inputs.subtract = counterInput(function(a, b) return a - b end)
MathCounter.Inputs.multiply = counterInput(function(a, b) return a * b end)
MathCounter.Inputs.divide = counterInput(function(a, b)
	if b == 0 then
		Cvar.Warning("math_counter: attempt to divide by zero")
		return nil
	end
	return a / b
end)
MathCounter.Inputs.setvalue = counterInput(function(_, b) return b end)

MathCounter.Inputs.setvaluenofire = function(self, data)
	if not self.disabled then
		self:UpdateOutValue(data.activator, data.value:Float(), false)
	end
end

MathCounter.Inputs.getvalue = function(self, data)
	self:FireOutput("OnGetValue", data.activator, self.value)
end

MathCounter.Inputs.sethitmax = function(self, data)
	self.max = data.value:Float()
	self:UpdateOutValue(data.activator, self.value, true)
end

MathCounter.Inputs.sethitmin = function(self, data)
	self.min = data.value:Float()
	self:UpdateOutValue(data.activator, self.value, true)
end

MathCounter.Inputs.setmaxvaluenofire = function(self, data)
	self.max = data.value:Float()
	self:UpdateOutValue(data.activator, self.value, false)
end

MathCounter.Inputs.setminvaluenofire = function(self, data)
	self.min = data.value:Float()
	self:UpdateOutValue(data.activator, self.value, false)
end

MathCounter.Inputs.enable = function(self)
	self.disabled = false
end

MathCounter.Inputs.disable = function(self)
	self.disabled = true
end

------------------------------------------------------------------------
-- Filters (filters.cpp)
------------------------------------------------------------------------

local BaseFilter = BaseEntity.extend(BaseEntity)
BaseFilter:DeclareOutputs({ "OnPass", "OnFail" })

function BaseFilter:Spawn()
	self.negated = self:GetKeyBool("negated", false)
end

function BaseFilter:PassesFilterImpl(caller, entity): boolean
	return true
end

function BaseFilter:PassesFilter(caller, entity): boolean
	if not entity then
		return false
	end
	local pass = self:PassesFilterImpl(caller, entity)
	if self.negated then
		return not pass
	end
	return pass
end

BaseFilter.Inputs.testactivator = function(self, data)
	if self:PassesFilter(data.caller, data.activator) then
		self:FireOutput("OnPass", data.activator)
	else
		self:FireOutput("OnFail", data.activator)
	end
end

local FilterName = BaseEntity.extend(BaseFilter, "filter_activator_name")

function FilterName:PassesFilterImpl(caller, entity): boolean
	local pattern = self:GetKeyString("filtername")
	if EntityList.NameMatches(pattern, entity.targetname) then
		return true
	end
	-- players have no targetname in Source; let mappers match the Roblox name
	if entity.player then
		return EntityList.NameMatches(pattern, entity.player.Name)
	end
	return false
end

local FilterClass = BaseEntity.extend(BaseFilter, "filter_activator_class")

function FilterClass:PassesFilterImpl(caller, entity): boolean
	return EntityList.NameMatches(self:GetKeyString("filterclass"), entity.classname)
end

local FilterTeam = BaseEntity.extend(BaseFilter, "filter_activator_team")

function FilterTeam:PassesFilterImpl(caller, entity): boolean
	local plr = entity.player
	if not plr or not plr.Team then
		return false
	end
	local want = self:GetKeyString("filterteam")
	return plr.Team.Name == want or tostring(plr.TeamColor.Number) == want
end

local FilterMulti = BaseEntity.extend(BaseFilter, "filter_multi")

function FilterMulti:Activate()
	FilterMulti.super.Activate(self)
	self.filters = {}
	for i = 1, 5 do
		local name = self:GetKeyString(string.format("filter%02d", i))
		if name ~= "" then
			local f = EntityList.FindEntityByName(name, self)
			if f and f.PassesFilter then
				table.insert(self.filters, f)
			end
		end
	end
end

function FilterMulti:PassesFilterImpl(caller, entity): boolean
	local filters = self.filters or {}
	-- filtertype 0 = AND, 1 = OR
	if self:GetKeyInt("filtertype", 0) == 0 then
		for _, f in filters do
			if not f:PassesFilter(caller, entity) then
				return false
			end
		end
		return true
	end
	for _, f in filters do
		if f:PassesFilter(caller, entity) then
			return true
		end
	end
	return #filters == 0
end

------------------------------------------------------------------------
-- point_servercommand / point_clientcommand
------------------------------------------------------------------------

local PointServerCommand = BaseEntity.extend("point_servercommand")

PointServerCommand.Inputs.command = function(self, data)
	local text = data.value:String()
	if text ~= "" then
		Cvar.Execute(text)
	end
end

local PointClientCommand = BaseEntity.extend("point_clientcommand")

PointClientCommand.Inputs.command = function(self, data)
	local activator = data.activator
	local text = data.value:String()
	if activator and activator.player and text ~= "" then
		Net.Get("EntityMessage"):FireClient(activator.player, "command", { text = text })
	end
end

return {}
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX00000016">
							<Properties>
								<string name="Name">Points</string>
								<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	Point entities - info_target, info_teleport_destination, info_landmark, info_player_start
	(+ HL2DM/CS/TF spawn variants), point_teleport, game_text, ambient_generic
	Point entities are hidden at spawn; their part's pivot is the origin/angles.
]]

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared")
local MathLib = require(Shared:WaitForChild("MathLib"))
local Net = require(Shared:WaitForChild("Net"))

local Game = script.Parent.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local EntityList = require(Game:WaitForChild("EntityList"))
local PlayerManager = require(Game:WaitForChild("PlayerManager"))

------------------------------------------------------------------------
-- markers
------------------------------------------------------------------------

local PointMarker = BaseEntity.extend(BaseEntity)

for _, classname in {
	"info_target",
	"info_teleport_destination",
	"info_landmark",
	"info_null",
	"info_player_start",
	"info_player_deathmatch",
	"info_player_combine",
	"info_player_rebel",
	"info_player_terrorist",
	"info_player_counterterrorist",
	"info_player_teamspawn",
} do
	local class = BaseEntity.extend(PointMarker, classname)
	class.Inputs.enable = function(self)
		self.disabled = false
	end
	class.Inputs.disable = function(self)
		self.disabled = true
	end
end

-- HL2DM / CS / TF spawns all count as player starts
do
	local original = EntityList.FindAllByClassname
	EntityList.FindAllSpawnPoints = function(): { any }
		local list = {}
		for _, cls in { "info_player_start", "info_player_deathmatch", "info_player_combine", "info_player_rebel", "info_player_terrorist", "info_player_counterterrorist", "info_player_teamspawn" } do
			for _, ent in original(cls) do
				table.insert(list, ent)
			end
		end
		return list
	end
end

------------------------------------------------------------------------
-- point_teleport
------------------------------------------------------------------------

local PointTeleport = BaseEntity.extend("point_teleport")

PointTeleport.Inputs.teleport = function(self, data)
	local targets = EntityList.FindAllGeneric(self:GetKeyString("target"), self, data.activator, data.caller)
	local pivot = self:GetPivot()
	for _, target in targets do
		if target.Teleport then
			target:Teleport(pivot.Position * MathLib.UnitsPerStud(), self:GetYaw(), nil)
		else
			target:SetPivot(pivot)
		end
	end
end

------------------------------------------------------------------------
-- game_text
------------------------------------------------------------------------

local SF_ENVTEXT_ALLPLAYERS = 1

local GameText = BaseEntity.extend("game_text")

local function parseColor(value: any, default: Color3): Color3
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "string" then
		local r, g, b = value:match("(%d+)%s+(%d+)%s+(%d+)")
		if r then
			return Color3.fromRGB(tonumber(r) :: number, tonumber(g) :: number, tonumber(b) :: number)
		end
	end
	return default
end

function GameText:BuildMessage()
	return {
		message = self:GetKeyString("message"):gsub("\\n", "\n"),
		x = self:GetKeyFloat("x", -1),
		y = self:GetKeyFloat("y", -1),
		effect = self:GetKeyInt("effect", 0),
		color = parseColor(self:GetKey("color"), Color3.fromRGB(100, 100, 100)),
		color2 = parseColor(self:GetKey("color2"), Color3.fromRGB(240, 110, 0)),
		fadein = self:GetKeyFloat("fadein", 1.5),
		fadeout = self:GetKeyFloat("fadeout", 0.5),
		holdtime = self:GetKeyFloat("holdtime", 1.2),
		fxtime = self:GetKeyFloat("fxtime", 0.25),
		channel = self:GetKeyInt("channel", 1),
	}
end

function GameText:Display(activator)
	local msg = self:BuildMessage()
	local remote = Net.Get("EntityMessage")
	if self:HasSpawnFlags(SF_ENVTEXT_ALLPLAYERS) then
		remote:FireAllClients("gametext", msg)
	elseif activator and activator.player then
		remote:FireClient(activator.player, "gametext", msg)
	end
end

GameText.Inputs.display = function(self, data)
	self:Display(data.activator)
end

GameText.Inputs.settext = function(self, data)
	self.keyvalues.message = data.value:String()
end

function GameText:Use(activator)
	self:Display(activator)
end

------------------------------------------------------------------------
-- ambient_generic
------------------------------------------------------------------------

local SF_AMBIENT_SOUND_EVERYWHERE = 1
local SF_AMBIENT_SOUND_START_SILENT = 16
local SF_AMBIENT_SOUND_NOT_LOOPING = 32

local AmbientGeneric = BaseEntity.extend("ambient_generic")

function AmbientGeneric:Spawn()
	local id = BaseEntity.ResolveSoundId(self:GetKey("message"))
	if not id then
		return
	end

	local sound = Instance.new("Sound")
	sound.Name = "ambient_generic"
	sound.SoundId = id
	sound.Looped = not self:HasSpawnFlags(SF_AMBIENT_SOUND_NOT_LOOPING)
	sound.Volume = math.clamp(self:GetKeyFloat("health", 10), 0, 10) / 10
	sound.PlaybackSpeed = math.clamp(self:GetKeyFloat("pitch", 100), 1, 255) / 100
	sound.RollOffMaxDistance = self:GetKeyFloat("radius", 1250) / MathLib.UnitsPerStud()
	sound.RollOffMinDistance = math.min(10, sound.RollOffMaxDistance)

	local parent: Instance = SoundService
	if not self:HasSpawnFlags(SF_AMBIENT_SOUND_EVERYWHERE) then
		-- SourceEntityName: play from another entity
		local sourceName = self:GetKeyString("sourceentityname")
		local source = if sourceName ~= "" then EntityList.FindEntityByName(sourceName, self) else nil
		parent = (source and source:GetParts()[1]) or self:GetParts()[1] or SoundService
	end
	sound.Parent = parent
	self.sound = sound
	self.baseVolume = sound.Volume

	if not self:HasSpawnFlags(SF_AMBIENT_SOUND_START_SILENT) and sound.Looped then
		sound:Play()
	end
end

function AmbientGeneric:OnRemove()
	if self.sound then
		self.sound:Destroy()
	end
end

AmbientGeneric.Inputs.playsound = function(self)
	if self.sound then
		self.sound.Volume = self.baseVolume
		self.sound:Play()
	end
end

AmbientGeneric.Inputs.stopsound = function(self)
	if self.sound then
		self.sound:Stop()
	end
end

AmbientGeneric.Inputs.togglesound = function(self)
	if self.sound then
		if self.sound.IsPlaying then
			self.sound:Stop()
		else
			self.sound:Play()
		end
	end
end

AmbientGeneric.Inputs.volume = function(self, data)
	if self.sound then
		self.sound.Volume = math.clamp(data.value:Float(), 0, 10) / 10
	end
end

AmbientGeneric.Inputs.pitch = function(self, data)
	if self.sound then
		self.sound.PlaybackSpeed = math.clamp(data.value:Float(), 1, 255) / 100
	end
end

AmbientGeneric.Inputs.fadein = function(self, data)
	if self.sound then
		self.sound.Volume = 0
		self.sound:Play()
		TweenService:Create(self.sound, TweenInfo.new(math.max(data.value:Float(), 0)), { Volume = self.baseVolume }):Play()
	end
end

AmbientGeneric.Inputs.fadeout = function(self, data)
	if self.sound then
		local tween = TweenService:Create(self.sound, TweenInfo.new(math.max(data.value:Float(), 0)), { Volume = 0 })
		tween.Completed:Connect(function()
			if self.sound then
				self.sound:Stop()
			end
		end)
		tween:Play()
	end
end

------------------------------------------------------------------------
-- spawn point selection uses every spawn variant
------------------------------------------------------------------------

PlayerManager.SpawnPointProvider = EntityList.FindAllSpawnPoints

return {}
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX00000017">
							<Properties>
								<string name="Name">Triggers</string>
								<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	Triggers - port of game/server/triggers.cpp
	trigger_multiple, trigger_once, trigger_teleport, trigger_push, trigger_hurt
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MathLib = require(ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared"):WaitForChild("MathLib"))

local Game = script.Parent.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local BaseTrigger = require(Game:WaitForChild("BaseTrigger"))
local EntityList = require(Game:WaitForChild("EntityList"))
local EntityIO = require(Game:WaitForChild("EntityIO"))

------------------------------------------------------------------------
-- trigger_multiple
------------------------------------------------------------------------

local TriggerMultiple = BaseEntity.extend(BaseTrigger, "trigger_multiple")
TriggerMultiple:DeclareOutputs({ "OnTrigger" })

function TriggerMultiple:Init(instance)
	TriggerMultiple.super.Init(self, instance)
	self.wait = 0
	self.waitUntil = 0
end

function TriggerMultiple:Spawn()
	TriggerMultiple.super.Spawn(self)
	self.wait = self:GetKeyFloat("wait", 0)
	if self.wait == 0 then
		self.wait = 0.2
	end
end

-- CTriggerMultiple::MultiTouch -> ActivateMultiTrigger
function TriggerMultiple:OnTouch(other)
	self:ActivateMultiTrigger(other)
end

function TriggerMultiple:ActivateMultiTrigger(activator)
	local now = EntityIO.CurTime()
	if now < self.waitUntil or self.removed then
		return
	end

	self:FireOutput("OnTrigger", activator)

	if self.wait > 0 then
		self.waitUntil = now + self.wait
	else
		-- we can't just remove (self) here, because this is a touch function
		-- called while C code is looping through area links...
		self.waitUntil = math.huge
		self:SetThink(function(ent)
			ent:Remove()
		end, 0.1)
	end
end

-- TriggerMultiple fires for a single activator via input, used by trigger_once too
TriggerMultiple.Inputs.trigger = function(self, data)
	self:ActivateMultiTrigger(data.activator)
end

------------------------------------------------------------------------
-- trigger_once
------------------------------------------------------------------------

local TriggerOnce = BaseEntity.extend(TriggerMultiple, "trigger_once")

function TriggerOnce:Spawn()
	TriggerOnce.super.Spawn(self)
	self.wait = -1
end

------------------------------------------------------------------------
-- trigger_teleport
------------------------------------------------------------------------

local SF_TELEPORT_PRESERVE_ANGLES = 32

local TriggerTeleport = BaseEntity.extend(BaseTrigger, "trigger_teleport")

function TriggerTeleport:OnTouch(other)
	if not self:PassesTriggerFilters(other) then
		return
	end

	local target = EntityList.FindEntityByName(self:GetKeyString("target"), self, other, self)
	if not target then
		return
	end

	local landmarkName = self:GetKeyString("landmark")
	local landmark = if landmarkName ~= "" then EntityList.FindEntityByName(landmarkName, self, other, self) else nil

	local dest = target:GetAbsOrigin()
	local yaw = nil

	if landmark then
		-- relative teleport
		dest += other:GetAbsOrigin() - landmark:GetAbsOrigin()
	elseif not self:HasSpawnFlags(SF_TELEPORT_PRESERVE_ANGLES) then
		yaw = target:GetYaw()
	end

	if other.Teleport then
		-- HL2 keeps velocity (Source's "BUGBUG - This does not set the player velocity")
		other:Teleport(dest, yaw, nil)
	else
		other:SetPivot(CFrame.new(dest / MathLib.UnitsPerStud()))
	end

	-- the teleport is now "in flight" to the client; stop touching until it reports back
	self:EndTouch(other)
end

------------------------------------------------------------------------
-- trigger_push
------------------------------------------------------------------------

local SF_TRIG_PUSH_ONCE = 128

local TriggerPush = BaseEntity.extend(BaseTrigger, "trigger_push")

function TriggerPush:Spawn()
	TriggerPush.super.Spawn(self)
	self.pushSpeed = self:GetKeyFloat("speed", 40)
	self.pushDir = MathLib.Movedir(self:GetKey("pushdir"))
end

function TriggerPush:GetPush(): Vector3
	return self.pushDir * self.pushSpeed
end

function TriggerPush:OnStartTouch(other)
	if self:HasSpawnFlags(SF_TRIG_PUSH_ONCE) then
		if other.ApplyAbsVelocityImpulse then
			other:ApplyAbsVelocityImpulse(self:GetPush())
		end
		self:SetThink(function(ent)
			ent:Remove()
		end, 0)
		return
	end
	if other.SetPush then
		other:SetPush(self, self:GetPush())
	end
end

function TriggerPush:OnEndTouch(other)
	if other.SetPush then
		other:SetPush(self, nil)
	end
end

TriggerPush.Inputs.setspeed = function(self, data)
	self.pushSpeed = data.value:Float()
	for other in self.touching do
		if other.SetPush then
			other:SetPush(self, self:GetPush())
		end
	end
end

------------------------------------------------------------------------
-- trigger_hurt
------------------------------------------------------------------------

local TriggerHurt = BaseEntity.extend(BaseTrigger, "trigger_hurt")
TriggerHurt:DeclareOutputs({ "OnHurt", "OnHurtPlayer" })

function TriggerHurt:Spawn()
	TriggerHurt.super.Spawn(self)
	self.damage = self:GetKeyFloat("damage", 10)
	self.damageCap = self:GetKeyFloat("damagecap", 20)
	self.damageType = self:GetKeyInt("damagetype", 0)
	self.damageModel = self:GetKeyInt("damagemodel", 0)
	self.lastDmgTime = 0
	self.originalDamage = self.damage
end

function TriggerHurt:OnStartTouch(other)
	if not self.thinkFn then
		self.lastDmgTime = EntityIO.CurTime()
		self:SetThink(self.HurtThink, 0)
	end
end

function TriggerHurt:HurtAllTouchers(dt: number): number
	local hurt = 0
	local amount = self.damage * dt

	-- damagemodel 1: "doubling" - damage doubles each time it's applied, up to damagecap
	if self.damageModel == 1 then
		amount = math.min(self.damage, self.damageCap)
	end

	if amount <= 0 then
		return 0
	end

	for other in table.clone(self.touching) do
		if other.TakeDamage then
			other:TakeDamage({ damage = amount, damageType = self.damageType, attacker = self, inflictor = self })
			hurt += 1
			self:FireOutput("OnHurt", other)
			if other:IsPlayer() then
				self:FireOutput("OnHurtPlayer", other)
			end
		end
	end

	if self.damageModel == 1 then
		self.damage = math.min(self.damage * 2, self.damageCap)
	end
	return hurt
end

function TriggerHurt:HurtThink()
	local now = EntityIO.CurTime()
	local dt = now - self.lastDmgTime
	self.lastDmgTime = now

	self:HurtAllTouchers(dt)
	if next(self.touching) == nil then
		self.thinkFn = nil
		self.damage = self.originalDamage
		return
	end
	self:SetThink(self.HurtThink, 0.5)
end

TriggerHurt.Inputs.setdamage = function(self, data)
	self.damage = data.value:Float()
	self.originalDamage = self.damage
end

return {}
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>
					<Item class="ModuleScript" referent="RBX00000018">
						<Properties>
							<string name="Name">EntityCommands</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	EntityCommands (ModuleScript) - Source's entity debugging console commands
	ent_fire, ent_remove, ent_remove_all, ent_dump, ent_info, report_entities, ent_list_factories, ent_spawn_all
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cvar = require(ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared"):WaitForChild("ConVar"))

local Game = script.Parent
local EntityIO = require(Game:WaitForChild("EntityIO"))
local EntityList = require(Game:WaitForChild("EntityList"))
local PlayerManager = require(Game:WaitForChild("PlayerManager"))
local Variant = require(Game:WaitForChild("Variant"))

local EntityCommands = {}

local CHEAT = Cvar.FCVAR_CHEAT
local GAMEDLL = Cvar.FCVAR_GAMEDLL

local function commandActivator(): any?
	return PlayerManager.ForPlayer(Cvar.CommandPlayer)
end

local function describe(ent): string
	return string.format("%s(%s) #%d", ent.classname, ent.targetname ~= "" and ent.targetname or "unnamed", ent.entindex or 0)
end

function EntityCommands.Init()
	Cvar.ConCommand("ent_fire", function(args)
		if args:ArgC() < 2 then
			Cvar.Msg("Usage:\n   ent_fire <target> [action] [value] [delay]")
			return
		end
		local target = args:Arg(1)
		local action = if args:ArgC() >= 3 then args:Arg(2) else "Use"
		local value = args:Arg(3)
		local delay = tonumber(args:Arg(4)) or 0
		local activator = commandActivator()

		-- resolve !picker etc. now, against the commanding player
		local targets = EntityList.FindAllGeneric(target, activator, activator, activator)
		if #targets == 0 then
			Cvar.Msg(string.format("ent_fire: no entity matching '%s'", target))
			return
		end
		for _, ent in targets do
			EntityIO.AddEventToEntity(ent, action, Variant.new(value), delay, activator, activator)
		end
	end, "Usage:\n   ent_fire <target> [action] [value] [delay]\n   Fires an input on matching entities (name, classname, !picker, !player).", CHEAT + GAMEDLL)

	Cvar.ConCommand("ent_remove", function(args)
		local name = if args:ArgC() >= 2 then args:Arg(1) else "!picker"
		local activator = commandActivator()
		local ent = EntityList.FindEntityGeneric(name, activator, activator, activator)
		if not ent then
			Cvar.Msg("ent_remove: nothing found")
			return
		end
		Cvar.Msg("Removed " .. describe(ent))
		ent:Remove()
	end, "Removes the given entity (or the one under the crosshair)", CHEAT + GAMEDLL)

	Cvar.ConCommand("ent_remove_all", function(args)
		if args:ArgC() < 2 then
			Cvar.Msg("Removes all entities of the specified type\n\tArguments:   \t{entity_name} / {class_name}")
			return
		end
		local list = EntityList.FindAllGeneric(args:Arg(1))
		local n = 0
		for _, ent in list do
			if not ent:IsPlayer() then
				ent:Remove()
				n += 1
			end
		end
		Cvar.Msg(string.format("Removed %d %s's", n, args:Arg(1)))
	end, "Removes all entities of the specified type", CHEAT + GAMEDLL)

	Cvar.ConCommand("ent_dump", function(args)
		if args:ArgC() < 2 then
			Cvar.Msg("Usage:\n   ent_dump <entity name>")
			return
		end
		local activator = commandActivator()
		for _, ent in EntityList.FindAllGeneric(args:Arg(1), activator, activator, activator) do
			Cvar.Msg(describe(ent))
			local keys = {}
			for k in ent.keyvalues do
				table.insert(keys, k)
			end
			table.sort(keys)
			for _, k in keys do
				Cvar.Msg(string.format("  %s: %s", k, tostring(ent.keyvalues[k])))
			end
			for _, out in ent.outputs do
				for _, a in out.actions do
					Cvar.Msg(string.format("  %s -> %s,%s,%s,%g,%d", out.name, a.target, a.input, a.parameter, a.delay, a.timesToFire))
				end
			end
		end
	end, "Usage:\n   ent_dump <entity name>\n", CHEAT + GAMEDLL)

	Cvar.ConCommand("ent_info", function(args)
		if args:ArgC() < 2 then
			Cvar.Msg("Usage:\n   ent_info <class name>")
			return
		end
		local class = EntityList.GetFactory(args:Arg(1))
		if not class then
			Cvar.Msg("no such class " .. args:Arg(1))
			return
		end
		Cvar.Msg("Outputs:")
		for _, name in class.OutputNames do
			Cvar.Msg("  " .. name)
		end
		Cvar.Msg("Inputs:")
		local inputs = {}
		local t = class.Inputs
		while t do
			for k in t do
				if not table.find(inputs, k) then
					table.insert(inputs, k)
				end
			end
			local mt = getmetatable(t)
			t = mt and mt.__index
		end
		table.sort(inputs)
		for _, k in inputs do
			Cvar.Msg("  " .. k)
		end
	end, "Usage:\n   ent_info <class name>\n", GAMEDLL)

	Cvar.ConCommand("report_entities", function()
		local counts = {}
		for _, ent in EntityList.All() do
			counts[ent.classname] = (counts[ent.classname] or 0) + 1
		end
		local names = {}
		for name in counts do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in names do
			Cvar.Msg(string.format("Class: %s (%d)", name, counts[name]))
		end
		Cvar.Msg(string.format("Total %d entities, %d events queued", EntityList.Count(), EntityIO.QueueSize()))
	end, "Lists all entities", GAMEDLL)

	Cvar.ConCommand("ent_list_factories", function()
		for _, name in EntityList.GetFactoryNames() do
			Cvar.Msg(name)
		end
	end, "Lists all entity factory names.", GAMEDLL)
end

return EntityCommands
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000019">
						<Properties>
							<string name="Name">EntityIO</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	EntityIO (ModuleScript) - port of COutputEvent / CEventAction / CEventQueue (g_EventQueue)
	from game/server/cbase.cpp + entityoutput.h

	Connection string (same as a VMF output): "target,input,parameter,delay,timesToFire"
	Source's ESC (\27) separator is also accepted. timesToFire -1 = infinite.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cvar = require(ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared"):WaitForChild("ConVar"))
local EntityList = require(script.Parent:WaitForChild("EntityList"))
local Variant = require(script.Parent:WaitForChild("Variant"))

local EntityIO = {}

local function curtime(): number
	return workspace.DistributedGameTime
end
EntityIO.CurTime = curtime

------------------------------------------------------------------------
-- CEventAction
------------------------------------------------------------------------

export type EventAction = {
	target: string,
	input: string,
	parameter: string,
	delay: number,
	timesToFire: number,
	id: number,
}

local nextActionId = 1

function EntityIO.ParseAction(text: string): EventAction?
	local sep = if text:find("\27", 1, true) then "\27" else ","
	local fields = {}
	for field in (text .. sep):gmatch("(.-)" .. sep) do
		table.insert(fields, (field:gsub("^%s+", ""):gsub("%s+$", "")))
	end
	if not fields[1] or fields[1] == "" then
		return nil
	end

	local action = {
		target = fields[1],
		input = fields[2] or "",
		parameter = fields[3] or "",
		delay = tonumber(fields[4]) or 0,
		timesToFire = tonumber(fields[5]) or -1,
		id = nextActionId,
	}
	nextActionId += 1
	if action.timesToFire == 0 then
		action.timesToFire = -1
	end
	return action
end

------------------------------------------------------------------------
-- COutputEvent
------------------------------------------------------------------------

local OutputEvent = {}
OutputEvent.__index = OutputEvent

function EntityIO.NewOutput(name: string)
	return setmetatable({ name = name, actions = {} :: { EventAction }, value = Variant.Void() }, OutputEvent)
end

function OutputEvent:AddAction(action: EventAction)
	table.insert(self.actions, action)
end

function OutputEvent:ParseAndAdd(text: string): boolean
	local action = EntityIO.ParseAction(text)
	if action then
		self:AddAction(action)
		return true
	end
	return false
end

function OutputEvent:NumberOfElements(): number
	return #self.actions
end

function OutputEvent:GetMaxDelay(): number
	local m = 0
	for _, a in self.actions do
		m = math.max(m, a.delay)
	end
	return m
end

function OutputEvent:DeleteAllElements()
	table.clear(self.actions)
end

-- value: Variant|any (used when an action has no parameter override)
function OutputEvent:FireOutput(value: any?, activator: any?, caller: any?, extraDelay: number?)
	local variant = if type(value) == "table" and getmetatable(value) == Variant then value else Variant.new(value)
	local delayBase = extraDelay or 0

	local i = 1
	while i <= #self.actions do
		local action = self.actions[i]

		local param = if action.parameter ~= "" then Variant.new(action.parameter) else variant

		Cvar.DevMsg(2, string.format(
			"(%0.2f) output: (%s,%s) -> (%s,%s,%0.1f)(%s)",
			curtime(),
			caller and caller.classname or "?",
			caller and caller.targetname or "",
			action.target,
			action.input,
			action.delay,
			param:String()
		))

		EntityIO.AddEvent(action.target, action.input, param, delayBase + action.delay, activator, caller, action.id)

		if action.timesToFire > 0 then
			action.timesToFire -= 1
			if action.timesToFire == 0 then
				table.remove(self.actions, i)
				continue
			end
		end
		i += 1
	end
end

------------------------------------------------------------------------
-- CEventQueue
------------------------------------------------------------------------

type QueuedEvent = {
	fireTime: number,
	target: string?,
	targetEntity: any?,
	input: string,
	value: any,
	activator: any?,
	caller: any?,
	outputId: number,
}

local queue: { QueuedEvent } = {}

local function insertSorted(ev: QueuedEvent)
	-- keep queue ordered by fire time (stable for equal times)
	local i = #queue
	while i >= 1 and queue[i].fireTime > ev.fireTime do
		i -= 1
	end
	table.insert(queue, i + 1, ev)
end

-- by name (resolved when fired, like Source)
function EntityIO.AddEvent(target: string, input: string, value: any, delay: number, activator: any?, caller: any?, outputId: number?)
	insertSorted({
		fireTime = curtime() + math.max(delay, 0),
		target = target,
		input = input,
		value = value,
		activator = activator,
		caller = caller,
		outputId = outputId or 0,
	})
end

-- directly to an entity
function EntityIO.AddEventToEntity(ent: any, input: string, value: any, delay: number, activator: any?, caller: any?)
	insertSorted({
		fireTime = curtime() + math.max(delay, 0),
		targetEntity = ent,
		input = input,
		value = value,
		activator = activator,
		caller = caller,
		outputId = 0,
	})
end

-- CancelEvents( caller ): removes everything this entity queued
function EntityIO.CancelEvents(caller: any)
	local i = 1
	while i <= #queue do
		if queue[i].caller == caller then
			table.remove(queue, i)
		else
			i += 1
		end
	end
end

-- CancelEventOn( target, input )
function EntityIO.CancelEventOn(target: any, input: string)
	local lower = string.lower(input)
	local i = 1
	while i <= #queue do
		local ev = queue[i]
		if ev.targetEntity == target and string.lower(ev.input) == lower then
			table.remove(queue, i)
		else
			i += 1
		end
	end
end

function EntityIO.HasEventPending(target: any, input: string?): boolean
	for _, ev in queue do
		if ev.targetEntity == target and (input == nil or string.lower(ev.input) == string.lower(input)) then
			return true
		end
	end
	return false
end

function EntityIO.QueueSize(): number
	return #queue
end

function EntityIO.Clear()
	table.clear(queue)
end

function EntityIO.ServiceEvents()
	local now = curtime()

	while #queue > 0 and queue[1].fireTime <= now do
		local ev = table.remove(queue, 1) :: QueuedEvent
		local value = if type(ev.value) == "table" and getmetatable(ev.value) == Variant then ev.value else Variant.new(ev.value)

		local targets
		if ev.targetEntity then
			targets = if ev.targetEntity.removed then {} else { ev.targetEntity }
		else
			targets = EntityList.FindAllGeneric(ev.target :: string, ev.caller, ev.activator, ev.caller)
		end

		if #targets == 0 then
			Cvar.DevMsg(2, string.format("Unhandled input: (%s) -> (%s), from (%s,%s); target entity not found",
				ev.input,
				ev.target or "?",
				ev.caller and ev.caller.classname or "?",
				ev.caller and ev.caller.targetname or ""
			))
		end

		for _, ent in targets do
			Cvar.DevMsg(2, string.format("(%0.2f) input %s: %s.%s(%s)",
				now,
				ev.caller and ev.caller.targetname or "",
				ent.targetname ~= "" and ent.targetname or ent.classname,
				ev.input,
				value:String()
			))
			ent:AcceptInput(ev.input, ev.activator, ev.caller, value, ev.outputId)
		end
	end
end

return EntityIO
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001A">
						<Properties>
							<string name="Name">EntityList</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	EntityList (ModuleScript) - port of CGlobalEntityList (gEntList) + the entity factory
	(LINK_ENTITY_TO_CLASS / CreateEntityByName).

	Names support Source's special targets and wildcards:
	  !self !activator !caller !player !picker   and   "door_*" (trailing wildcard)
]]

local EntityList = {}

local entities: { any } = {}
local byInstance: { [Instance]: any } = {}
local factories: { [string]: any } = {}
local nextIndex = 1

-- set by PlayerManager: (activatorEntity) -> entity under that player's crosshair
EntityList.PickerResolver = nil :: ((any) -> any)?

------------------------------------------------------------------------
-- Factory
------------------------------------------------------------------------

function EntityList.LinkEntityToClass(classname: string, class: any)
	factories[string.lower(classname)] = class
	class.ClassName = string.lower(classname)
end

function EntityList.GetFactory(classname: string): any
	return factories[string.lower(classname)]
end

function EntityList.GetFactoryNames(): { string }
	local names = {}
	for name in factories do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

-- CreateEntityByName: allocates, does not spawn
function EntityList.CreateEntityByName(classname: string, instance: Instance?): any?
	local class = factories[string.lower(classname)]
	if not class then
		return nil
	end
	local ent = class.new(instance)
	ent.classname = string.lower(classname)
	return ent
end

------------------------------------------------------------------------
-- Registry
------------------------------------------------------------------------

function EntityList.Add(ent: any)
	ent.entindex = nextIndex
	nextIndex += 1
	table.insert(entities, ent)
	if ent.instance then
		byInstance[ent.instance] = ent
	end
end

function EntityList.Remove(ent: any)
	local i = table.find(entities, ent)
	if i then
		table.remove(entities, i)
	end
	if ent.instance then
		byInstance[ent.instance] = nil
	end
end

function EntityList.All(): { any }
	return entities
end

function EntityList.Count(): number
	return #entities
end

function EntityList.ByIndex(index: number): any?
	for _, ent in entities do
		if ent.entindex == index then
			return ent
		end
	end
	return nil
end

-- walks up from a part to the entity that owns it
function EntityList.FromInstance(inst: Instance?): any?
	while inst and inst ~= workspace and inst ~= game do
		local ent = byInstance[inst]
		if ent then
			return ent
		end
		inst = inst.Parent
	end
	return nil
end

------------------------------------------------------------------------
-- Searching
------------------------------------------------------------------------

local function nameMatches(pattern: string, name: string?): boolean
	if not name or name == "" then
		return false
	end
	local p, n = string.lower(pattern), string.lower(name)
	if p:sub(-1) == "*" then
		return n:sub(1, #p - 1) == p:sub(1, -2)
	end
	return p == n
end
EntityList.NameMatches = nameMatches

local function resolveSpecial(name: string, searchingEntity: any?, activator: any?, caller: any?): (boolean, { any })
	local lower = string.lower(name)
	if lower:sub(1, 1) ~= "!" then
		return false, {}
	end

	if lower == "!self" then
		return true, { searchingEntity }
	elseif lower == "!activator" then
		return true, { activator }
	elseif lower == "!caller" then
		return true, { caller }
	elseif lower == "!player" or lower == "!pvsplayer" then
		for _, ent in entities do
			if ent.classname == "player" and not ent.removed then
				return true, { ent }
			end
		end
		return true, {}
	elseif lower == "!picker" then
		local resolver = EntityList.PickerResolver
		if resolver and activator then
			return true, { resolver(activator) }
		end
		return true, {}
	end
	return true, {}
end

-- every entity with this targetname (handles !special and wildcards)
function EntityList.FindAllByName(name: string, searchingEntity: any?, activator: any?, caller: any?): { any }
	local special, list = resolveSpecial(name, searchingEntity, activator, caller)
	if special then
		local out = {}
		for _, ent in list do
			if ent and not ent.removed then
				table.insert(out, ent)
			end
		end
		return out
	end

	local out = {}
	for _, ent in entities do
		if not ent.removed and nameMatches(name, ent.targetname) then
			table.insert(out, ent)
		end
	end
	return out
end

function EntityList.FindAllByClassname(classname: string): { any }
	local out = {}
	for _, ent in entities do
		if not ent.removed and nameMatches(classname, ent.classname) then
			table.insert(out, ent)
		end
	end
	return out
end

-- FindEntityGeneric: targetname first, then classname
function EntityList.FindAllGeneric(name: string, searchingEntity: any?, activator: any?, caller: any?): { any }
	local list = EntityList.FindAllByName(name, searchingEntity, activator, caller)
	if #list == 0 then
		list = EntityList.FindAllByClassname(name)
	end
	return list
end

function EntityList.FindEntityByName(name: string, searchingEntity: any?, activator: any?, caller: any?): any?
	return EntityList.FindAllByName(name, searchingEntity, activator, caller)[1]
end

function EntityList.FindEntityByClassname(classname: string): any?
	return EntityList.FindAllByClassname(classname)[1]
end

function EntityList.FindEntityGeneric(name: string, searchingEntity: any?, activator: any?, caller: any?): any?
	return EntityList.FindAllGeneric(name, searchingEntity, activator, caller)[1]
end

return EntityList
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001B">
						<Properties>
							<string name="Name">PlayerManager</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	PlayerManager (ModuleScript)
	Wraps each Player as a "player" entity (CBasePlayer-lite) so they can be activators,
	touch triggers, be teleported/pushed/hurt, and +use things.

	Movement is client-side (GameMovement), so the client reports its hull every tick
	(PlayerState) and the server sends back movement effects (MovementEffect).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local MathLib = require(Shared:WaitForChild("MathLib"))
local GameMovement = require(Shared:WaitForChild("GameMovement"))

local Game = script.Parent
local BaseEntity = require(Game:WaitForChild("BaseEntity"))
local EntityList = require(Game:WaitForChild("EntityList"))

local PlayerManager = {}

local PLAYER_USE_RADIUS = 96 -- units
local MAX_EYE_ERROR_STUDS = 12

local byPlayer: { [Player]: any } = {}

------------------------------------------------------------------------
-- player entity
------------------------------------------------------------------------

local PlayerEntity = BaseEntity.extend("player")
PlayerManager.PlayerEntity = PlayerEntity

function PlayerEntity:Init(instance)
	PlayerEntity.super.Init(self, instance)
	self.destroyInstance = false
	self.player = nil :: Player?
	self.state = {
		origin = Vector3.zero,
		velocity = Vector3.zero,
		ducked = false,
		onGround = false,
		pitch = 0,
		yaw = 0,
	}
	self.hasState = false
	self.teleportSeq = 0
	self.pushes = {}
end

function PlayerEntity:IsPlayer(): boolean
	return true
end

function PlayerEntity:GetHumanoid(): Humanoid?
	local char = self.player and self.player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function PlayerEntity:IsAlive(): boolean
	local hum = self:GetHumanoid()
	return hum ~= nil and hum.Health > 0 and self.hasState
end

function PlayerEntity:GetAbsOrigin(): Vector3
	return self.state.origin
end

function PlayerEntity:GetPivot(): CFrame
	local ups = MathLib.UnitsPerStud()
	return CFrame.new(self.state.origin / ups) * CFrame.Angles(0, math.rad(self.state.yaw), 0)
end

function PlayerEntity:SetPivot(cf: CFrame)
	local _, ry = cf:ToOrientation()
	self:Teleport(cf.Position * MathLib.UnitsPerStud(), math.deg(ry), nil)
end

function PlayerEntity:WorldSpaceCenter(): Vector3
	local h = if self.state.ducked then GameMovement.VEC_DUCK_HULL_MAX.Y else GameMovement.VEC_HULL_MAX.Y
	return self.state.origin + Vector3.new(0, h / 2, 0)
end

function PlayerEntity:EyePosition(): Vector3
	local view = if self.state.ducked then GameMovement.VEC_DUCK_VIEW else GameMovement.VEC_VIEW
	return self.state.origin + Vector3.new(0, view, 0)
end

-- hull as an axis-aligned box in studs (centre, half size)
function PlayerEntity:GetHullBox(marginUnits: number?): (Vector3, Vector3)
	local ups = MathLib.UnitsPerStud()
	local maxs = if self.state.ducked then GameMovement.VEC_DUCK_HULL_MAX else GameMovement.VEC_HULL_MAX
	local mins = GameMovement.VEC_HULL_MIN
	local m = marginUnits or 0
	local center = (self.state.origin + (mins + maxs) * 0.5) / ups
	local half = ((maxs - mins) * 0.5 + Vector3.new(m, m, m)) / ups
	return center, half
end

-- Teleport( origin, yaw, velocity ). nil leaves that part alone, like CBaseEntity::Teleport
function PlayerEntity:Teleport(origin: Vector3?, yaw: number?, velocity: Vector3?)
	if not self.player then
		return
	end
	self.teleportSeq += 1
	if origin then
		self.state.origin = origin
	end
	if velocity then
		self.state.velocity = velocity
	end
	Net.Get("MovementEffect"):FireClient(self.player, "teleport", {
		seq = self.teleportSeq,
		origin = origin,
		yaw = yaw,
		velocity = velocity,
	})
end

-- trigger_push style base velocity; nil velocity clears that source
function PlayerEntity:SetPush(source: any, velocity: Vector3?)
	if not self.player then
		return
	end
	local key = source.entindex
	if self.pushes[key] == velocity then
		return
	end
	self.pushes[key] = velocity
	Net.Get("MovementEffect"):FireClient(self.player, "push", { id = key, velocity = velocity })
end

function PlayerEntity:ClearPushes()
	table.clear(self.pushes)
	if self.player then
		Net.Get("MovementEffect"):FireClient(self.player, "clearpush", {})
	end
end

function PlayerEntity:ApplyAbsVelocityImpulse(velocity: Vector3)
	if self.player then
		Net.Get("MovementEffect"):FireClient(self.player, "impulse", { velocity = velocity })
	end
end

function PlayerEntity:TakeDamage(info)
	local hum = self:GetHumanoid()
	if hum and hum.Health > 0 and info.damage > 0 then
		hum:TakeDamage(info.damage)
	end
end

function PlayerEntity:Remove()
	-- players are never removed by I/O
end

PlayerEntity.Inputs.kill = function(self)
	local hum = self:GetHumanoid()
	if hum then
		hum.Health = 0
	end
end

PlayerEntity.Inputs.sethealth = function(self, data)
	local hum = self:GetHumanoid()
	if hum then
		hum.Health = math.clamp(data.value:Float(), 0, hum.MaxHealth)
	end
end

PlayerEntity.Inputs.setmaxhealth = function(self, data)
	local hum = self:GetHumanoid()
	if hum then
		hum.MaxHealth = math.max(data.value:Float(), 1)
	end
end

------------------------------------------------------------------------
-- traces
------------------------------------------------------------------------

local function charactersFilter(): { Instance }
	local list = {}
	for _, plr in Players:GetPlayers() do
		if plr.Character then
			table.insert(list, plr.Character)
		end
	end
	return list
end

-- first entity hit along a ray (skips non-entity non-collidable parts)
local function traceEntity(fromStuds: Vector3, dirStuds: Vector3, wantUsable: boolean): (any?, RaycastResult?)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = false
	local filter = charactersFilter()
	params.FilterDescendantsInstances = filter

	local origin = fromStuds
	local remaining = dirStuds
	for _ = 1, 8 do
		local result = Workspace:Raycast(origin, remaining, params)
		if not result then
			return nil, nil
		end
		local ent = EntityList.FromInstance(result.Instance)
		local part = result.Instance :: BasePart
		if ent and (not wantUsable or ent:IsUsable()) then
			return ent, result
		end
		if part.CanCollide and not ent then
			-- hit the world
			return nil, result
		end
		table.insert(filter, result.Instance)
		params.FilterDescendantsInstances = filter
	end
	return nil, nil
end

local function viewDirection(state): Vector3
	return CFrame.fromOrientation(math.rad(state.pitch), math.rad(state.yaw), 0).LookVector
end

function PlayerManager.FindUseEntity(playerEnt: any, eyeStuds: Vector3?, dir: Vector3?): any?
	local ups = MathLib.UnitsPerStud()
	local eye = eyeStuds or playerEnt:EyePosition() / ups
	local look = dir or viewDirection(playerEnt.state)
	return (traceEntity(eye, look.Unit * (PLAYER_USE_RADIUS / ups), true))
end

-- !picker: whatever is under the crosshair
EntityList.PickerResolver = function(activator: any): any?
	if not activator or not activator.IsPlayer or not activator:IsPlayer() then
		return nil
	end
	local ups = MathLib.UnitsPerStud()
	local eye = activator:EyePosition() / ups
	return (traceEntity(eye, viewDirection(activator.state) * 1024, false))
end

------------------------------------------------------------------------
-- spawning
------------------------------------------------------------------------

-- set by Points.luau to include info_player_deathmatch etc.
PlayerManager.SpawnPointProvider = nil :: (() -> { any })?

local function pickSpawnPoint(): any?
	local provider = PlayerManager.SpawnPointProvider
	local starts = if provider then provider() else EntityList.FindAllByClassname("info_player_start")
	if #starts == 0 then
		return nil
	end
	-- prefer the master spawn (spawnflag 1)
	for _, ent in starts do
		if ent:HasSpawnFlags(1) and not ent.disabled then
			return ent
		end
	end
	local enabled = {}
	for _, ent in starts do
		if not ent.disabled then
			table.insert(enabled, ent)
		end
	end
	if #enabled == 0 then
		return nil
	end
	return enabled[math.random(1, #enabled)]
end

local function onCharacterAdded(playerEnt: any, char: Model)
	playerEnt.hasState = false
	table.clear(playerEnt.pushes)

	local spawn = pickSpawnPoint()
	if spawn then
		local pivot = spawn:GetPivot()
		local _, ry = pivot:ToOrientation()
		task.defer(function()
			if char.Parent then
				char:PivotTo(CFrame.new(pivot.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, ry, 0))
			end
		end)
		task.delay(0.3, function()
			if char.Parent and playerEnt.player and playerEnt.player.Character == char then
				playerEnt:Teleport(spawn:GetAbsOrigin() + Vector3.new(0, 1, 0), math.deg(ry), Vector3.zero)
			end
		end)
	end

	local root = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if root and not playerEnt.hasState then
		playerEnt.state.origin = (root.Position - Vector3.new(0, 3, 0)) * MathLib.UnitsPerStud()
	end
end

local function addPlayer(plr: Player)
	local ent = PlayerEntity.new(nil)
	ent.classname = "player"
	ent.player = plr
	EntityList.Add(ent)
	byPlayer[plr] = ent

	plr.CharacterAdded:Connect(function(char)
		onCharacterAdded(ent, char)
	end)
	if plr.Character then
		task.spawn(onCharacterAdded, ent, plr.Character)
	end
end

local function removePlayer(plr: Player)
	local ent = byPlayer[plr]
	if ent then
		byPlayer[plr] = nil
		ent.removed = true
		EntityList.Remove(ent)
	end
end

------------------------------------------------------------------------
-- API
------------------------------------------------------------------------

function PlayerManager.ForPlayer(plr: Player?): any?
	return plr and byPlayer[plr]
end

function PlayerManager.GetPlayerEntities(): { any }
	local list = {}
	for _, ent in byPlayer do
		table.insert(list, ent)
	end
	return list
end

function PlayerManager.GetLivingPlayers(): { any }
	local list = {}
	for _, ent in byPlayer do
		if ent:IsAlive() then
			table.insert(list, ent)
		end
	end
	return list
end

function PlayerManager.Init()
	Net.Get("PlayerState").OnServerEvent:Connect(function(plr, origin, velocity, ducked, onGround, pitch, yaw, seq)
		local ent = byPlayer[plr]
		if not ent then
			return
		end
		if typeof(origin) ~= "Vector3" or typeof(velocity) ~= "Vector3" then
			return
		end
		if type(seq) ~= "number" or seq < ent.teleportSeq then
			-- stale: sent before the client applied our last teleport
			return
		end
		local state = ent.state
		state.origin = origin
		state.velocity = velocity
		state.ducked = ducked == true
		state.onGround = onGround == true
		state.pitch = if type(pitch) == "number" then pitch else 0
		state.yaw = if type(yaw) == "number" then yaw else 0
		ent.hasState = true
	end)

	Net.Get("Use").OnServerEvent:Connect(function(plr, eye, dir)
		local ent = byPlayer[plr]
		if not ent or not ent:IsAlive() then
			return
		end
		if typeof(eye) ~= "Vector3" or typeof(dir) ~= "Vector3" or dir.Magnitude < 1e-3 then
			return
		end
		local ups = MathLib.UnitsPerStud()
		local expectedEye = ent:EyePosition() / ups
		if (eye - expectedEye).Magnitude > MAX_EYE_ERROR_STUDS then
			eye = expectedEye
		end
		local target = PlayerManager.FindUseEntity(ent, eye, dir)
		if target then
			target:Use(ent, ent, 0, 0)
		end
	end)

	for _, plr in Players:GetPlayers() do
		addPlayer(plr)
	end
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(removePlayer)
end

return PlayerManager
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001C">
						<Properties>
							<string name="Name">TouchSystem</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	TouchSystem (ModuleScript)
	Source does touch via the engine's collision; here we test reported player hulls
	against registered brush entities and call StartTouch / Touch / EndTouch.

	TouchSystem.Register(ent, marginUnits)  - triggers use 0, "touch opens" doors/buttons ~2
]]

local TouchSystem = {}

local touchables: { [any]: number } = {}
local contacts: { [any]: { [any]: boolean } } = {}

function TouchSystem.Register(ent: any, marginUnits: number?)
	touchables[ent] = marginUnits or 0
	contacts[ent] = contacts[ent] or {}
end

function TouchSystem.Unregister(ent: any)
	local c = contacts[ent]
	if c then
		for other in c do
			if ent.EndTouch then
				ent:EndTouch(other)
			end
		end
	end
	touchables[ent] = nil
	contacts[ent] = nil
end

local function overlaps(ent: any, other: any, margin: number): boolean
	local center, half = other:GetHullBox(margin)
	if ent.Overlaps then
		return ent:Overlaps(center, half)
	end
	return false
end

-- players: { playerEntity } (living ones)
function TouchSystem.Service(players: { any })
	for ent, margin in touchables do
		if ent.removed then
			TouchSystem.Unregister(ent)
			continue
		end

		local c = contacts[ent]
		local active = not (ent.disabled and ent:IsTrigger())

		-- end touches for players who left / died / were removed
		for other in table.clone(c) do
			if not active or other.removed or not other:IsAlive() or not overlaps(ent, other, margin) then
				c[other] = nil
				ent:EndTouch(other)
			end
		end

		if active then
			for _, other in players do
				if not c[other] and overlaps(ent, other, margin) then
					c[other] = true
					ent:StartTouch(other)
				end
			end
			for other in table.clone(c) do
				if ent.removed then
					break
				end
				ent:Touch(other)
			end
		end
	end
end

function TouchSystem.IsTouching(ent: any, other: any): boolean
	local c = contacts[ent]
	return c ~= nil and c[other] == true
end

return TouchSystem
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001D">
						<Properties>
							<string name="Name">Variant</string>
							<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	Variant (ModuleScript) - port of variant_t (game/server/variant_t.h)
	Values passed through entity I/O. Stored typed, converts on demand like Source.
]]

local Variant = {}
Variant.__index = Variant

Variant.FIELD_VOID = "void"
Variant.FIELD_FLOAT = "float"
Variant.FIELD_INTEGER = "integer"
Variant.FIELD_BOOLEAN = "boolean"
Variant.FIELD_STRING = "string"
Variant.FIELD_VECTOR = "vector"
Variant.FIELD_COLOR32 = "color32"
Variant.FIELD_EHANDLE = "ehandle"

function Variant.new(value: any?)
	local self = setmetatable({ fieldType = Variant.FIELD_VOID, value = nil }, Variant)
	if value ~= nil then
		self:Set(value)
	end
	return self
end

function Variant.Void()
	return Variant.new()
end

function Variant:Set(value: any)
	local t = typeof(value)
	if t == "number" then
		self.fieldType = if value == math.floor(value) then Variant.FIELD_INTEGER else Variant.FIELD_FLOAT
	elseif t == "boolean" then
		self.fieldType = Variant.FIELD_BOOLEAN
	elseif t == "Vector3" then
		self.fieldType = Variant.FIELD_VECTOR
	elseif t == "Color3" then
		self.fieldType = Variant.FIELD_COLOR32
	elseif t == "table" and value.classname then
		self.fieldType = Variant.FIELD_EHANDLE
	else
		self.fieldType = Variant.FIELD_STRING
		value = tostring(value)
	end
	self.value = value
end

function Variant:FieldType(): string
	return self.fieldType
end

function Variant:IsVoid(): boolean
	return self.fieldType == Variant.FIELD_VOID
end

function Variant:String(): string
	local t, v = self.fieldType, self.value
	if t == Variant.FIELD_VOID then
		return ""
	elseif t == Variant.FIELD_STRING then
		return v
	elseif t == Variant.FIELD_INTEGER then
		return string.format("%d", v)
	elseif t == Variant.FIELD_FLOAT then
		return string.format("%g", v)
	elseif t == Variant.FIELD_BOOLEAN then
		return if v then "1" else "0"
	elseif t == Variant.FIELD_VECTOR then
		return string.format("[%g %g %g]", v.X, v.Y, v.Z)
	elseif t == Variant.FIELD_COLOR32 then
		return string.format("%d %d %d", v.R * 255, v.G * 255, v.B * 255)
	elseif t == Variant.FIELD_EHANDLE then
		return v.targetname ~= "" and v.targetname or v.classname
	end
	return tostring(v)
end

function Variant:Float(): number
	local t, v = self.fieldType, self.value
	if t == Variant.FIELD_FLOAT or t == Variant.FIELD_INTEGER then
		return v
	elseif t == Variant.FIELD_BOOLEAN then
		return if v then 1 else 0
	elseif t == Variant.FIELD_STRING then
		return tonumber(v:match("^%s*([%-%+%.%deE]+)")) or 0
	end
	return 0
end

function Variant:Int(): number
	local f = self:Float()
	return if f >= 0 then math.floor(f) else math.ceil(f)
end

function Variant:Bool(): boolean
	local t, v = self.fieldType, self.value
	if t == Variant.FIELD_BOOLEAN then
		return v
	end
	return self:Float() ~= 0
end

function Variant:Vector3(): Vector3
	local t, v = self.fieldType, self.value
	if t == Variant.FIELD_VECTOR then
		return v
	elseif t == Variant.FIELD_STRING then
		local x, y, z = v:gsub("[%[%]]", ""):match("(%S+)%s+(%S+)%s+(%S+)")
		return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
	end
	return Vector3.zero
end

function Variant:Color3(): Color3
	local t, v = self.fieldType, self.value
	if t == Variant.FIELD_COLOR32 then
		return v
	elseif t == Variant.FIELD_STRING then
		local r, g, b = v:match("(%d+)%s+(%d+)%s+(%d+)")
		return Color3.fromRGB(tonumber(r) or 255, tonumber(g) or 255, tonumber(b) or 255)
	end
	return Color3.new(1, 1, 1)
end

function Variant:Entity()
	if self.fieldType == Variant.FIELD_EHANDLE then
		return self.value
	end
	return nil
end

function Variant:Copy()
	local c = Variant.new()
	c.fieldType = self.fieldType
	c.value = self.value
	return c
end

Variant.__tostring = function(self)
	return self:String()
end

return Variant
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX0000001E">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source"><![CDATA[--!optimize 2
--[[
	BloxSDK server (Script)
	ServerScriptService.BloxSDKServer.Main

	Boots the entity system:
	  1. every instance in Workspace with a "classname" Attribute becomes an entity
	     (CreateEntityByName -> keyvalues from Attributes -> Spawn), then all Activate
	  2. each Heartbeat: g_EventQueue, thinks, movers/rotators, touch
	Entities added to Workspace later (e.g. cloned in) spawn on the fly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

-- don't run from wherever the .rbxm was dropped; it has to live in ServerScriptService
if not script:IsDescendantOf(ServerScriptService) then
	warn("[BloxSDK] Main must be inside ServerScriptService - move BloxSDKServer there")
	return
end

local Shared = ReplicatedStorage:WaitForChild("BloxSDK"):WaitForChild("Shared")
local Cvar = require(Shared:WaitForChild("ConVar"))
local Net = require(Shared:WaitForChild("Net"))
require(Shared:WaitForChild("GameMovement")) -- registers the movement convars on the server

Net.Init()

local Game = script.Parent:WaitForChild("Game")
local EntityList = require(Game:WaitForChild("EntityList"))
local EntityIO = require(Game:WaitForChild("EntityIO"))
local BaseToggle = require(Game:WaitForChild("BaseToggle"))
local TouchSystem = require(Game:WaitForChild("TouchSystem"))
local PlayerManager = require(Game:WaitForChild("PlayerManager"))
local ConVarServer = require(Game:WaitForChild("ConVarServer"))
local EntityCommands = require(Game:WaitForChild("EntityCommands"))

-- entity classes register themselves with the factory when required
local entitiesFolder = Game:WaitForChild("Entities")
local Doors = nil
for _, module in entitiesFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if not ok then
			warn("[BloxSDK] failed to load entity module " .. module.Name .. ": " .. tostring(result))
		elseif module.Name == "Doors" then
			Doors = result
		end
	end
end

-- brush volumes handled entirely on the client by GameMovement
local CLIENT_ONLY = { func_water = true, func_ladder = true }

-- point entity prefixes: their marker part is hidden at spawn
local POINT_PREFIXES = { "logic_", "math_", "filter_", "info_", "point_", "game_", "ambient_", "env_" }

local function isPointClass(classname: string): boolean
	for _, prefix in POINT_PREFIXES do
		if classname:sub(1, #prefix) == prefix then
			return true
		end
	end
	return false
end

local spawned: { [Instance]: boolean } = {}

local function readClassname(inst: Instance): string?
	local cls = inst:GetAttribute("classname")
	if type(cls) ~= "string" or cls == "" then
		return nil
	end
	return string.lower(cls)
end

-- DispatchSpawn without Activate
local function createFromInstance(inst: Instance): any?
	if spawned[inst] then
		return nil
	end
	local classname = readClassname(inst)
	if not classname or CLIENT_ONLY[classname] then
		return nil
	end
	-- a part inside a Model entity belongs to that model
	local parent = inst.Parent
	while parent and parent ~= Workspace do
		if spawned[parent] then
			return nil
		end
		parent = parent.Parent
	end

	local ent = EntityList.CreateEntityByName(classname, inst)
	if not ent then
		Cvar.Warning(string.format("Can't create entity of class \"%s\" (%s)", classname, inst:GetFullName()))
		return nil
	end

	spawned[inst] = true
	ent:ReadAttributes()
	EntityList.Add(ent)

	local ok, err = pcall(function()
		ent:Precache()
		ent:Spawn()
		if isPointClass(classname) then
			ent:HideBrush()
		end
	end)
	if not ok then
		Cvar.Warning(string.format("%s(%s) Spawn error: %s", classname, ent.targetname, tostring(err)))
	end

	inst.Destroying:Connect(function()
		spawned[inst] = nil
		if not ent.removed then
			ent.destroyInstance = false
			ent:Remove()
		end
	end)
	return ent
end

local function activate(ent: any)
	local ok, err = pcall(ent.Activate, ent)
	if not ok then
		Cvar.Warning(string.format("%s(%s) Activate error: %s", ent.classname, ent.targetname, tostring(err)))
	end
end

------------------------------------------------------------------------
-- boot
------------------------------------------------------------------------

ConVarServer.Init()
EntityCommands.Init()
PlayerManager.Init()
BaseToggle.GetLivingPlayers = PlayerManager.GetLivingPlayers

-- sort so Models spawn before their descendant parts get a chance to (createFromInstance skips them)
local candidates = {}
for _, inst in Workspace:GetDescendants() do
	if readClassname(inst) then
		table.insert(candidates, inst)
	end
end
table.sort(candidates, function(a, b)
	local da, db = 0, 0
	local p = a.Parent
	while p do
		da += 1
		p = p.Parent
	end
	p = b.Parent
	while p do
		db += 1
		p = p.Parent
	end
	return da < db
end)

local created = {}
for _, inst in candidates do
	local ent = createFromInstance(inst)
	if ent then
		table.insert(created, ent)
	end
end
for _, ent in created do
	activate(ent)
end

Cvar.Msg(string.format("BloxSDK: spawned %d entities", #created))

-- late additions (clones, streamed-in models, etc.)
Workspace.DescendantAdded:Connect(function(inst)
	task.defer(function()
		if inst.Parent and readClassname(inst) then
			local ent = createFromInstance(inst)
			if ent then
				activate(ent)
			end
		end
	end)
end)

------------------------------------------------------------------------
-- frame loop
------------------------------------------------------------------------

local TOUCH_INTERVAL = 1 / 30
local touchAccumulator = 0

RunService.Heartbeat:Connect(function(dt)
	local now = EntityIO.CurTime()

	-- g_EventQueue.ServiceEvents()
	EntityIO.ServiceEvents()

	-- thinks
	for _, ent in table.clone(EntityList.All()) do
		if not ent.removed and ent.nextThink and ent.nextThink <= now then
			local ok, err = pcall(ent.RunThink, ent, now)
			if not ok then
				Cvar.Warning(string.format("%s(%s) think error: %s", ent.classname, ent.targetname, tostring(err)))
			end
		end
	end

	-- moving brushes
	BaseToggle.ServiceMovers(dt)
	if Doors and Doors.FuncRotating then
		Doors.FuncRotating.ServiceRotators(dt)
	end

	-- touch
	touchAccumulator += dt
	if touchAccumulator >= TOUCH_INTERVAL then
		touchAccumulator = 0
		TouchSystem.Service(PlayerManager.GetLivingPlayers())
	end
end)
